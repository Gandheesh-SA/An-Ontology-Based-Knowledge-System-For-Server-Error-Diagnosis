@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix d: <https://example.org/dell-troubleshooting#> .
@prefix noria: <https://w3id.org/noria/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix s: <https://example.org/dell-troubleshooting/shapes/> .

s:Event a sh:NodeShape ; sh:targetClass d:EventDefinition ;
 sh:property [ sh:path d:eventCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
 [ sh:path d:messageText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:severity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("Critical"^^xsd:string "Warning"^^xsd:string) ],
 [ sh:path d:sourceDocumentId ; sh:minCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:sourcePage ; sh:minCount 1 ; sh:datatype xsd:positiveInteger ],
 [ sh:path d:categoryText ; sh:datatype xsd:string ],
 [ sh:path d:argumentText ; sh:datatype xsd:string ],
 [ sh:path d:explanationText ; sh:datatype xsd:string ],
 [ sh:path d:recommendedResponseText ; sh:datatype xsd:string ],
 [ sh:path d:sourceEventText ; sh:datatype xsd:string ],
 [ sh:path d:platformAlertText ; sh:datatype xsd:string ],
 [ sh:path d:vendorMetadataText ; sh:datatype xsd:string ],
 [ sh:path d:describesCondition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:ReportedCondition ; sh:nodeKind sh:IRI ],
 [ sh:path d:hasDocumentedResponse ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:RecoveryProcedure ; sh:nodeKind sh:IRI ] .

s:Condition a sh:NodeShape ; sh:targetClass d:ReportedCondition ;
 sh:property [ sh:path d:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:qualifierText ; sh:datatype xsd:string ],
 [ sh:path d:concernsComponentType ; sh:class d:ComponentType ; sh:nodeKind sh:IRI ],
 [ sh:path d:concernsTechnicalProperty ; sh:class d:TechnicalProperty ; sh:nodeKind sh:IRI ],
 [ sh:path d:hasPossibleExplanation ; sh:class d:PossibleExplanation ; sh:nodeKind sh:IRI ],
 [ sh:path d:describesAnomalyPattern ; sh:class noria:AnomalyPattern ; sh:nodeKind sh:IRI ] .

s:Explanation a sh:NodeShape ; sh:targetClass d:PossibleExplanation ;
 sh:property [ sh:path d:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:qualifierText ; sh:datatype xsd:string ] .

s:Procedure a sh:NodeShape ; sh:targetClass d:RecoveryProcedure ;
 sh:property [ sh:path d:procedureText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:containsInstruction ; sh:minCount 1 ; sh:class d:ProcedureInstruction ; sh:nodeKind sh:IRI ],
 [ sh:path d:similarEvent ; sh:class d:RecoveryProcedure ; sh:nodeKind sh:IRI ] .

s:Instruction a sh:NodeShape ; sh:targetClass d:ProcedureInstruction ;
 sh:property [ sh:path [ sh:inversePath d:containsInstruction ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class d:RecoveryProcedure ],
 [ sh:path d:instructionText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:instructionOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ],
 [ sh:path d:instructionPath ; sh:datatype xsd:string ],
 [ sh:path d:sourceStepLabel ; sh:datatype xsd:string ],
 [ sh:path d:conditionText ; sh:datatype xsd:string ],
 [ sh:path d:restrictionText ; sh:datatype xsd:string ],
 [ sh:path d:toolText ; sh:datatype xsd:string ],
 [ sh:path d:locationText ; sh:datatype xsd:string ],
 [ sh:path d:appearsBefore ; sh:class d:ProcedureInstruction ; sh:nodeKind sh:IRI ],
 [ sh:path d:requestsOperationType ; sh:class d:OperationType ; sh:nodeKind sh:IRI ],
 [ sh:path d:targetsComponentType ; sh:class d:ComponentType ; sh:nodeKind sh:IRI ],
 [ sh:path d:usesArtifactType ; sh:class d:TechnicalArtifactType ; sh:nodeKind sh:IRI ],
 [ sh:path d:requestsArtifactType ; sh:class d:TechnicalArtifactType ; sh:nodeKind sh:IRI ],
 [ sh:path d:investigatesExplanation ; sh:class d:PossibleExplanation ; sh:nodeKind sh:IRI ],
 [ sh:path d:attemptsToCorrectExplanation ; sh:class d:PossibleExplanation ; sh:nodeKind sh:IRI ] .

s:ReusableConcept a sh:NodeShape ;
 sh:property [ sh:path d:conceptId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
 [ sh:path d:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
 [ sh:path d:description ; sh:datatype xsd:string ],
 [ sh:path d:sourceDocumentId ; sh:datatype xsd:string ],
 [ sh:path d:sourcePage ; sh:datatype xsd:positiveInteger ],
 [ sh:path d:sourceQuote ; sh:datatype xsd:string ] .

s:Component a sh:NodeShape ; sh:targetClass d:ComponentType ; sh:node s:ReusableConcept ;
 sh:property [ sh:path d:hasDocumentedPartType ; sh:class d:ComponentType ; sh:nodeKind sh:IRI ] .
s:Property a sh:NodeShape ; sh:targetClass d:TechnicalProperty ; sh:node s:ReusableConcept .
s:Operation a sh:NodeShape ; sh:targetClass d:OperationType ; sh:node s:ReusableConcept .
s:Artifact a sh:NodeShape ; sh:targetClass d:TechnicalArtifactType ; sh:node s:ReusableConcept .

s:ComponentSubclasses a sh:NodeShape ;
 sh:targetClass d:HardwareComponentType, d:FirmwareComponentType,
   d:ProcessingComponentType, d:MemoryComponentType, d:CoolingComponentType,
   d:StorageComponentType, d:PowerComponentType, d:InterconnectComponentType,
   d:SecurityComponentType ;
 sh:node s:ReusableConcept .
s:ConditionSubclasses a sh:NodeShape ;
 sh:targetClass d:AvailabilityCondition, d:ThresholdCondition, d:CompatibilityCondition,
   d:IntegrityCondition, d:ErrorCondition ;
 sh:property [ sh:path d:description ; sh:minCount 1 ; sh:datatype xsd:string ] .
s:OperationSubclasses a sh:NodeShape ;
 sh:targetClass d:DiagnosticOperationType, d:CorrectiveOperationType, d:ManagementOperationType ;
 sh:node s:ReusableConcept .
s:Threshold a sh:NodeShape ; sh:targetClass d:ThresholdCondition ;
 sh:property [ sh:path d:comparisonOperator ; sh:datatype xsd:string ],
 [ sh:path d:thresholdDirection ; sh:datatype xsd:string ],
 [ sh:path d:thresholdLevel ; sh:datatype xsd:string ],
 [ sh:path d:thresholdValue ; sh:datatype xsd:decimal ],
 [ sh:path d:thresholdUnitText ; sh:datatype xsd:string ] .

s:RelationshipEvidence a sh:NodeShape ; sh:targetClass owl:Axiom ;
 sh:property [ sh:path owl:annotatedSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
 [ sh:path owl:annotatedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
 [ sh:path owl:annotatedTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
 [ sh:path d:evidenceQuote ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
 [ sh:path d:evidenceDocumentId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
 [ sh:path d:evidencePage ; sh:minCount 1 ; sh:datatype xsd:positiveInteger ],
 [ sh:path d:mappingStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
