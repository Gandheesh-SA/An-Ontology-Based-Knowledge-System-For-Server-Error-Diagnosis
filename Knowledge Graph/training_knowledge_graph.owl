  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0146/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The temperature of the component identified in the message is greater than the upper warning threshold temperature. The ambient system temperature is too high, or one or more fans may have failed.</diag:causeText>
