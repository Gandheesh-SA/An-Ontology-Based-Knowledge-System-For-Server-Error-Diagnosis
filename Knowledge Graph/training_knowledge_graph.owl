  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR375/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the physical drive used for copy-back operation is "Unmap-capable for VD configuration",
and then retry the operation. To check if the drive is unmap-capable, run the following command at
the Command Line Interface (CLI): "racadm storage get pdisks -o -p UnmapCapabilityForVDConfig".</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR375/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell STOR375 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-SSD-has-reached-the-maximum-rated-usage-limit-for-writes-wearout-and-should-be-356f67de70/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-SSD-has-reached-the-maximum-rated-usage-limit-for-writes-wearout-and-should-be-356f67de70 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smart SSD State: SSD has reached the maximum rated usage limit for writes (wearout) and should be replaced immediately.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e479210fa3b48f8a71f955c228b7d64">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV1007/procedure/01"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV1007/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV1007"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Insert only supported adapter cards into system PCIe slots and make sure they are fully inserted. Retry the operation.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3140/procedure/01/item/001">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [910, 1217); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the component is either under warranty or contract. Go to the: Customer Self Repair website. This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x3140 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
  </rdf:Description>
