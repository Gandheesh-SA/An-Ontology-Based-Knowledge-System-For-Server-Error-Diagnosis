    <rdfs:label xml:lang="en">HPE 314 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">314-A critical error occurred prior to this system boot.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0013-0x0016/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 827); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">HPE 0x0016 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the drive is part of a fault-tolerant volume 1. Verify that the Volume Status is OK. 2. Replace the drive. If the drive is not part of a fault-tolerant volume 1. Back up all data. 2. Replace the drive. 3. Reconfigure the RAID. 4. Restore data from the backup. If the issue persists, create a Hewlett Packard Enterprise Support Case. 1. Verify the component is either under warranty or contract. Go to https://support.hpe.com/hpesc/public/home, and then click Check Status under the Warranty Check heading. This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide. 2. Under Support Cases, click Access Cases, and then create a support case. HPE Support will contact you.</diag:itemText>
  </rdf:Description>
