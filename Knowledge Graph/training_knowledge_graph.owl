    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Enclosure Management Module (EMM) installed in sled that is available in slot identified in the message has failed either because 1) Power loss to the Expander Module. 2) The Expander self-test may also have identified a failure. 3) A firmware issue. 4) Multi- bit error.</diag:causeText>
    <rdfs:label xml:lang="en">Dell ENC43 possible cause 1</rdfs:label>
  </rdf:Description>
