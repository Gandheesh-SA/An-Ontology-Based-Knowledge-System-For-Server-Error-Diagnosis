    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Add a SAS disk that is large enough to be used as the hot spare and assign the new disk as a hot spare.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1295/procedure/01">
