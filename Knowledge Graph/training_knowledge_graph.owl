    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power down and remove all power from the server. Remove the system battery for 10 minutes. Reinstall the battery and power on the server. To locate the system battery and for server-specific procedures, see the product documentation.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</diag:itemOrder>
  </rdf:Description>
