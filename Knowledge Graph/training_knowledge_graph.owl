    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install the new DIMM. If this issue persists, create an HPE Support Case.</diag:itemText>
    <rdfs:label xml:lang="en">HPE 0x0573 printed item 6</rdfs:label>
  </rdf:Description>
