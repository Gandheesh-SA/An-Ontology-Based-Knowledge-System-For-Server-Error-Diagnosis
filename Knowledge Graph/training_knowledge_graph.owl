  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0448/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0448/procedure/01/item/001"/>
