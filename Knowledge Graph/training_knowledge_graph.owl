    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the problem persists, replace the NVMe controller.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb981334075ba4c51a4d42c78fd61e43d">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0689/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0689"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: To enable Lifecycle Controller, reboot the server. During server startup, press F2 to enter System Setup. Go to iDRAC Settings -&gt; Lifecycle Controller, select Enable, and save the changes. Retry the operation after the server has restarted.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0689/procedure/01"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU8528/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU8528/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU8528/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">Dell PSU8528 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do one of the following and retry the operation: 1) On the OpenManage Enterprise-Modular
Graphical User Interface (GUI) click Settings &gt; Power. Under Redundancy Configuration, select PSU
Redundancy. 2) At the Command Line Interface (CLI), enter the RACADM command: "racadm config
-g cfgChassisPower -o cfgChassisRedundancyPolicy 1".</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-The-enclosure-is-reporting-a-critical-temperature-status-condition-24d39c94a6/procedure/01/item/001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
