  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-MEM1201/message/01">
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "location", "name": "arg1"}]</diag:messageArguments>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memory RAID redundancy is lost. Check memory device at location(s) arg1.</diag:messageText>
    <rdfs:label xml:lang="en">Dell MEM1201 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD4102/procedure/01">
    <rdfs:label xml:lang="en">Dell CUPD4102 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)Verify network connectivity between the appliance and the configured update source.2.If a proxy is
configured, validate proxy settings and ensure the update source URL is reachable through it.3.Check
available disk space on the appliance and free up storage if necessary.4.Review the console-update-
manager-service logs for the specific failure reason.5.Retry the Console Update Task.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD4102/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD4102/procedure/01/item/001"/>
  </rdf:Description>
