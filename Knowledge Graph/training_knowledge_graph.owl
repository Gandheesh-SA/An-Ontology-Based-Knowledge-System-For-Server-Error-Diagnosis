    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Firmware download on arg1 has failed.</diag:messageText>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "Enclosure Name", "name": "arg1"}]</diag:messageArguments>
