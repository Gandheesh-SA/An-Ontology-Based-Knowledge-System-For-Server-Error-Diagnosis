    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0775/procedure/01"/>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">link-missing</diag:causeCategory>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltAdaptorExtEthIfMissing</diag:eventName>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">159</diag:sourcePage>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <rdfs:label xml:lang="en">Cisco F0775: fltAdaptorExtEthIfMissing</rdfs:label>
