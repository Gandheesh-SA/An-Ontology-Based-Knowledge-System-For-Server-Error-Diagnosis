  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SRV083/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell SRV083 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The operation cannot be started because iDRAC Service Module (iSM) running on the server operating system (OS) is not compatible with iDRAC firmware version installed on the server.</diag:causeText>
  </rdf:Description>
