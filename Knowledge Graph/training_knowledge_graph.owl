    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-229/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install only supported DIMMs into the server. For more information, see the memory population rules on the Hewlett Packard Enterprise website (https://www.hpe.com/docs/memory-population-rules). For additional information, see the server user guide for your product:</diag:itemText>
