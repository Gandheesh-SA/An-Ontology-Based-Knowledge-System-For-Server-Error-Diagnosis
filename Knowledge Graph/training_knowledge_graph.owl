    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some of the adapters in Server [chassisId]/[slotId] needs firmware update to operate in 40G mode.These adapters are currently configured in 4x10G mode</diag:messageText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
