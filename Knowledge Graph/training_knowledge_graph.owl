    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F1761</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs because Cisco UCS Manager detects that the number of chassis present in the system exceeds the maximum number supported on the platform.</diag:explanation>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chassis-limit-exceeded</diag:causeCategory>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
  </rdf:Description>
