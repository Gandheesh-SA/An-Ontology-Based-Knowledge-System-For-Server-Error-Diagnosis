    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review logs for fan failures, replace failed fans. If no fan failures are detected, check inlet temperature
(if available) and reinstall processor heatsink.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb965651d64a947cd8193f8c867390816">
