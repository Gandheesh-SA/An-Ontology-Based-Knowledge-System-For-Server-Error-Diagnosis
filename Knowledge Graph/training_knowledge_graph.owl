  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR50/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <rdfs:label xml:lang="en">Dell VDR50 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review other messages to identify whether the physical disk that has errors. If the virtual disk is
redundant, you can replace the physical disk and continue using the virtual disk. If the virtual disk is
non-redundant, you need to recreate the virtual disk after replacing the physical disk. After replacing
the physical disk, run a consistency check to verify the data.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR50/procedure/01/item/001"/>
  </rdf:Description>
