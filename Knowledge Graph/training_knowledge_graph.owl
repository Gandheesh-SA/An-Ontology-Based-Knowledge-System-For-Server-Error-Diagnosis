    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. Shared component alone does not justify this corrective operation for the source cause.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell SWC9015 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the System FPGA or CPLD version either by using UEFI or host Operating System, Lifecycle Controller User Interface, or iDRAC by using the latest Update Package. The host server will be unavailable until the update operation is complete.</diag:itemText>
