    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1293/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the cables to the adapter and the Hub or Switch. If no cable problems are found, the
adapter, Hub, or Switch may need replacement.</diag:procedureText>
