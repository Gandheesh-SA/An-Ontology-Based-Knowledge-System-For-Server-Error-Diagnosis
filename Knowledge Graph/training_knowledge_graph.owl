    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell STOR0203 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">See the Readme file on the installation media for operating system kernel and driver version
requirements. Update the system to meet the minimum requirements and then reinstall Storage
Services.</diag:procedureText>
  </rdf:Description>
