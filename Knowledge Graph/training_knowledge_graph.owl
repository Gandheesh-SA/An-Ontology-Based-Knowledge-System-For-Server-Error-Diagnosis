  <rdf:Description rdf:nodeID="Ncd12398a6f734ee8ae85a158a60c8391">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#addressesCause"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1500/procedure/01/cause"/>
