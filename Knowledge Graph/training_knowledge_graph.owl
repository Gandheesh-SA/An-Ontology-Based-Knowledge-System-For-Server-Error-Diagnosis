  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0276">
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs when a fabric interconnect port is in link-down state. This state impacts the traffic destined for the port.</diag:explanation>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F0276</diag:eventCode>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltPortPIoLinkDown</diag:eventName>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">33</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">32</diag:sourcePage>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0276/message/01"/>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">link-down</diag:causeCategory>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdfs:label xml:lang="en">Cisco F0276: fltPortPIoLinkDown</rdfs:label>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0276/procedure/01"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Chassis%20and%20Enclosure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
