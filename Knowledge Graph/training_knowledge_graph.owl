    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the processor is correctly installed and seated. For more information, see "Processor issues" in the HPE ProLiant Gen9 Troubleshooting Guide, Volume I on the Hewlett Packard Enterprise website.</diag:itemText>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-213/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 203); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
