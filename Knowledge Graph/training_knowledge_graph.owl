    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use iLO or an optional IML viewer to access the IML to see if any event list error messages relating to fans are listed.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
