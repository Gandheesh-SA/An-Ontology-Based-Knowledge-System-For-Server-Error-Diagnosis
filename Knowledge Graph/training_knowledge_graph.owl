    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Storage Area Network adapter failed to restart correctly due to the adapter firmware not being ready in
time. Booting from the SAN is not possible until the adapter restarts successfully.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N32310b6031fa4fa09b65b6faea47d3f2">
