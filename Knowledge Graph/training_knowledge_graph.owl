  <rdf:Description rdf:nodeID="N5f847ef1e51640b2baa05679afa9ecd6">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-MEM9020/procedure/01"/>
