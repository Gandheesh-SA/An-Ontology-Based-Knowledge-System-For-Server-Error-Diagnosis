    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The drive might fail soon.</diag:causeText>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Predictive-failure-This-physical-drive-is-predicted-to-fail-soon-d344c6eb8b possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1822/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 1822 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1822-Slot X Encryption Failure – Imported encrypted logical drives are offline. Matching Local Master Key required. System may not boot.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM045/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iDRAC cannot secure the device identified in the message because either iDRAC does not support the device type, the device firmware is incompatible, or the device does not use the encryption protocol supported by iDRAC. For example, TCG Opal 2.0 or later using SMBUS. Therefore, iDRAC cannot secure the device.</diag:causeText>
    <rdfs:label xml:lang="en">Dell SEKM045 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1185/message/01">
