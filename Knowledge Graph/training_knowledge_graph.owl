    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that the RAID controller selected for the operation is T10 Protection Information capable, and
then retry the operation.</diag:procedureText>
