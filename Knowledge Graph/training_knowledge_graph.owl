    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x2104 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adapter restart failed. Firmware not ready. Boot from SAN not possible.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2296/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Dell PWR2296 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Server could not power on at this time. Enclosure Controller is trying to switch to optimized boot
mode. Make sure all other sleds are fully booted to operating system and try again to power up.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2296/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0204/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0204/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0204/procedure/01/item/002"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following:1) If any recent hardware was added to the system, please remove it to see if that
resolves the problem.2) If the issue persists,Collect a SupportAssist collection (TSR) report using
iDRAC. Visit https://www.dell.com/support/incidents-online/contactus/dynamic to use the Virtual
Assistant to analyze the collection and recommend a resolution.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell VLT0204 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6020">
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual-Connect</diag:eventNamespace>
    <rdfs:label xml:lang="en">HPE 6020: 6020 - Profile has the same network on two Flex-10 NICs on the same physical port</rdfs:label>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6020 - Profile has the same network on two Flex-10 NICs on the same physical port</diag:eventName>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6020/procedure/01"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">601</diag:sourcePage>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This occurs whenever a profile is applied to a server with Flex-10 NICs and the same Ethernet Network is on more than one Ethernet connection that is mapped to a Flex-10 physical function on the same physical port. All physical functions after the first one with the duplicate network will be disabled, and no traffic will flow on the connection. Possible cause: A profile is applied to a server and the mapping results in duplicate Ethernet networks on the same Flex-10 physical port.</diag:explanation>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Network%20Adapter%20and%20Link"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6020/procedure/01/cause"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6020</diag:eventCode>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Virtual-Connect-6020</diag:recordId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6020/message/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2421/procedure/01/item/002">
    <rdfs:label xml:lang="en">HPE 0x2421 printed item 2</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [58, 189); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hewlett Packard Enterprise recommends updating the NVM image and option ROM on the adapter using the same firmware update bundle.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/006"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/item/005"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check fans, processor heat sink and air baffles installation.
1.  Verify that all air baffles and required blanks, such as drive blanks, processor heatsink blanks, power
supply blanks, and so on are installed.
2.  Verify that the correct processor heatsink is installed.
3.  Verify that the correct fan is installed, if the system supports both standard fans and performance
fans.
For additional information, see the system documentation.
If this issue persists create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Check.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <rdfs:label xml:lang="en">HPE 0x0013 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0013/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1611-124406c7ee/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that all required fans are installed correctly and spinning. For more information, see "Fan issues"
in the HPE ProLiant Gen9 Troubleshooting Guide, Volume I on the Hewlett Packard Enterprise website.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <rdfs:label xml:lang="en">HPE 1611 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1611-124406c7ee/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1611-124406c7ee/procedure/01/item/001"/>
  </rdf:Description>
