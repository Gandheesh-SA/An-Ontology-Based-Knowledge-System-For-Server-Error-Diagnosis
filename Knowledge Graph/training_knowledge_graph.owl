  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 1769 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data was lost while the array was expanded; therefore, the drives have been temporarily disabled. Capacity
expansion failed as:
•  Cache module or hard drive failed or was removed; expansion progress data was lost.
•  Expansion was aborted due to unrecoverable drive errors.</diag:causeText>
  </rdf:Description>
