  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0014/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x0014 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The processor heat sink is not installed as indicated in the server documentation.
•  A supported fan is not installed in the server.
•  An air baffle or blank is missing or not installed properly and causing a disruption of the airflow.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SUP0548/procedure/01/item/001">
