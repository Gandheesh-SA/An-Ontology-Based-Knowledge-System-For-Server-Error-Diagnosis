  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0242/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0242/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0242/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">HPE 0x0242 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0242/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Review the supported processor configurations in the server user guide.
2.  Install the processors in a supported configuration.
WARNING: To reduce the risk of personal injury from hot surfaces, allow the drives and the internal system
components to cool before touching them.
CAUTION: THE PINS ON THE SYSTEM BOARD ARE VERY FRAGILE AND EASILY DAMAGED. To avoid
damage to the system board, do not touch the processor or the processor socket contacts.
IMPORTANT: Both processor sockets must always be populated. If either processor socket is empty, the
server does not power up.</diag:procedureText>
  </rdf:Description>
