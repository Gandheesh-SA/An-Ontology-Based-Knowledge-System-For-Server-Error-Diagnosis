  <rdf:Description rdf:nodeID="Nadbfda98cb2e43a0ac354db566be9ddc">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000D-0x0003/procedure/01"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000D-0x0003/procedure/01/item/013"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000D-0x0003"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Run SUT from the command line (On-Demand mode) to update the Smart Array firmware. For more information, see to the HP SUT documents at http://www.hpe.com/info/sut-docs. Service Pack for ProLiant (SPP): Update the firmware by downloading the SPP from the Hewlett Packard Enterprise website (http:// www.hpe.com/servers/spp). Refer to the SPP documentation at http://www.hpe.com/info/spp/documentation for instructions on updating the firmware. Note: Downloading an SPP requires a contract with Hewlett Packard Enterprise and an HPE Passport ID. If you do not have an HPE Passport ID, go to http://www.hpe.com/info/insightonline. Note: Downloading the entire SPP can take a significant amount of time. Online Flash components This component provides updated system firmware that can be installed directly on supported operating systems. Additionally, when used in conjunction with the SUM, this Smart Component allows you to update firmware on remote servers from a central location. This remote deployment capability eliminates the need for you to be physically present at the server to perform a firmware update. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http:// www.hpe.com/info/hpsum/documentation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1708/procedure/01/item/001">
    <rdfs:label xml:lang="en">HPE 0x1708 printed item 1</rdfs:label>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 1007); ACTIONABLE_SOURCE_PREFIX; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update to the latest firmware version. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs. If this issue persists, create an HPE Support Case.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1708/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1994">
