  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001C/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">See HPE OneView (Synergy compute modules) or the Onboard Administrator (c-Class servers) for additional information. This issue might clear when the other servers complete POST.</diag:itemText>
