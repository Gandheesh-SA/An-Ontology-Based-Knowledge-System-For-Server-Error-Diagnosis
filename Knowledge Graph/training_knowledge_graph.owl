    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Security"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0074</diag:eventName>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0074/message/01"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0074/procedure/01"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system BIOS logs this message after detecting a change in Secure Boot policy settings. Such a change may result from user configuration or a system BIOS update. Changes to the following settings trigger this message: 1) Secure Boot (Enable/Disable) 2) Secure Boot Policy (Standard/ Custom) 3) Platform Key 4) Key Exchange Keys 5) Authorized Signature Database (db) 6) Forbidden Signature Database (dbx).</diag:explanation>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0074</diag:eventCode>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
  </rdf:Description>
