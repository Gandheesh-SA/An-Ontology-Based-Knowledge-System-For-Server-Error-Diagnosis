  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Failed-Array-Controller-code-lockup-Code-Restart-the-server-and-run-a-diagnostic-report-e3722c8c07/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
