  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x001C/procedure/01/item/001">
    <rdfs:label xml:lang="en">HPE 0x001C printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 157); ACTIONABLE_SOURCE_PREFIX; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the system CPLD and, if applicable, the chassis firmware to the latest version. There are multiple ways to upgrade the firmware: HPE Support website:</diag:itemText>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x001C/procedure/01/cause"/>
  </rdf:Description>
