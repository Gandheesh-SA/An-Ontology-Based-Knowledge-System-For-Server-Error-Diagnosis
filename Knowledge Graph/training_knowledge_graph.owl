    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2)</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Add the component if not present in the target system, complete the CSIOR operation, and then retry the operation.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [276, 392); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0176/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
