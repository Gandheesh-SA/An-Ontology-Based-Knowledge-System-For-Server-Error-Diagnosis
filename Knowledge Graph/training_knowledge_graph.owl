  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1720/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">HPE 1720 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1720-Slot X Drive Array – S.M.A.R.T. Hard Drives Detect imminent failure: (followed by a list of dries). Do not replace drive unless all other drives in the array are online! Back up data before replacing drives if using RAID 0.</diag:messageText>
  </rdf:Description>
