  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM049/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1) Ensure that the device supports the security protocol support viaSMBus (TCG Opal or TCG
Enterprise).2) Ensure that the Security Send/Receivecommands are supported via SMBus.3) Ensure
that the device has the latestfirmware.4) Check if iDRAC is in Local Key Management mode and the
drive wassecured by iDRAC in Secure Enterprise Key Manager mode.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell SEKM049 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM049/procedure/01/item/004"/>
