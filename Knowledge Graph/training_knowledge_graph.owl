  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31B4/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31B4/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the failing DIMMs and restore the memory configuration to a supported configuration. See the
Integrated Management Log (IML) for information regarding the original memory error. Refer also to the
HPE documentation for DIMM population guidelines and any warnings in regards to performance. It is
recommended you install supported configurations that allow optimum performance.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31B4/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 0x31B4 recommendation 1</rdfs:label>
  </rdf:Description>
