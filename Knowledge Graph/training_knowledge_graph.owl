    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0358/procedure/01/item/007"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0358/procedure/01/item/003"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:label xml:lang="en">HPE 0x0358 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the unsupported capacitor pack from the NVDIMM in Processor X, slot Y.
For information specific to your server, see the server Maintenance and Service Guide at http://
www.hpe.com/info/enterprise/docs
1.  Power down the server.
2.  Remove the power from the server:
a.  Disconnect the power cord from the power source.
b.  Disconnect the power cord from the server.
CAUTION: In systems that use external data storage, be sure that the server is the first unit to be
powered down and the last to be powered back up. Taking this precaution ensures that the system
does not erroneously mark the drives as failed when the server is powered up.
3.  Remove the capacitor pack.
4.  Replace the power to the server:
a.  Connect the power cord to the server.
b.  Connect the power cord to the power source.
5.  Power up the server.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0358/procedure/01/cause"/>
  </rdf:Description>
