  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR074/procedure/01">
    <rdfs:label xml:lang="en">Dell STOR074 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In order to perform a RAID configuration operation, change the controller mode to RAID and retry
the operation. For switching to RAID mode using the F2 System Setup utility, go to Device Settings
&gt; "RAID Controller "&gt; Controller Management &gt; Advanced Controller Management &gt; Switch to RAID
mode.</diag:procedureText>
