  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPWR0170/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "rackName", "name": "arg1"}, {"description": "rackLocation", "name": "arg2"}, {"description": "totalPsuCount", "name": "arg3"}, {"description": "healthyPsuCount", "name": "arg4"}]</diag:messageArguments>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power redundancy sensor transitioned to warning state for rack physical group arg1 at location arg2. The total PSUs available are arg3 and the healthy PSUs available are arg4.</diag:messageText>
    <rdfs:label xml:lang="en">Dell CPWR0170 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0001/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0001/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0001/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0001/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0001/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the network cable is connected and retry the operation. If the problem persists: 1) Turn off the
system and disconnect the power cord. 2) Wait for five seconds. 3) Reconnect the power cord, turn
on the system, and retry the operation.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:label xml:lang="en">Dell SWC0001 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-240/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  To locate a supported option, review the product QuickSpecs on the Hewlett Packard Enterprise
website.
2.  Replace the riser board with a supported option.
For more information, see the server maintenance and service guide on the Hewlett Packard
Enterprise website.</diag:procedureText>
