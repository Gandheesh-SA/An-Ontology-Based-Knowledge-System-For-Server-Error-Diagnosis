    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">18</diag:sourcePage>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8607/procedure/01/item/001">
