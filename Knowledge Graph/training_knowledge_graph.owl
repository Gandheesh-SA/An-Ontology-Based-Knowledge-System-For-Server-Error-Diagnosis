    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CTL88</diag:eventCode>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CTL88/procedure/01"/>
    <rdfs:label xml:lang="en">Dell CTL88: CTL88</rdfs:label>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-CTL88</diag:recordId>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CTL88/message/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware running on the controller identified in the message does not match the firmware version of its peer controller. This can cause issues in a fault tolerant setup.</diag:explanation>
