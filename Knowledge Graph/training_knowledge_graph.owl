    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <rdfs:label xml:lang="en">Cisco F1933: fltBiosUnitFD0FailedSecurityVerification</rdfs:label>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image-corrupted</diag:causeCategory>
