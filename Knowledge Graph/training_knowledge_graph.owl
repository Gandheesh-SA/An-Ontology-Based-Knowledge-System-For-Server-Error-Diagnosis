  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-MEM0001/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi-bit memory errors are detected on the memory device at location(s) arg1. Immediately replace the DIMM.</diag:messageText>
