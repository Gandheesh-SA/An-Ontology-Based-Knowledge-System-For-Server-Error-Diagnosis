  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/procedure/02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/procedure/02/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/procedure/02/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/procedure/02/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/procedure/02/item/003"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e recommendation 2</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this message is observed without any drive movement, do the following:
1.  Make sure that the cache module is working.
2.  Replace the cache module, if required.
3.  If the issue persists, power down the server and move the drives back to the original controller.
4.  If the issue persists, contact Hewlett Packard Enterprise support.</diag:procedureText>
  </rdf:Description>
