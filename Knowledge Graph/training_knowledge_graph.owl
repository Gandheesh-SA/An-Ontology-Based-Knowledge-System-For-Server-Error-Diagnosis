  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0114">
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">990</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">989</diag:sourcePage>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIAG0114</diag:eventName>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-DIAG0114</diag:recordId>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depends on &lt;Error Reason&gt;. If it is "Unable to start" it usually indicates a software problem. "Cache integrity" could signal a processor cache hardware problem. The other CPU messages could result from hardware or from overheating, if for instance, the fans are marginal or airflow is blocked.</diag:explanation>
    <rdfs:label xml:lang="en">Dell DIAG0114: DIAG0114</rdfs:label>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0114/message/01"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0114/procedure/01"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIAG0114</diag:eventCode>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Processor"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Cooling%20and%20Temperature"/>
  </rdf:Description>
