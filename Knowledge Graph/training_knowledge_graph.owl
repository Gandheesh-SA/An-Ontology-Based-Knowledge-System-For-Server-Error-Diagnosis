    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The physical disk specified is not large enough to be a hot spare for this virtual disk.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na7ed281cbc124010a1aefe59c2aa44c9">
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Replace the DIMM immediately to avoid data loss or data corruption. The DIMM is a part of the controller battery pack. Refer to the storage hardware documentation for information on replacing the DIMM.</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
