  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6030">
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Virtual-Connect-6030</diag:recordId>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6030 - Profile could not be assigned to powered up server</diag:eventName>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6030/procedure/01/cause"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">603</diag:sourcePage>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6030/procedure/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <rdfs:label xml:lang="en">HPE 6030: 6030 - Profile could not be assigned to powered up server</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A profile was changed or assigned and some configuration required that the server be powered off to make the change. For example, if the number of Ethernet connections is changed for a profile that is assigned to a server with Flex-10 NICs, then the server must be powered off.</diag:explanation>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Network%20Adapter%20and%20Link"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
