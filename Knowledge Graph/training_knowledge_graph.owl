  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0252">
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <rdfs:label xml:lang="en">Dell UEFI0252: UEFI0252</rdfs:label>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0252/procedure/01/cause"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The watchdog timer is armed before the BIOS boot manager invokes an UEFI boot option. The watchdog is set to a period of 5 minutes. The Operating System boot loader from the boot option is required to disable the watchdog timer after it is successfully loaded, otherwise the system will reset if the timer expires.</diag:explanation>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
