    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The version number of Complex Programmable Logical Device (CPLD) on the sleeve identified in the message cannot be read because the CPLD version is very old, or the Chassis Management Controller (CMC) is unable to identify the version.</diag:causeText>
    <rdfs:label xml:lang="en">Dell CMC8609 possible cause 1</rdfs:label>
  </rdf:Description>
