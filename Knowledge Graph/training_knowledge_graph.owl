    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1614/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-MEM9038/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Non-Volatile Dual In-line Memory Module (NVDIMM) device in the slot arg1 has lost persistency and is placed in write-protect mode.</diag:messageText>
