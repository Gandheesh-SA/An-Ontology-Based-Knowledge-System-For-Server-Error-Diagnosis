  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0104">
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0104/message/01"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VLT0104</diag:eventCode>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System hardware detected an over voltage or under voltage condition. If multiple voltage exceptions occur consecutively the system may power down in failsafe mode.</diag:explanation>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Processor"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Power"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VLT0104</diag:eventName>
    <rdfs:label xml:lang="en">Dell VLT0104: VLT0104</rdfs:label>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3806</diag:sourcePage>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0104/procedure/01"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-VLT0104</diag:recordId>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/003"/>
    <rdfs:label xml:lang="en">HPE 0x0460 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Remove and then reinstall the DIMM. For more information, see the server maintenance and service
guide.
CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the
system board connector. See the DIMM handling guidelines at: https://h20565.www2.hpe.com/hpsc/
doc/public/display?sp4ts.oid=7271241&amp;docLocale=en_US&amp;docId=emr_na-c05161786.
2.  Update the system firmware.
Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more
information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an
accompanying server support guide that lists the supported servers and components available for
each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start
Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation).
To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User
Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The
SPP uses Smart Update Manager (SUM) to deploy firmware and system software components.
To update the firmware on HPE Synergy products, see the HPE Synergy Firmware Update Overview
at http://www.hpe.com/info/synergy-docs.
3.  If the issue persists, create a support case and replace the DIMM.
a.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Status.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed.
For specific information about customer replaceable parts, refer to the product maintenance
and service guide.
b.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/cause"/>
  </rdf:Description>
