    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0416/procedure/01"/>
