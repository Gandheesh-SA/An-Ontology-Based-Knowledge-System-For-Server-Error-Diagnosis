  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-OSD80/procedure/01/item/003">
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [344, 701); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">Dell OSD80 printed item 3</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the boot option is not authorized but it can be trusted, enter System Setup &gt; System BIOS &gt; Security Settings page, set Secure Boot Policy to Custom, and add a entry for the boot option in the Authorized Signature Database (System Setup &gt; System BIOS &gt; Security Settings &gt; Custom Policy Settings &gt; Authorized Signature Database &gt; Import Database Entry).</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2)</diag:sourceLabel>
  </rdf:Description>
