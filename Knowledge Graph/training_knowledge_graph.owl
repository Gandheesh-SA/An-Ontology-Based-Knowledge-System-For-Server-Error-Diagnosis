    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0478/procedure/01/item/002"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0478/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Cisco F0478 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. Wait a few minutes to see if the fault clears. This is typically a temporary issue, and can occur after a
firmware upgrade.
2. If the above action did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:procedureText>
  </rdf:Description>
