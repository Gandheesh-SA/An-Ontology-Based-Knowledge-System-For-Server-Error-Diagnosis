    <rdfs:label xml:lang="en">HPE 3031 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  Verify the OA is set up to provide a specific IP address.
•  Verify an external DHCP server is available on the management network.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1840/procedure/01">
