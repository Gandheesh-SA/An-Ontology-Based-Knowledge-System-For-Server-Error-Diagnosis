  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3157/message/01">
    <rdfs:label xml:lang="en">HPE 0x3157 message 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE Persistent Memory Configuration Error - HPE Persistent Memory on Processor %1, DIMM %2 (SN : %3) was configured in interleaving mode. This DIMM has been disabled because one or more DIMMs in the interleaved set is missing. This DIMM was populated on Processor %4, DIMM %5 when the interleaving configuration was successfully applied.</diag:messageText>
  </rdf:Description>
