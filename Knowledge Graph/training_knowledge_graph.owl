  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01">
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Identify the drives that contain the lost logical volumes.
2.  Do one of the following:
•  Move the drives to another controller where the logical volumes can be recreated.
•  If a drive contains a valid logical volume that is in use and a lost logical volume, then do not move
that drive to another controller.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-more-logical-drives-than-are-supported-in-the-c-5905870a8a/procedure/01/cause"/>
  </rdf:Description>
