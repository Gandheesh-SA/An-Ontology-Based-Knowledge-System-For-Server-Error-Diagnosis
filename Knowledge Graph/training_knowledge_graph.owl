    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The iLO RESTful API returns an HTTP Error Status of 401-Unauthorized for any BIOS GET or PUT request.
This occurs when the iLO security settings prevent BIOS communication with iLO.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 337 possible cause 1</rdfs:label>
  </rdf:Description>
