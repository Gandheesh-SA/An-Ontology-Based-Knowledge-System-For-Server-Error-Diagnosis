  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPU0700">
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System BIOS was unable to boot the processor.</diag:explanation>
