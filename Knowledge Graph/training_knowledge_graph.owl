    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F0189</diag:recordId>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINOR</diag:severity>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">voltage-problem</diag:causeCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPU4003/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the CPU4001 message is reported after CPU4003, map the address reported in CPU4001 to a
system component. Update the component driver and firmware. Else, no response action is required.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPU4003/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell CPU4003 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPU4003/procedure/01/item/001"/>
  </rdf:Description>
