    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A memory board or cartridge bus error has been detected in the memory subsystem.</diag:eventName>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memory board, cartridge, or riser bus error detected. An Advanced Memory Protection sub- system board, cartridge, or riser bus error has been detected. Value 0 for CPU means memory is not processor-based.</diag:explanation>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERROR</diag:severity>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RDU0012">
