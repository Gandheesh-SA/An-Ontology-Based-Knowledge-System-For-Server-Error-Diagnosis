    <rdfs:label xml:lang="en">HPE 0x1833 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use HPE SSA to update the array configuration with a supported RAID fault-tolerance level.
For more information, see the HPE Smart Storage Administrator User Guide on the Hewlett Packard
Enterprise website http://www.hpe.com/info/smartstorage/docs.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1833/procedure/01/item/001"/>
