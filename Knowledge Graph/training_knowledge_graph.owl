    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the RAID controller battery. For information about replacing the battery, see the hardware documentation of the respective RAID card.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [44, 187); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell VDR58 printed item 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf38fca2f98034036a2996697fcb47ee9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Disable the key management security feature, Secure Enterprise Key Manager (SEKM), or iDRAC Local Key Management (iLKM) by running the following RACADM command at the Command Line Interface (CLI), and then retry the operation: For SEKM: racadm sekm disable. For iLKM: racadm iLKM disable.</rdfs:comment>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
