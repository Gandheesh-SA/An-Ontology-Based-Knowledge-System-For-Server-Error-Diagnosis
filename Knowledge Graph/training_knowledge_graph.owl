  <rdf:Description rdf:nodeID="Na606ffc8210f4e92891af7cfa3178400">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR60/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Verify the health of attached devices. Review the Lifecycle log for significant events. Replace faulty hardware, if required. Make sure the cables are attached securely. Refer to the storage hardware documentation for more information on checking the cable connections.</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
