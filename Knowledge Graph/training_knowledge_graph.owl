  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1786/procedure/01/item/004">
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [448, 702); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 1786 printed item 4</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the failed drive and press the F1 key to rebuild the array. If the drive rebuild is not successful or is aborted because the system rebooted before the rebuild of the drive completed, another version of the 1786 POST error message is displayed.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
