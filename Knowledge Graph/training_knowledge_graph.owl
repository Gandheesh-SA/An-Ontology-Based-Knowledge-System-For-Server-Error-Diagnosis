  <rdf:Description rdf:nodeID="N44a4d81ce9a04485a407e30856470bf4">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0567/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0567"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Install Intel PMEM in DIMM slot %1 before populating other slots with PMEM per the memory population guidelines. Review documentation for more information on supported configurations. For more information, see the server maintenance and service guide for your product on the Hewlett Packard Enterprise website:</rdfs:comment>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0567/procedure/01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-307/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fan has failed.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 307 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-383/procedure/02">
    <rdfs:label xml:lang="en">HPE 383 recommendation 2</rdfs:label>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sanitize all NVDIMMs on Processor X.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
