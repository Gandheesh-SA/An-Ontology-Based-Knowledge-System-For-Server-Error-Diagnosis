  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1896">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltNetworkLimitPvlifvlanmbr</diag:eventName>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlif-vlan-mbr-exhausted</diag:causeCategory>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">377</diag:sourcePage>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F1896</diag:eventCode>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1896/procedure/01"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F1896</diag:recordId>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs when number of PV LifVlanMbr on a particular asic in the fabric interconnect has reached an upper threshold. It gets cleared when the numbers reaches a lower threshold</diag:explanation>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1896/message/01"/>
