    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The serial number for the DIMM in Slot %1, Processor %2 is 00000000</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN0022/procedure/01">
    <rdfs:label xml:lang="en">Dell FAN0022 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the Embedded System Management (ESM) Log for any sensor related faults. If the fan sensor
has failed, replace the system board. For more information, contact your service provider.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/System%20board"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN0022/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8597/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Power Supply Unit (PSU) arg1 is turned off because it is not supported by the Chassis.</diag:messageText>
    <rdfs:label xml:lang="en">Dell PWR8597 message 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
