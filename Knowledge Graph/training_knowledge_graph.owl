  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0901">
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Monitoring"/>
    <rdfs:label xml:lang="en">Cisco F0901: fltAdaptorUnitExtnMissing</rdfs:label>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltAdaptorUnitExtnMissing</diag:eventName>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0901/procedure/01"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">192</diag:sourcePage>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs when an I/O adapter unit extension, such as a pass-through adapter, is missing. Cisco UCS Manager raises this fault when any of the following scenario occur: • The endpoint reports there is no adapter unit extension, such as a pass-through adapter, plugged into the adapter slot. • The endpoint cannot detect or communicate with the adapter unit extension plugged into the adapter slot.</diag:explanation>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F0901</diag:eventCode>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F0901</diag:recordId>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">equipment-missing</diag:causeCategory>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0901/message/01"/>
  </rdf:Description>
