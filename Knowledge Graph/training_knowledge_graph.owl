  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 292 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change the Boot Mode to UEFI Mode:
1.  From the System Utilities screen, select System Configuration &gt; BIOS/Platform Configuration
(RBSU) &gt; Boot Options &gt; Boot Mode.
2.  Select UEFI Mode (default)-Configures the system to boot to a UEFI compatible operating system.
3.  Save your settings.
4.  Reboot the server.
For more information, see the UEFI System Utilities user guide for your product on the Hewlett Packard
Enterprise website (https://www.hpe.com/info/uefi/docs).</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-292/procedure/01/item/003"/>
  </rdf:Description>
