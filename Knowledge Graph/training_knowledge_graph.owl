    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibre Channel Tape Drive Status Change.</diag:eventName>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqstmsg.dll</diag:eventNamespace>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">473</diag:sourcePage>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1176</diag:eventCode>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Storage"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1176/procedure/01"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqstmsg-dll-1176</diag:recordId>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1176/message/01"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibre Channel Tape Drive Status Change. This trap indicates that the agent has detected a change in the status of a Fiber Channel Tape Drive. The variable cpqFcTapeDriveStatus indicates the current tape status. The variable cpqFcTapeDriveScsiTarget indicates the SCSI ID of the tape drive.</diag:explanation>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <rdfs:label xml:lang="en">HPE 1176: Fibre Channel Tape Drive Status Change.</rdfs:label>
  </rdf:Description>
