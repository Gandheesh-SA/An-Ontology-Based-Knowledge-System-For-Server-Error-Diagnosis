  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1775/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">HPE 1775 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1775-Slot X Drive Array – Storage Enclosure Cabling Problem Detected: SAS Port Y: OUT port of this box is attached to OUT port of previous box. Turn system and storage box power OFF and check cables. Drives in this box and connections beyond it will not be available until the cables are attached correctly.</diag:messageText>
  </rdf:Description>
