  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0364/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Source action_text character span [0, 996); ACTIONABLE_SOURCE_PREFIX; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. Shared component alone does not justify this corrective operation for the source cause.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x0364 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the NVDIMM firmware. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs. If this issue persists, create an HPE Support Case.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0517/procedure/01/item/001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the POST results for the server. In Cisco UCS Manager GUI, you can access the POST results from the General tab for the server. In Cisco UCS Manager CLI, you can access the POST results through the show post command under the scope for the server.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:label xml:lang="en">Cisco F0517 printed item 1</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [53, 308); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
  </rdf:Description>
