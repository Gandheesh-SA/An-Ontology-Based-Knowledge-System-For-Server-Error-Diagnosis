    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perform fabric upgrade to upgrade the I/O Modules or delete the SmartFabric and retry the operation
again.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd52fb87d3c5d4ec0886bb6db005db7a4">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Remove and then reinstall the DIMM. For more information, see the server maintenance and service guide. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the DIMM handling guidelines at: https://h20565.www2.hpe.com/hpsc/ doc/public/display?sp4ts.oid=7271241&amp;docLocale=en_US&amp;docId=emr_na-c05161786.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0460/procedure/01/item/001"/>
  </rdf:Description>
