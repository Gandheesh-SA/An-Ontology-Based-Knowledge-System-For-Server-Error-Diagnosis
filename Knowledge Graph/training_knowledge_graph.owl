    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">External Tape Drive Status Change. This trap indicates that the agent has detected a change in the status of an External Tape Drive. The variable cpqFcTapeDriveStatus indicates the current tape status.</diag:explanation>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
