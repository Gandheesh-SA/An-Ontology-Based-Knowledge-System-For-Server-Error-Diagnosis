    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Server Configuration Lock logic has detected a Digital Fingerprint discrepancy. This could signal that a
system Firmware Revision has been changed since Server Configuration Lock was enabled.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x3111 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR99/procedure/01/item/001">
