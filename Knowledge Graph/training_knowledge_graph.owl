    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Check battery contacts, plugs and cables. May need to replace battery.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SUP0558">
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
