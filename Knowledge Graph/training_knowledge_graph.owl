  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2109/procedure/01/item/004">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">HPE 0x2109 printed item 4</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [205, 512); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the component is either under warranty or contract. Go to the: Customer Self Repair website. This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1799/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x1799 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A POST message displays: Slot # Drive Array. Drives disabled due to cache data loss.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR073/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 126); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the Dell iDRAC Service Module (ISM) to the version that supports the requested operation on the PCIe SSD (NVMe) device.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell STOR073 printed item 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0232/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">Dell VLT0232 message 1</rdfs:label>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "number", "name": "arg1"}, {"description": "name", "name": "arg2"}]</diag:messageArguments>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mezzanine card arg1 arg2 voltage is greater than the upper warning threshold.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU1010/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Dell PSU1010 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU1010/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check to see whether the power switch is turned off or on. If it is turned off, turn it on. If the problem
is not corrected, verify that the power cord is attached and functional. If the problem continues or if
the power switch is already turned on, then replace the power supply unit.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0313/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Source action_text character span [0, 88); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connect the Baseboard UPI D cable. For more information, see the platform Owners Manual.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell UEFI0313 printed item 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0275/procedure/01">
    <rdfs:label xml:lang="en">HPE 0x0275 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0275/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0275/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the System ROM to a version supporting processor stepping.
Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more
information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an
accompanying server support guide that lists the supported servers and components available for each
of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are
available on the SPP Information Library (http://www.hpe.com/info/spp/documentation).
To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide
and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses
Smart Update Manager (SUM) to deploy firmware and system software components.
To update the firmware on HPE Synergy products, see the HPE Synergy Firmware Update Overview at
http://www.hpe.com/info/synergy-docs.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PCI5008/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PCI5008/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PCI5008/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Perform an AC Power Cycle operation on the Chassis by disconnecting the
chassis from AC power, waiting for 30 seconds, and then reconnecting AC power. 2) Power on
at least one server. Using the Chassis Management Controller (CMC) web interface, select Server
Overview-&gt;Power-&gt;Control and then click the Operation field and select the Power On Server
operation. If the issue persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit
https://www.dell.com/support/incidents-online/contactus/dynamic to use the Virtual Assistant to
analyze the collection and recommend a resolution.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell PCI5008 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2ac41943b4494aa6bb0502904a9cb2ad">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0200/procedure/01"/>
