  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0037/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell NVRE0037 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Startup Restore operation cannot be performed because the service tag of online IOM nodes in the Startup Backup file does not match the service tag of online nodes on the target IOMs.</diag:causeText>
