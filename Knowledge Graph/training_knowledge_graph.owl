    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1809/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that the remote key manager configuration settings in iLO are properly configured.</diag:itemText>
    <rdfs:label xml:lang="en">HPE 1809 printed item 2</rdfs:label>
