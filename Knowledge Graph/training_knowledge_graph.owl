  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0155/procedure/01/item/001">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power down system and check the signal and power connections to the hard drive. Rerun the diagnostic. If no error occurs then it was a cable or connector issue. This error is issued for notebooks which must have a hard disk so it is an error if not found.</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 255); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:label xml:lang="en">Dell DIAG0155 printed item 1</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
