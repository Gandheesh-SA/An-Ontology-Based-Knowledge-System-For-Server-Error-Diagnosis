    <rdfs:label xml:lang="en">Dell SWU8535 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the iKVM firmware image file is available at the specified location, and then retry the
operation.</diag:procedureText>
