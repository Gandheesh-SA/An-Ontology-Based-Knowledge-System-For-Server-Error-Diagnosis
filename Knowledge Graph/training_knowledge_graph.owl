    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqsvmsg.dll</diag:eventNamespace>
