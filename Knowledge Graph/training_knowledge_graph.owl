    <rdfs:label xml:lang="en">Dell GMGR0080 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to upgrade the firmware because the image file cannot be downloaded.</diag:messageText>
