    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/013"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/012"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/item/008"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  If the device does not support bifurcation, disable support.
•  If the device supports bifurcation, reinstall the add-in card.
•  If the issue persists, update the card firmware.
1.  Go to https://support.hpe.com/hpesc/public/home.
2.  Under Documentation and Software, click Knowledge Base.
3.  Enter System ROM 2.20 in the search bar, and then click search.
4.  Click Drivers and Software.
5.  Under Operating System, select the correct operating system.
6.  Under Software Type, select BIOS (Entitlement Required).
7.  Under Software Subtype, select System ROM.
8.  Select the appropriate patch, and then click Download.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to the:
Customer Self Repair website.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Create a support case at: http://www.hpe.com/support/hpesc.
HPE Support will contact you.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3022/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x3022 recommendation 1</rdfs:label>
  </rdf:Description>
