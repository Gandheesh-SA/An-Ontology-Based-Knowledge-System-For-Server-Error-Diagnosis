  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED086/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Chassis firmware cannot be updated because the Chassis Management/Management Module at Server (CMAS) attribute is incorrectly set. The CMAS attribute must be set to Monitor and Configure on the CMC/MM in order to update CMC/MM firmware from and iDRAC.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell RED086 possible cause 1</rdfs:label>
  </rdf:Description>
