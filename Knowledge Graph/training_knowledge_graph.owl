    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31D2/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 0x31D2 recommendation 1</rdfs:label>
  </rdf:Description>
