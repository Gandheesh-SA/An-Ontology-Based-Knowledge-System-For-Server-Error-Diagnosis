    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">258-Unsupported Processor Configuration Detected. This system supports either 2 processor or 4 processor configurations and is currently configured with &lt;1 or 3&gt; processor(s). Action: Install either 2 or 4 processors.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 258 message 1</rdfs:label>
  </rdf:Description>
