  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01">
    <rdfs:label xml:lang="en">Dell SEKM038 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disable the key management security feature, Secure Enterprise Key Manager (SEKM), or iDRAC
Local Key Management (iLKM) by running the following RACADM command at the Command Line
Interface (CLI), and then retry the operation: For SEKM: racadm sekm disable. For iLKM: racadm iLKM
disable.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01/item/001"/>
  </rdf:Description>
