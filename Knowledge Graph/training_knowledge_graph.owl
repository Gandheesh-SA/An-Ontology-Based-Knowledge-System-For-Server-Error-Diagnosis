    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1715/procedure/01/item/003"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1715/procedure/01/cause"/>
  </rdf:Description>
