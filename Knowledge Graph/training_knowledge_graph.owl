    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The topology validation failed because of a different type of IOM found in the slot pair in the chassis.</diag:explanation>
