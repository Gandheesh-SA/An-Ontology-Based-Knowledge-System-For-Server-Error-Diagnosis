    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Power Supply Unit (PSU) in the slot arg1 is in the Bootloader mode and therefore does not support all functionalities. It is currently in the Bootloader mode because arg2.</diag:messageText>
