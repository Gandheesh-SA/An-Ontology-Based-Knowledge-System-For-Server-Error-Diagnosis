    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A new NVDIMMM-N device has been installed. Due to interleaving requirements, all NVDIMMs have been
disabled until they have been sanitized.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x0393 possible cause 1</rdfs:label>
  </rdf:Description>
