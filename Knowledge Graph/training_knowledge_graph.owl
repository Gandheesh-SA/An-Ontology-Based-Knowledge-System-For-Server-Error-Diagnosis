    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The iDRAC firmware version is not compatible with the storage controller arg1 firmware version, and therefore, the Sideband Management feature is unavailable.</diag:messageText>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "StorageControllerName", "name": "arg1"}]</diag:messageArguments>
    <rdfs:label xml:lang="en">Dell CTL140 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0378/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. If the PSU is physically present in the slot, remove and then reinsert it.
2. If the PSU is not physically present in the slot, insert a new PSU.
3. If the above action did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0378/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0378/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0378/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">Cisco F0378 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
  </rdf:Description>
