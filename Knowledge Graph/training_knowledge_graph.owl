    <rdfs:label xml:lang="en">Dell RAC990 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enable Lifecycle Controller using the "racadm set
lifecyclecontroller.lcattributes.lifecyclecontrollerstate 1" command, and retry the operation.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfca062df75354d9f9bf3e779b6ff84cc">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU0051"/>
