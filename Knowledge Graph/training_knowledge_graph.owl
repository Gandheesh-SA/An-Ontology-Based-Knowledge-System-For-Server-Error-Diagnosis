  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR064/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR064/procedure/01/cause"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <rdfs:label xml:lang="en">Dell STOR064 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that the physical disks selected for creating the virtual disk have the same block size and retry
the operation. The block size can be determined by reviewing the physical disk inventory and checking
the BlockSize property for each physical disk.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR064/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0014-0x000C/procedure/01/item/002">
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x000C printed item 2</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [118, 298); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that no loose connections exist on the system board or power backplane. It is not necessary to reseat processors. For more information, see "Resolving loose connections".</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N77812565f07949379f796bf0c9b40e29">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR220"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR220/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR220/procedure/01/cause"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#addressesCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR220/procedure/01/item/001"/>
    <rdfs:comment xml:lang="en">population-assessment-1.0; automatic source-anchored rule assessment, not expert validation. Shared concepts: Storage drive. The target retains the complete documented possible-cause block; alternatives are not asserted as confirmed causes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x002A/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x002A possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The power supply might not be fully seated.
•  AC power is unavailable.
•  The power supply failed.
•  The power supply is in standby mode.
•  The power supply has exceeded the current limit.
•  The power supply is not supported on the server.
•  The power is not sufficient for the hardware installed.
•  Redundant power supplies are configured but the power supplies are not compatible.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2103/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:label xml:lang="en">Cisco F2103 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. Check main and MCIO cables going to Riser in addition to AUX power going to PCIe slots and PCIe
cards properly seated, maybe try power cycling, if not fix call TAC.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2103/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR104">
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR104/procedure/01"/>
