  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-346/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 346 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The restore operation succeeded but the NVDIMM cannot be armed for backup due to an NVDIMM
controller failure. As a result, the NVDIMM is reported to the operating system as read-only.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC9006/procedure/01/item/001">
