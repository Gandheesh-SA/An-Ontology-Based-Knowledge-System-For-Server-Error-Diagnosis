  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0020-0x0009/procedure/01">
    <rdfs:label xml:lang="en">HPE 0x0009 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0020-0x0009/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0020-0x0009/procedure/01/item/001"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the Firmware Verification tab is enabled, select Log and Repair Automatically in the Scan Settings
option of the Firmware Verification tab and reinitiate the scan.
The iLO User Guide contains additional information in the topic - Server Platform Services (SPS) Descriptor
Check and Recovery. Loading iLO Advanced License and enabling Log and Repair Automatically
configures the server for Auto recovery.</diag:procedureText>
  </rdf:Description>
