  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0330/procedure/01/item/002">
    <rdfs:label xml:lang="en">HPE 0x0330 printed item 2</rdfs:label>
    <rdfs:comment xml:lang="en">Source action_text character span [62, 563); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SAFETY_CONTEXT. Safety/qualification context is retained but is not interpreted as a corrective instruction.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING: To reduce the risk of personal injury from hot surfaces, allow the drives and the internal system components to cool before touching them. CAUTION: THE PINS ON THE SYSTEM BOARD ARE VERY FRAGILE AND EASILY DAMAGED. To avoid damage to the system board, do not touch the processor or the processor socket contacts. IMPORTANT: Both processor sockets must always be populated. If either processor socket is empty, the server does not power up. If this issue persists, create an HPE Support Case.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
