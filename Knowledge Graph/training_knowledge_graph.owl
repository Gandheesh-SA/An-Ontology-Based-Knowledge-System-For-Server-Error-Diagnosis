    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upgrade the firmware on this controller. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0014-0x000C/procedure/01/item/005">
    <rdfs:comment xml:lang="en">Source action_text character span [772, 1009); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">5</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.</diag:sourceLabel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0014-0x000C/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset the NVRAM to default using the BIOS utility (F9). If the system fails to boot, then use System Maintenance Switch, SW6, to reset the NVRAM. For more information, see the label on the server access panel or the server user guide.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">HPE 0x000C printed item 5</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0034/procedure/01">
