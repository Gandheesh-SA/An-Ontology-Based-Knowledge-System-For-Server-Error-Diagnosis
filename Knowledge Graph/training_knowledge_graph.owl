    <rdfs:label xml:lang="en">Dell PWR8566 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to turn off the Server arg1 before the Power Off timer expired.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbc7aa04fde9b457fb65b315f4c8b53be">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
