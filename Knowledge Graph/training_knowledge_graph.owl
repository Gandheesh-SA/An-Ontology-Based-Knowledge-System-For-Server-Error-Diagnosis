  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0131">
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0131</diag:eventCode>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Memory"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0131/message/01"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <rdfs:label xml:lang="en">Dell PST0131: PST0131</rdfs:label>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0131/procedure/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1885</diag:sourcePage>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-PST0131</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memory errors occurred copying BIOS image into system memory. This exception occurred early in system power on, thus the system may not display video. (BIOS POST Exception Code 83).</diag:explanation>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0131</diag:eventName>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0212/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Disconnect each power cord from the power source.
2.  Disconnect each power cord from the server.
3.  Remove the DIMM.
CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the
system board connector. See the Best Practices for Handling Memory Modules in ProLiant Server
Configurations ( http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).
4.  Clean the DIMM and the DIMM slot with anti-static compressed air.
5.  Reinstall the DIMM.
For additional information, see the server maintenance and sever guide located at http://www.hpe.com/info/
enterprise/docs.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to the:
Customer Self Repair website.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Create a support case at: http://www.hpe.com/support/hpesc.
HPE Support will contact you.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0212/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0212/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0212/procedure/01/item/006"/>
