    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqstmsg.dll</diag:eventNamespace>
    <rdfs:label xml:lang="en">HPE 1155: Storage System Temperature Sensor Status Change.</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1155</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Storage system temperature sensor status change. The agent has detected a change in the status of a storage system temperature sensor. The variable cpqSsTempSensorStatus indicates the current status.</diag:explanation>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
