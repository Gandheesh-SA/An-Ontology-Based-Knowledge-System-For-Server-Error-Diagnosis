  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC3/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check for factors that may cause overheating or excessive cooling. For example, verify that the
enclosure fan is working. You should also check the thermostat settings and examine whether the
enclosure is located near a heat source. Make sure the enclosure has enough ventilation and that
the room temperature is not too hot or too cold. Refer to the enclosure documentation for more
diagnostic information.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdfs:label xml:lang="en">Dell ENC3 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC3/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0020-0x0009/procedure/01/item/001">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0009 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the Firmware Verification tab is enabled, select Log and Repair Automatically in the Scan Settings option of the Firmware Verification tab and reinitiate the scan. The iLO User Guide contains additional information in the topic - Server Platform Services (SPS) Descriptor Check and Recovery. Loading iLO Advanced License and enabling Log and Repair Automatically configures the server for Auto recovery.</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 406); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0020-0x0009/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0729/procedure/01/item/007">
    <rdfs:label xml:lang="en">Cisco F0729 printed item 7</rdfs:label>
    <rdfs:comment xml:lang="en">Source action_text character span [628, 974); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Cisco UCS power capping capability to limit power usage. Power capping can limit the power consumption of the system, including blade and rack servers, to a threshold that is less than or equal to the system's maximum rated power. Power-capping can have an impact on heat dissipation and help to lower the installation site temperature.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">7</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.</diag:sourceLabel>
  </rdf:Description>
