  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2097/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2097/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2097/procedure/01/item/001"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Accelerator"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. Re-acknowledge the server. This will trigger Deep Discovery and inventory the PcieNode and GPUs.
2. If the above actions did not resolve the issue, execute the show tech-support command and contact Cisco
Technical Support.</diag:procedureText>
    <rdfs:label xml:lang="en">Cisco F2097 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0733">
