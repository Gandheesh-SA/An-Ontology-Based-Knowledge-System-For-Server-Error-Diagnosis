  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-THRM0003/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The server is currently ignoring the fan speed limit that is set by enabling the Sound Cap thermal profile because of thermal cooling constraints. The server is expected to reinstate the Sound Cap thermal profile based fan speed limit if the server power consumption and/or power management capabilities allows meeting system thermal requirement. PCIe adapters and storage drives are some sub-systems that do not have granular power controls and may limit overall server power reduction to meet server cooling requirements at the limited fan speed.</diag:causeText>
    <rdfs:label xml:lang="en">Dell THRM0003 possible cause 1</rdfs:label>
  </rdf:Description>
