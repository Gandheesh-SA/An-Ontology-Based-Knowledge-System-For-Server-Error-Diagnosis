  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV1007">
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The IOV slot management subsystem detected an error which may prevent the physical assignment/ unassignment or turning off of a PCIe slot. The errors can be caused by PCIe training timeouts, false hot plug signals,or installation of an unsupported PCIe adapter card. For a list of supported PCIe adapter cards contact your service provider.</diag:explanation>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV1007/procedure/01/cause"/>
