  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1795">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermal-problem</diag:causeCategory>
    <rdfs:label xml:lang="en">Cisco F1795: fltEquipmentSystemIOControllerThermalProblem</rdfs:label>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltEquipmentSystemIOControllerThermalProblem</diag:eventName>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Chassis%20and%20Enclosure"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Processor"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Cooling%20and%20Temperature"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F1795</diag:recordId>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F1795</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs when there is a thermal problem on an System I/O Controller module. Be aware of the following possible contributing factors: • Temperature extremes can cause Cisco UCS equipment to operate at reduced efficiency and cause a variety of problems, including early degradation, failure of chips, and failure of equipment. In addition, extreme temperature fluctuations can cause CPUs to become loose in their sockets. • Cisco UCS equipment should operate in an environment that provides an inlet air temperature not colder than 50F (10C) nor hotter than 95F (35C).</diag:explanation>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1795/procedure/01"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">348</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">349</diag:sourcePage>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1795/message/01"/>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
  </rdf:Description>
