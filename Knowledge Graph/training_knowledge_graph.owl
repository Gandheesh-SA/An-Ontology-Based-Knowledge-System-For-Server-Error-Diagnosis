    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retry the operation. If the issue persists, reset iDRAC and retry the operation.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
