    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An error occurred during Scalable Memory Interconnect (SMI) initialization on memory riser arg1.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR0203/procedure/01">
