    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, insert at least two PSUs and power them on.</diag:itemText>
    <rdfs:label xml:lang="en">Cisco F0742 printed item 1</rdfs:label>
