    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1723/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0491/procedure/01/item/011">
    <rdfs:comment xml:lang="en">Purpose assessment: PREPARATORY_OR_NAVIGATION. Setup/navigation or power isolation alone is not a cause-specific diagnosis or repair.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [1378, 1781); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x0491 printed item 11</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Click the Temperatures tab and verify the temperature readings for each location on the Temperatures tab. If a hot spot is located, then check the airflow path for blockage by cables and other material. A hot spot is not an absolute temperature but is relative to a component specification. Hot spot is defined as temperature on a sensor within 3°C of a Caution threshold listed on the Temperature tab.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">11</diag:itemOrder>
  </rdf:Description>
