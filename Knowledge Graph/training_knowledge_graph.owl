    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2)</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CXL2102/procedure/01/item/001">
