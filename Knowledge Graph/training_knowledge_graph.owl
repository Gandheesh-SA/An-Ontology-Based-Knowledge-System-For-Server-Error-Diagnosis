  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01">
    <rdfs:label xml:lang="en">HPE 0x1810 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Check the network connection between the iLO management port and the remote key manager.
2.  Verify that the remote key manager configuration settings in iLO are properly configured.
3.  If the issue persists, update the iLO, Smart Array, and System ROM to the latest versions.
To update the firmware on HPE ProLiant servers, see Keeping the system current in
the Troubleshooting Guide for HPE ProLiant Gen10 servers at http://www.hpe.com/info/Gen10-
troubleshooting.
To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware
and Driver Updates at http://www.hpe.com/info/synergy-docs.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01/item/002"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01/cause"/>
  </rdf:Description>
