    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0138/message/01"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0138</diag:eventCode>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0138/procedure/01"/>
