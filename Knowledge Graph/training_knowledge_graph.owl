  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0154/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0154/procedure/01/item/001"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check installation of the tape drive, cables and connections. If the error persists, ensure that drive
firmware is current.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell DIAG0154 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0199/procedure/01">
    <rdfs:label xml:lang="en">Dell UEFI0199 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0199/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0199/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0199/procedure/01/item/003"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Remove input power to the system, 2) Reseat the DIMM module and 3) Restart
the system. If the issue persists, then replace the faulty memory module identified in the message.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
  </rdf:Description>
