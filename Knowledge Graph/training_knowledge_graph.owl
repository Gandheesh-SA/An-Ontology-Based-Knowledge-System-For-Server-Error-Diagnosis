    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDE Disk SSD Wear Status Change.</diag:eventName>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This trap signifies that the agent has detected a change in the SSD wear status of a SATA physical drive. The variable cpqIdeAtaDiskSSDWearStatus indicates the current SSD wear status.</diag:explanation>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">508</diag:sourcePage>
  </rdf:Description>
