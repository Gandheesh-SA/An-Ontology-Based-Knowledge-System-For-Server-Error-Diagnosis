  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8511/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disable and then enable the Extended Storage feature. Using racadm, execute the following
commands: "racadm feature -d -c Extended Storage" to disable and then "racadm -a -c Extended
Storage" to enable the feature. NOTE: All the data on the removable flash media SD card is erased
when the feature is disabled.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8511/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell CMC8511 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
