    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2840</diag:sourcePage>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR312/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC8016/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 267); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refer to the platform documentation for details related to SDPM subsystem. Copy any data in the persistent memory to another persistent device such as a hard drive. Power off the system and remove input power. Inspect and re-insert all the SDPM power and data cables.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:label xml:lang="en">Dell HWC8016 printed item 1</rdfs:label>
  </rdf:Description>
