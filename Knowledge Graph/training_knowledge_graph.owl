  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC9015/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC9015/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell SWC9015 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC9015/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the System FPGA or CPLD version either by using UEFI or host Operating System, Lifecycle
Controller User Interface, or iDRAC by using the latest Update Package. The host server will be
unavailable until the update operation is complete.</diag:procedureText>
  </rdf:Description>
