  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Logical-drive-state-The-logical-drive-is-disabled-from-a-SCSI-ID-conflict-0cf5dcb529/message/01">
