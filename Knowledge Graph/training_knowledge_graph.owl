    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1148/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the accelerator board status is permDisabled(5), you may need to replace the accelerator
board.</diag:procedureText>
  </rdf:Description>
