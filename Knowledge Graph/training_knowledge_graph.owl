  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HTR0030/message/01">
    <rdfs:label xml:lang="en">Dell HTR0030 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hardware issue has occurred in the Heater Manager Subsystem. The required sensor arg1 for the arg2 zone is not present.</diag:messageText>
