    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove and re-install failed fans or install additional fans.</diag:itemText>
    <rdfs:label xml:lang="en">Dell RDU0002 printed item 1</rdfs:label>
