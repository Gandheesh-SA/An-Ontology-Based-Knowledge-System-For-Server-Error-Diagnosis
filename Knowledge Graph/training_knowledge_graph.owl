  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e/message/01">
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-a-configuration-that-requires-more-physical-drives-t-e66ec4492e message 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controller State: The array controller has a configuration that requires more physical drives than are currently supported. You may reconfigure the controller, but the existing configuration and data will be overwritten and potentially lost.</diag:messageText>
  </rdf:Description>
