    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqstmsg-dll-1145</diag:recordId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1145/procedure/01"/>
    <rdfs:label xml:lang="en">HPE 1145: External Array Logical Drive Status Change.</rdfs:label>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">External Array Logical Drive Status Change. This trap indicates that the agent has detected a change in the status of an External Array logical drive. The variable cpqFcaLogDrvStatus indicates the current logical drive status.</diag:explanation>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">460</diag:sourcePage>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC0004/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC0004/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC0004/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC0004/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC0004/procedure/01/item/003"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reinsert or replace the vFlash SD card, or reset iDRAC, and retry the operation. If the problem
persists: 1) Turn off the system and disconnect the power cord. 2) Wait for five seconds. 3)
Reconnect the power cord, turn on the system, and retry the operation.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell HWC0004 recommendation 1</rdfs:label>
  </rdf:Description>
