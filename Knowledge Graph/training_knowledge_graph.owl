  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1274/procedure/01/item/001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the input values are correct and retry the operation. For information about valid options, run the following racadm command:"racadm help biosscan".</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
