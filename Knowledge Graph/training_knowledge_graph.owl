    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To change the default cache read or write allocation ratio, run HPE SSA.
For more information, see the HPE Smart Storage Administrator User Guide on the Hewlett Packard
Enterprise website.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1726/procedure/01/item/001"/>
  </rdf:Description>
