  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT400/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/System%20board"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT400/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT400/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT400/procedure/01/item/001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do one of the following to resolve the issue: 1) Verify the Embedded System Management (ESM) Log
for any sensor related faults. If there is a failed sensor, replace the system board. 2) Re-configure the
system to a minimum configuration, and verify if the sensor displays a normal value, otherwise replace
the system board. 3) If the sensor identified is a processor voltage sensor, remove the processor
module and inspect processor socket, and replace if required. If the issue persists, contact your
service provider.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell VLT400 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0d0b7ba3d04343c5bf30e33833df84d7">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1832"/>
