  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-4012/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The module is non-functional due to a hardware or firmware failure. VC cannot configure or monitor this module. This error will impact Fibre Channel traffic. Possible cause: The OA reported the module status as failed. This is due to a hardware failure or a firmware failure. The firmware failure could be a kernel panic, memory exhausted, CPU overload, or boot failure.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 4012 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670/procedure/01/item/001">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 406); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset the server and resolve the pinned cache issue to complete the firmware activation process. To reset the server, on the iDRAC GUI, click Configuration &gt; Power Management &gt; Power Control &gt; Power Cycle System (cold boot). Else, run the RACADM command at the Command Line Interface (CLI): racadm serveraction powercycle. For more information, see the Controller Users Guide available on the support site.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell SWU8670 printed item 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-a-volume-that-was-created-with-a-different-vers-16993e9ef4/procedure/01/item/002">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the issue persists, move the configured arrays back to the original controller.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-a-volume-that-was-created-with-a-different-vers-16993e9ef4 printed item 2</rdfs:label>
