    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Monitoring"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR372/procedure/01"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STOR372</diag:eventName>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR372/procedure/01/cause"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unmap-enabled Virtual Drive (VD) identified in the message cannot be created because either the controller is not unmap-capable or the controllers unmap state is disabled.</diag:explanation>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
