    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use any of the iDRAC interfaces and switch the PERC from LKM to SEKM mode. If the current PERC
firmware version does not have the PERC LKM to SEKM transition capability then update the PERC
firmware to a version that supports the transition.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM067/procedure/01/item/001"/>
  </rdf:Description>
