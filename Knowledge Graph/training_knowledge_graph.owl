  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01/item/004"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2402/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the Lifecycle Controller Log (LC Log) and make sure that there are no subsequent log entries
indicating that Communication with power management firmware has been restored. If this log entry
is not present then do one of the following: 1) Disconnect system input power, wait one minute,
reconnect system input power. 2) Re-flash system BIOS. 3) Upgrade system BIOS to the latest
revision.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell PWR2402 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9/procedure/02">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9/procedure/02/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9/procedure/02/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9/procedure/02/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9/procedure/02/item/002"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-contains-one-or-more-logical-drives-with-a-RAID-level-th-9a849d3cf9 recommendation 2</rdfs:label>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this message is observed without any drive movement, do the following:
1.  Make sure that the cache module is working.
2.  Replace the cache module, if required.
3.  If the issue persists, power down the server and move the drives back to the original controller.
4.  If the issue persists, contact Hewlett Packard Enterprise support.</diag:procedureText>
  </rdf:Description>
