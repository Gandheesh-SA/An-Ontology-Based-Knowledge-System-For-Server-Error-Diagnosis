    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0343/procedure/01"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Turn off the server and reinstall or replace the backplane signal cable. For more information about the cable connections, see the Owners Manual of the system available on the support site.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0772/message/01">
