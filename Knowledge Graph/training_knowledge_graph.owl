    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The iDRAC Hard Reset operation cannot be performed either because of an unsupported CPLD firmware version or the iDRAC Hard reset feature is currently disabled on iDRAC.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
