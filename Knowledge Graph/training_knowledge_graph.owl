    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review the product specifications to determine the temperature operating range of the fan module.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
