    <rdfs:label xml:lang="en">Dell VLT0202 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5305f73c10fa4a05b7fa02516c6c4578">
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR150/procedure/01/cause"/>
