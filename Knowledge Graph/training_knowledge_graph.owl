    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Storage Enclosure: Warning: The enclosure is reporting a high temperature status.</diag:messageText>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-The-enclosure-is-reporting-a-high-temperature-status-6a263e88c2 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR0103/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR0103/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check if the server has power, physical disks are available, and physical disks are connected to the
enclosure or backplane.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell STOR0103 recommendation 1</rdfs:label>
  </rdf:Description>
