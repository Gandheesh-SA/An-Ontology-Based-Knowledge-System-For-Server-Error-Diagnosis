  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-384/procedure/01">
    <rdfs:label xml:lang="en">HPE 384 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To enable the NVDIMM, disable Channel Interleaving in UEFI System Utilities.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
