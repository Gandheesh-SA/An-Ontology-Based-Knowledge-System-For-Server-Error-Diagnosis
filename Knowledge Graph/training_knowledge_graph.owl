    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the Embedded System Management (ESM) Log for any sensor related faults. If the fan sensor has failed, replace the system board. For more information, contact your service provider.</diag:itemText>
