    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1826/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1826/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 1826 recommendation 1</rdfs:label>
  </rdf:Description>
