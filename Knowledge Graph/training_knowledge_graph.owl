    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-GMGR0087/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the latest iDRAC firmware version on the server and retry the operation. To update iDRAC by
using iDRAC GUI, click (Maintenance &gt; System Update &gt; Manual Update). By using RACADM, run the
following at the Command Line Interface (CLI): "racadm update".</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
  </rdf:Description>
