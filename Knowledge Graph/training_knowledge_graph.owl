  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2254/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check for unacknowledged use of 110V and change to acknowledged. Using the Chassis
Management Controller/Management Module (CMC/MM) web interface, select Chassis
Overview&gt;Power&gt;Configuration and then check the 110V Acknowledge field. Retry the operation to
turn on the server.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
