  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/007"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/008"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/006"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/004"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Use iLO to check the HPE Smart Storage Battery charge. Verify that the battery charge is sufficient to
enable caching.
2.  Be sure the cache module is seated properly.
3.  Reseat the cache module.
4.  Replace the cache module.
For more information, see the server maintenance and service guide on the Hewlett Packard
Enterprise website.
1.  Use iLO to verify that the HPE Smart Storage battery is charged, and that the charge is sufficient to
enable caching
2.  Verify that the cache module is seated properly.
3.  Reseat the cache module.
4.  Replace the cache module.
For more information, see the server maintenance and service guide on the Hewlett Packard
Enterprise website.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 1797 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0004/procedure/01/item/003">
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [277, 584); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the component is either under warranty or contract. Go to the: Customer Self Repair website. This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x0004 printed item 3</rdfs:label>
  </rdf:Description>
