  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0030/procedure/01">
    <rdfs:label xml:lang="en">Dell NVRE0030 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the I/O Module, management interface configuration, and physical connectivity are
appropriate for the node, and then retry the operation. If the issue persists, contact your service
provider.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0030/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8571/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The coin cell battery in the primary CMC is not working.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell CMC8571 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8598/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the PSU with an appropriate unit, and then retry the operation. For a list of PSUs that are compatible, consult the system Owners Manual or If the issue persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/support/incidents- online/contactus/dynamic to use the Virtual Assistant to analyze the collection and recommend a resolution.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8598/procedure/01/cause"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 385); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell PWR8598 printed item 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8578/procedure/01">
    <rdfs:label xml:lang="en">Dell PWR8578 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure there is enough power supply to distribute power. Go to, the Chassis Overview &gt; Power &gt;
Power Budget Status. In the Total Input Power Available For Allocation field, view the available power.
To add more power, insert more PSUs or remove unused components from the chassis. Remove and
reinsert the server when enough power is available.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8578/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0013-0x0018/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 221); ACTIONABLE_SOURCE_PREFIX; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To determine which drives cannot be validated as genuine, run the Smart Storage Administrator tool. For more information, see the Smart Storage Administrator User Guide. If this issue persists create an HPE Support Case.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">HPE 0x0018 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR150/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to update the drive firmware because the drive is not in a locked state and is potentially vulnerable to unexpected data access.</diag:messageText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">Dell PDR150 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x0055/procedure/01/item/003">
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [154, 263); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If battery failure is indicated, remove and reinstall the power supply containing the battery backup unit.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x0055 printed item 3</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
