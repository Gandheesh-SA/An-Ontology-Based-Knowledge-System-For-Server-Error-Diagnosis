    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Extended Power Performance cannot be used because the power supply unit (PSU) slot identified in the message has no power supply.</diag:explanation>
