  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2107/procedure/01/item/010">
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8.</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [787, 853); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">10</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Select Start firmware update and allow the process to complete.</diag:itemText>
    <rdfs:label xml:lang="en">HPE 0x2107 printed item 10</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000D-0x0003/procedure/01/item/013">
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">13</diag:itemOrder>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [1164, 2417); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">HPE 0x0003 printed item 13</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run SUT from the command line (On-Demand mode) to update the Smart Array firmware. For more information, see to the HP SUT documents at http://www.hpe.com/info/sut-docs. Service Pack for ProLiant (SPP): Update the firmware by downloading the SPP from the Hewlett Packard Enterprise website (http:// www.hpe.com/servers/spp). Refer to the SPP documentation at http://www.hpe.com/info/spp/documentation for instructions on updating the firmware. Note: Downloading an SPP requires a contract with Hewlett Packard Enterprise and an HPE Passport ID. If you do not have an HPE Passport ID, go to http://www.hpe.com/info/insightonline. Note: Downloading the entire SPP can take a significant amount of time. Online Flash components This component provides updated system firmware that can be installed directly on supported operating systems. Additionally, when used in conjunction with the SUM, this Smart Component allows you to update firmware on remote servers from a central location. This remote deployment capability eliminates the need for you to be physically present at the server to perform a firmware update. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http:// www.hpe.com/info/hpsum/documentation.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1797/procedure/01/item/001">
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use iLO to check the HPE Smart Storage Battery charge. Verify that the battery charge is sufficient to enable caching.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
