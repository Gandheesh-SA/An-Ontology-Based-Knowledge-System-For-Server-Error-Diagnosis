    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Make sure the integrated NICs are enabled from BIOS setup and support OS to iDRAC Pass-Through, then retry the operation. To access BIOS setup, press F2 during system startup. For more information about OS to iDRAC Pass-Through, see iDRAC7 Users Guide.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0607/procedure/01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD3073/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retry the operation. If the issue persists, contact your system administrator.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell CUPD3073 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD3073/procedure/01/item/001"/>
