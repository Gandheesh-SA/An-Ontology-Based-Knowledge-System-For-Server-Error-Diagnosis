    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uncorrectable machine check exception (%1 %2, APIC ID 0x%3, Bank 0x%4, Status 0x%5'%6, Address 0x%7'%8, Misc 0x%9'%10).</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
