    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">Dell RED148 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to perform firmware update because Baseboard Management Controller (BMC) is in the locked state.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3030/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3030/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x3030 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3030/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reinstall DRAM and HPE Persistent Memory Modules according to the server memory population rules
guide. For DIMM population, see the Population rules for HPE DDR4 memory with HPE ProLiant and
Synergy Gen10 servers at (http://www.hpe.com/docs/memory-population-rules).
CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system
board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations
(http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).</diag:procedureText>
  </rdf:Description>
