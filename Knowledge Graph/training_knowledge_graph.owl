  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-GMGR0087/procedure/01">
    <rdfs:label xml:lang="en">Dell GMGR0087 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-GMGR0087/procedure/01/item/001"/>
