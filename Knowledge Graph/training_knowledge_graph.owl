    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">10</diag:itemOrder>
    <rdfs:label xml:lang="en">HPE 0x3020 printed item 10</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the component is either under warranty or contract. Go to https://support.hpe.com/hpesc/ public/home, and then click Check Status under Warranty. This enables Hewlett Packard Enterprise to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide.</diag:itemText>
