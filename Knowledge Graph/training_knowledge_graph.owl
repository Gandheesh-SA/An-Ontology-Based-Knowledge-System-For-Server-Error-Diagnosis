    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STOR394</diag:eventName>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The physical drive identified in message cannot be discovered because of incompatibility issues. Some of the issues because of which a device cannot be discovered are as follows: 1) Missing namespace in NSID 1. 2) No namespace is created. 3) Logical Block Addressing (LBA) size is not either one of these: 512 B or 4K. 4) When the Protection Information (PI) feature is enabled.</diag:explanation>
    <rdfs:label xml:lang="en">Dell STOR394: STOR394</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
