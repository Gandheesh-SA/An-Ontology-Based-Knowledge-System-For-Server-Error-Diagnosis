  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0490/procedure/01/item/012">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">12</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Click the Temperatures tab and verify the temperature readings for each location on the Temperatures tab. If a hot spot is located, then check the airflow path for blockage by cables and other material. A hot spot is not an absolute temperature but is relative to a component specification. Hot spot is defined as temperature on a sensor within 3°C of a Caution threshold listed on the Temperature tab.</diag:itemText>
    <rdfs:comment xml:lang="en">Purpose assessment: PREPARATORY_OR_NAVIGATION. Setup/navigation or power isolation alone is not a cause-specific diagnosis or repair.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [1523, 1926); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x0490 printed item 12</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0013-0x0020/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  A cable is not installed correctly.
2.  The drive is not installed correctly.
3.  The drive is not supported by the backplane or controller.
4.  The drive is failed or predictive failure.</diag:causeText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 0x0020 possible cause 1</rdfs:label>
  </rdf:Description>
