  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x000A/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 0x000A possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the connection is lost, could be due to one of the below:
•  The firmware or drivers are outdated, mismatched, or faulty.
•  The NIC or cable is not seated properly.
•  The NIC, the cable, or other hardware is faulty.
•  The hardware components are not supported in the same configuration.
•  The NIC is not supported on the server.</diag:causeText>
  </rdf:Description>
