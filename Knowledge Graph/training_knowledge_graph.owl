and did not complete successfully.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x0553 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-IML-Text-Uncorrectable-PCI-Express-Error-Slot-X-Bus-Y-Device-Z-Function-W-Error-status-hex-value-71d9a65fea/message/01">
