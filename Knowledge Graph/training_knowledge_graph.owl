    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:similarTo rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0185"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs when a DIMM is in a degraded operability state. This state typically occurs when an excessive number of correctable ECC errors are reported on the DIMM by the server BIOS.</diag:explanation>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
  </rdf:Description>
