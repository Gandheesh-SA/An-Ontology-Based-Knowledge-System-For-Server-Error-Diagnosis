  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1903/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1903/procedure/01/cause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1903/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1903/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1903/procedure/01/item/003"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the controller to the latest firmware version.
Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more
information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an
accompanying server support guide that lists the supported servers and components available for each
of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are
available on the SPP Information Library (http://www.hpe.com/info/spp/documentation).
To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide
and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses
Smart Update Manager (SUM) to deploy firmware and system software components.
To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and
Driver Updates at http://www.hpe.com/info/synergy-docs.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Check Status under the Warranty Check
heading.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 0x1903 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0185/procedure/01/item/003">
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Support escalation or collection instructions are not treated as a repair of the cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [194, 297); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the above actions did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Cisco F0185 printed item 3</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
  </rdf:Description>
