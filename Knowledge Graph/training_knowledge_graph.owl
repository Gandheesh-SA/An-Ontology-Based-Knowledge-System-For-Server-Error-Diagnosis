    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltDcxVcDown</diag:eventName>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">link-down</diag:causeCategory>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">36</diag:sourcePage>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0283/procedure/01"/>
