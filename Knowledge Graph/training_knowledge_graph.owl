  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SDPM7197/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The server cannot be armed because the fan configuration is not supported. A Software Defined Persistent Memory (SDPM) server requires very high performance fans.</diag:causeText>
