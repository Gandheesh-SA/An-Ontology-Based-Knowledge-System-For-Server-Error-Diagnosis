    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Dell STOR369 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the PERC by using a PERC that has hard Secure Boot enabled. For information about
replacing a PERC card, see the respective servers Installation and Service Manual available on the
support site. Also, see the relevant QRL PowerEdge server micro videos.</diag:procedureText>
