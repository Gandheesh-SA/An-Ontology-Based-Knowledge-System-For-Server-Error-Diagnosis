    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the NVDIMM to the latest firmware. If the issue persists, replace the faulty memory module identified in the message.</diag:itemText>
  </rdf:Description>
