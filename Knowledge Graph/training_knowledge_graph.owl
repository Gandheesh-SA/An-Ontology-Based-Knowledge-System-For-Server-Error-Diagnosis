    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If all the fans are functioning, check the chassis temperature in the CMC Web Interface or by using RACADM. When the fans are functioning properly and the chassis temperature is too high, the ambient air temperature is too high or the air inlets are not receiving sufficient air.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8543/procedure/01/cause"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3)</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC7530/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC7530/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell HWC7530 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retry the operation. If the issue persists, contact your service provider.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV2008/procedure/01/item/001">
    <rdfs:label xml:lang="en">Dell IOV2008 printed item 1</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [20, 166); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perform an AC Power Cycle operation on the Chassis by disconnecting the chassis from AC power, wait for 30 seconds, and then reconnect AC power.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
