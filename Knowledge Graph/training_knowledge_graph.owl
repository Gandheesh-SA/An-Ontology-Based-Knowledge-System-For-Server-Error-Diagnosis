  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2255/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disable the Max Power Conservation Mode on the chassis and retry the operation. Using the
Chassis Management Controller/Management Module (CMC/MM) web interface, select Chassis
Overview&gt;Power&gt;Configuration and then uncheck the Max Power Conservation Mode field.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
