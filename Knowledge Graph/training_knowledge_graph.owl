  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-376/procedure/02">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-376/procedure/02/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sanitize all NVDIMMs on Processor X. The data on the NVDIMM will not be available after sanitization.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 376 recommendation 2</rdfs:label>
