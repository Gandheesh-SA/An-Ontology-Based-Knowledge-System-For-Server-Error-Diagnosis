    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the failing DIMM. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the DIMM handling guidelines at: https://h20565.www2.hpe.com/hpsc/doc/public/display? sp4ts.oid=7271241&amp;docLocale=en_US&amp;docId=emr_na-c05161786.</diag:itemText>
    <rdfs:label xml:lang="en">HPE 0x0462 printed item 1</rdfs:label>
