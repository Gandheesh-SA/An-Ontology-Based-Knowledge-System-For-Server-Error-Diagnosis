    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intel Optane PMem for HPE Initialization Error - Processor %1 DIMM %2 (SN: %3). There was a communication error with the identified Persistent Memory Module controller. The PMEM may have reduced functionality or may not be available. (Major Code:%4, Minor Code:%5).</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
