  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0027-0x0001/procedure/01/item/003"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check if the server power supply capacity or allocated server power is suitable for the workload. Consider
increasing the power cap and adding power capacity if necessary to prevent the reduced performance.
1.  Check the server power supply capacity in the management processor Web GUI, under Power and
Thermal -&gt; Power, or Chassis Information for servers with chassis controlled power supplies.
2.  Compare with the power consumption in the Power and Thermal -&gt; Power page, or if applicable, the
Power Meter page which provides up to 24 hours of power history.
3.  Increase the configured power cap value. If additional hardware has been added to the server, power
calibration during the next server boot might resolve this issue.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 0x0001 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0033/procedure/01/item/009">
