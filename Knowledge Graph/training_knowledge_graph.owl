  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0319/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system is booting from the recovery BIOS image. The recovery BIOS did not receive a request from iDRAC to update the primary BIOS, and therefore system stopped responding.</diag:messageText>
