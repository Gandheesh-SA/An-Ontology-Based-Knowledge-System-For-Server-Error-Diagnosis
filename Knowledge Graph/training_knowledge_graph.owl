    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0834/procedure/01/item/005"/>
    <rdfs:label xml:lang="en">Cisco F0834 recommendation 1</rdfs:label>
  </rdf:Description>
