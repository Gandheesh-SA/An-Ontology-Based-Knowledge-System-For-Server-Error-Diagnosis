  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR31/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Try importing foreign disks, if any. Check if the enclosure containing the Virtual Disk is disconnected
from the controller. Insert any disks that are reported missing or failed. If the enclosure or disks were
removed intentionally, the preserved cache can be discarded. See storage hardware documentation
for more information on performing these steps.</diag:procedureText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdfs:label xml:lang="en">Dell VDR31 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR31/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0382/procedure/01/item/020">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sanitize/Erase Processor 2 DIMM X —This option is available only when NVDIMM-N Memory Interleaving is disabled. Use this option for adding individual NVDIMM-Ns, or for using an NVDIMM-N again after errors occur. When enabled, all user data in the selected NVDIMM-N is erased on the next reboot. The Sanitize NVDIMM-N scope selections are available only after a sanitize policy is selected.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [2456, 2846); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">20</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">◦</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</diag:nestingLevel>
    <rdfs:label xml:lang="en">HPE 0x0382 printed item 20</rdfs:label>
  </rdf:Description>
