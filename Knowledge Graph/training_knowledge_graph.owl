    <rdfs:comment xml:lang="en">Source action_text character span [0, 90); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the chassis intrusion sensor. For more information, contact your service provider.</diag:itemText>
