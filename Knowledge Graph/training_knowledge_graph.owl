  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR2/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR2/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the physical disk with a larger physical disk, and then restart the copyback operation.</diag:procedureText>
