    <rdfs:label xml:lang="en">Dell PWR8560 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Utilize the Chassis Management Controller/Management Module (CMC/MM) web interface to check available power and I/O Module power requirements. If sufficient power is available, restart the CMC/MM and retry the operation. If sufficient power is not available due to an insufficient number of PSUs, add additional PSU(s) and reinsert the I/O Module.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
