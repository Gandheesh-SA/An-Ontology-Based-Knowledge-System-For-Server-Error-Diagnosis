    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8505/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Restart the Chassis Management Controller and retry the operation. To restart the Chassis Management Controller, using the WEB UI, go to Chassis Overview &gt; Power &gt; Control, select the Reset CMC option, and then click Apply.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nff2e1ea015614135ab56d5e55dc73486">
