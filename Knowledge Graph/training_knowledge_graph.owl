    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The storage controller is not receiving a consistent response from the enclosure due to a firmware problem or an incorrect cabling configuration. If the cables are longer than the specified maximum length, the signals may be degraded.</diag:causeText>
