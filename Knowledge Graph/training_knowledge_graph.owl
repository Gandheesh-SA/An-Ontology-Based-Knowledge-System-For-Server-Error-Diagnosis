    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0746/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enable the Lifecycle Controller and retry the operation. To enable Lifecycle Controller, restart the
server. During server startup, press F2 to enter System Setup. Go to iDRAC Settings -&gt; Lifecycle
Controller, select Enable, and save the changes.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0746/procedure/01/item/001"/>
  </rdf:Description>
