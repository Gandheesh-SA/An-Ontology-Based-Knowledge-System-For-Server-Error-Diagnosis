  <rdf:Description rdf:nodeID="Nc9497d6f2cdf4545a7c7a1905a9c9ef9">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Check the physical connections of all devices in the fabric including SAS IOM, SAS IOM ports, storage modules and disk drives.</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SIOM0060"/>
