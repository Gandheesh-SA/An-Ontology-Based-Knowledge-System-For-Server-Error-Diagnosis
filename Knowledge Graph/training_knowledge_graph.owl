  <rdf:Description rdf:nodeID="N4457938150c843c79cd7ed284936cb93">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0026/procedure/01"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0026"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0026/procedure/01/item/012"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Click Temperatures, and then verify the temperature readings for each location on the Temperatures tab. If a hot spot is located, check the airflow path for blockage by cables and other material. A hot spot is not an absolute temperature but is relative to a component specification. Hot spot is defined as temperature on a sensor within 3°C of a Caution threshold listed on the Temperature tab.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0448/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">Dell UEFI0448 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIOS cannot initialize the server to fully homogeneously interleave CXL memory together because the CXL hardware is incorrectly configured or has issues. The CXL memory is now operating in a mixed homogeneous interleave mode and may no longer be operating at optimal performance and capacity.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N056b3594f30347c38c19d50d15a0f112">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0198"/>
