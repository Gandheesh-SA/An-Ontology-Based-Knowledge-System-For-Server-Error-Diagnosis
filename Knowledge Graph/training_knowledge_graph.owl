  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-270/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-270/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-270/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-270/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-270/procedure/01/item/002"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Remove and then reapply power to the server.
2.  If the issue persists, update the iLO firmware.
For more information, see the iLO user guide on the Hewlett Packard Enterprise website (https://
www.hpe.com/support/ilo-docs).
3.  If the issue persists, open a support case using the Hewlett Packard Enterprise Support Center
website (https://www.hpe.com/support/hpesc).</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 270 recommendation 1</rdfs:label>
  </rdf:Description>
