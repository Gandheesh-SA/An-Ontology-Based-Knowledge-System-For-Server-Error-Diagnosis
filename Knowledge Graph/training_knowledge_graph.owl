    <rdfs:label xml:lang="en">Dell SDPM7108: SDPM7108</rdfs:label>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SDPM7108/procedure/01"/>
