    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upgrade iDRAC to the same version as the other sleds in the chassis. For information about upgrading iDRAC, see the iDRAC Users Guide available on the support site.</diag:itemText>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2217/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell PWR2217 printed item 1</rdfs:label>
  </rdf:Description>
