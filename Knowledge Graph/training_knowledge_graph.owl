    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs for one of the following reasons: • The fabric interconnect cannot communicate with a chassis. For a cluster configuration, this fault means that neither fabric interconnect can communicate with the chassis. • The chassis has an invalid FRU.</diag:causeText>
    <rdfs:label xml:lang="en">Cisco F0456 possible cause 1</rdfs:label>
  </rdf:Description>
