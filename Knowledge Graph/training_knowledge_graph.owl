  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR372/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR372/procedure/01/item/001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR372/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the controller supports the unmap feature and the controller unmap state is enabled.
To make sure, run the following RACADM command at the Command Line Interface (CLI): "racadm
storage get controllers -o -p UnmapSupport,UnmapState".</diag:procedureText>
    <rdfs:label xml:lang="en">Dell STOR372 recommendation 1</rdfs:label>
  </rdf:Description>
