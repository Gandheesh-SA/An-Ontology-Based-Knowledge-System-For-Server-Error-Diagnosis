    <rdfs:label xml:lang="en">Dell STOR0101 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check if the server has power, RAID controller is available, and that a RAID controller is connected to the system.</diag:itemText>
