    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-IOV1007</diag:recordId>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
