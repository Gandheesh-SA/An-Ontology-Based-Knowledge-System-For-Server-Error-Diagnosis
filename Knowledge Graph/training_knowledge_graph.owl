  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1764/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The cache module has been detached.
•  The cache module has been replaced.
•  The cache module RAM allocation was unsuccessful.
•  The HPE Smart Storage Battery is not fully charged.
•  Automatic Data Recovery has not yet completed.
•  The HPE Smart Storage Battery is disconnected.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 1764 possible cause 1</rdfs:label>
  </rdf:Description>
