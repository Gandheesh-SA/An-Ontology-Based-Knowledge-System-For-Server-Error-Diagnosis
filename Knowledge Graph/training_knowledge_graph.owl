  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1636/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x1636 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The TPM failed.
•  The TPM is not configured properly in UEFI System Utilities.
•  The boot mode is not configured for the TPM installed on the server.
•  Chipset-TPM is disabled in UEFI System Utilities. This might happen if defaults are loaded.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
