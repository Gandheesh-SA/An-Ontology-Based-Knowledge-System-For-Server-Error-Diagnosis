    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to use the Extended Power Performance (EPP) feature because the power rating of power supply unit (PSU) slot - arg1 is less than 3000W.</diag:messageText>
  </rdf:Description>
