    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2840</diag:sourcePage>
