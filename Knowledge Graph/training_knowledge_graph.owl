  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01">
    <rdfs:label xml:lang="en">HPE 3012 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3012/procedure/01/item/004"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do not attempt any configuration changes to the Virtual Connect Domain. Recommended corrective
actions:
•  Physically remove and reseat Ethernet module that was indicated as Failed.
If the module continues to be in a Failed state, replace this module.
•  If hardware replacement does not correct the issue:
1.  Export a support package from VC for Hewlett Packard Enterprise analysis.
2.  Capture the output of the OA show all command for Hewlett Packard Enterprise analysis.
3.  Contact Hewlett Packard Enterprise customer support with the previously gathered information.</diag:procedureText>
  </rdf:Description>
