    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-AMP0320/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review system power policy, check system logs for power related failures, and review system
configuration changes.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239/procedure/01/item/001">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0239 printed item 1</rdfs:label>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239/procedure/01/cause"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure the memory configuration includes only a single DIMM type. Consult the User Guide for more information on supported configurations. Check all the installed DIMM and ensure they are of the same type. LRDIMMs and RDIMMs or UDIMMs cannot be mixed in the same system. Reinstall the DIMMs using only the same type and reboot the system. For DIMM population, see the Population rules for HPE DDR4 memory with HPE ProLiant and Synergy Gen10 servers (http://www.hpe.com/docs/memory-population-rules) CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations (http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).</diag:itemText>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 770); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
  </rdf:Description>
