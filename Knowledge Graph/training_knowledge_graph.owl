    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">23</diag:sourcePage>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0184/procedure/01"/>
