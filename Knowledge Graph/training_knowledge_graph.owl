  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2295/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2295/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install a power supply unit (PSU) that has a similar airflow direction. For information about PSUs of
supported airflow directions, see the product documentation available on the support site.</diag:procedureText>
