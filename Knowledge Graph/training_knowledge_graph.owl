  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x0054/procedure/01/item/002">
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [104, 509); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press the Power On/Standby button to be sure it is on. If the server has a Power On/Standby button that returns to its original position after being pressed, be sure you press the switch firmly. For more information about system power LED status, see the System Power LED definitions section in the Troubleshooting Guide for HPE ProLiant Gen10 servers at http://www.hpe.com/info/Gen10- troubleshooting.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">HPE 0x0054 printed item 2</rdfs:label>
  </rdf:Description>
