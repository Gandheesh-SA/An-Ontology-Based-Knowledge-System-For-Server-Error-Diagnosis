  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqsvmsg-dll-1038">
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/PCIe%20and%20I%2FO"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Memory"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Processor"/>
