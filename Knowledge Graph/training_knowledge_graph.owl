    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Extended Power Performance (EPP) feature cannot be enabled because PSU in the slot identified in the message is not a 3000 W PSU.</diag:causeText>
  </rdf:Description>
