  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-GMGR0087/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the latest iDRAC firmware version on the server and retry the operation. To update iDRAC by using iDRAC GUI, click (Maintenance &gt; System Update &gt; Manual Update). By using RACADM, run the following at the Command Line Interface (CLI): "racadm update".</diag:itemText>
    <rdfs:label xml:lang="en">Dell GMGR0087 printed item 1</rdfs:label>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 257); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
