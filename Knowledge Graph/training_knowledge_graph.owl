  <rdf:Description rdf:nodeID="N682617c091884b9eab5e9a4842b498d5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-drive-is-smaller-in-size-than-the-drive-it-is-replacing-e3d7a7c97d"/>
