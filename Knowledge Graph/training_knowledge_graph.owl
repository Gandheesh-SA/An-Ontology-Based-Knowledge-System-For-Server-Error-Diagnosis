  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1626/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1626/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1626/procedure/01/item/002"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Remove the power supply.
For more information, see the server maintenance and service guide on the Hewlett Packard
Enterprise website.
2.  Install a supported power supply.
For more information, see the server user guide on the Hewlett Packard Enterprise website.
To locate a supported option, review the product QuickSpecs on the Hewlett Packard Enterprise
website.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <rdfs:label xml:lang="en">HPE 1626 recommendation 1</rdfs:label>
