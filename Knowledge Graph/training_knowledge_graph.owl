    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F0411</diag:eventCode>
    <rdfs:label xml:lang="en">Cisco F0411: fltEquipmentChassisThermalThresholdNonRecoverable</rdfs:label>
  </rdf:Description>
