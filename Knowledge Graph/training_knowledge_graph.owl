  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Cache-module-This-controller-has-been-set-up-to-be-a-part-of-a-redundant-pair-of-controllers-5445f4fc6c/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cache module: This controller has been set up to be a part of a redundant pair of controllers but the cache module cache sizes are different on the two controllers. Make certain that both controllers are using cache modules with the same amount of cache memory installed.</diag:messageText>
