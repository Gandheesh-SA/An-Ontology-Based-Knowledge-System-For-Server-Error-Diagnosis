  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-373/procedure/02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">HPE 373 recommendation 2</rdfs:label>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-373/procedure/02/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To begin using the smaller interleaved set, sanitize all NVDIMMs on the processor.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-LCS2002/procedure/01">
    <rdfs:label xml:lang="en">Dell LCS2002 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-LCS2002/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If leak sensor disconnection is not expected, locate the rack and inspect the specific sensor indicated
in the message. Ensure the cable is connected fully and properly. For more information see the
Installation and Service Manual (ISM) specific to the device model available on the support site.</diag:procedureText>
  </rdf:Description>
