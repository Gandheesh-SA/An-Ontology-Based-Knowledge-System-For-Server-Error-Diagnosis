    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 1</diag:procedureLabel>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Failed-Array-Controller-code-lockup-Code-Restart-the-server-and-run-a-diagnostic-report-e3722c8c07/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR104/message/01">
    <rdfs:label xml:lang="en">Dell PDR104 message 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "PCIe solid state device name", "name": "arg1"}]</diag:messageArguments>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The arg1 has turned off because the critical temperature threshold is exceeded.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0152/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell DIAG0152 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the drive cables and connections. If error persists, make sure that drive firmware and BIOS are
current. The &lt;80000000000000??&gt; value is an EFI error code returned by the driver.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0152/procedure/01/item/001"/>
  </rdf:Description>
