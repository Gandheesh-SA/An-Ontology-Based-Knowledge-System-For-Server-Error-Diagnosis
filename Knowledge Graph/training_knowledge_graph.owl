    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The console update discovery process was unable to complete. The service failed to check for available updates, download the update bundle, or stage it for installation. Common root causes include network connectivity problems to the update source, proxy misconfiguration, insufficient disk space on the appliance, or an unreachable update repository.</diag:explanation>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUPD4102</diag:eventCode>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <rdfs:label xml:lang="en">Dell CUPD4102: CUPD4102</rdfs:label>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD4102/message/01"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CUPD4102</diag:eventName>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CUPD4102/procedure/01/cause"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-CUPD4102</diag:recordId>
  </rdf:Description>
