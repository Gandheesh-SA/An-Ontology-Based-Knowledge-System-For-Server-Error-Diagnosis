  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3120/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3120/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3120/procedure/01/item/002"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3120/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x3120 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consult the Integrated Management Log (IML) for additional information as to the cause of the error. If the
issue persists, confirm the system firmware is current, including the System Programmable Logic Device and
system ROM.
Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more
information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an
accompanying server support guide that lists the supported servers and components available for each
of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are
available on the SPP Information Library (http://www.hpe.com/info/spp/documentation).
To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide
and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses
Smart Update Manager (SUM) to deploy firmware and system software components.
To update the firmware on HPE Synergy products, see the HPE Synergy Firmware Update Overview at
http://www.hpe.com/info/synergy-docs.
Verify the power supply is working. Replace if needed.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to the:
Customer Self Repair website.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Create a support case at: http://www.hpe.com/support/hpesc.
HPE Support will contact you.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0024/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC0024/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the network cable connection and network configuration settings, then retry the operation. If
the problem persists, reconfigure the network settings and retry the operation.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:label xml:lang="en">Dell SWC0024 recommendation 1</rdfs:label>
  </rdf:Description>
