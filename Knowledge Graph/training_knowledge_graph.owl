    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">satellite-connection-absent</diag:causeCategory>
