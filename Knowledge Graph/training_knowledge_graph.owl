    <rdfs:label xml:lang="en">Dell THRM0027 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the issue persists, do the following: 1) Locate the rack. 2) Locate the fan controller identified in the
message. 3) Inspect the fan controller as described in the Installation and Service Manual (ISM) of the
Integrated Rack model on the support site.</diag:procedureText>
  </rdf:Description>
