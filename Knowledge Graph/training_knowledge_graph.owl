  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/007"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/008"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1795/procedure/01/item/006"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Save data.
2.  Move the controller back to the original storage configuration.
3.  Power up the server and allow the controller to flush the cache.
4.  Optional: If the cached data does not need to be saved, discard the data by pressing F9 during boot to
access System Utilities.
a.  Click System Health View &gt; System Health.
b.  Select the controller, and then click Health Status: Configuration Required.
c.  Under Logical Drives Operations, click Repair.
d.  Erase data held in Write-back cache.</diag:procedureText>
