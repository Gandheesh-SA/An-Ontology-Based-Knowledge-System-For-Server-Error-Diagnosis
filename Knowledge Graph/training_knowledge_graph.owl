    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A critical diagnostic event occurred in the memory device at location identified in the message. The memory device has detected an error during startup that either cannot be recovered or has been moved from another server, which has resulted in a unusable configuration data.</diag:explanation>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0046/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0046/procedure/01/item/001"/>
