    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F0776</diag:recordId>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltStorageLocalDiskSlotEpUnusable</diag:eventName>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs when the server disk drive is in a slot that is not supported by the storage controller.</diag:explanation>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F0776</diag:eventCode>
    <rdfs:label xml:lang="en">Cisco F0776: fltStorageLocalDiskSlotEpUnusable</rdfs:label>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0776/procedure/01"/>
