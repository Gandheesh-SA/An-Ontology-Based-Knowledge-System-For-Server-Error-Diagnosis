    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Press the F1 key to continue with the logical drives disabled.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0210/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A POST message displays: Unsupported DIMM configuration detected - Installed DIMMs could not support the currently configured interleave mode. (Major Code:%1, Minor Code:%2).</diag:messageText>
