  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR200/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The watchdog timer expired at arg1.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell ASR200 message 1</rdfs:label>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "day month date hh:mm:ss yyyy", "name": "arg1"}]</diag:messageArguments>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1756/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1756/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1756/procedure/01/item/002"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. It is recommended that operator should delete the extra Virtual Interfaces(VIF) than are there in the FI.
System may appear to be normally functioning even with these extra VIFs in place. However there may
be performance issues observed as the system is operating above the recommended scale limits..
2. If the above actions did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Cisco F1756 recommendation 1</rdfs:label>
  </rdf:Description>
