    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x1945 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAID fault tolerance is degraded due to one of the following:
•  The drive has failed.
•  The drive is missing.
•  The drive capacity is incorrect.
•  The drive type is incorrect.
•  The SAS cable is missing.
•  The volume is rebuilding.</diag:causeText>
  </rdf:Description>
