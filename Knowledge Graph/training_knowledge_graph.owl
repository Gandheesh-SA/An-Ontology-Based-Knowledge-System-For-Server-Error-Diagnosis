  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC46/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An error has occurred in the enclosure or backplane arg1 because of a component count mismatch, which has resulted in the degraded state of enclosure or backplane.</diag:messageText>
    <rdfs:label xml:lang="en">Dell ENC46 message 1</rdfs:label>
