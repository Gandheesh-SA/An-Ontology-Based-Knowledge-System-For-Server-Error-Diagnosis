  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BIOS044/procedure/01/item/001">
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BIOS044/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell BIOS044 printed item 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 194); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the BIOS.Setup.1-1:SecureBootPolicy is set to Custom and then retry the operation. For information about SecureBootPolicy, see the Redfish API Guide available on the support site.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
