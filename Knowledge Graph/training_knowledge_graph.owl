  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR0103">
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-ASR0103</diag:recordId>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">31</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">30</diag:sourcePage>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASR0103</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The operating system or an application failed to communicate within the timeout period. The system was powered down. (IPMI sensor type code 23h offset - 02h event 3:0 - 4h).</diag:explanation>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Monitoring"/>
    <rdfs:label xml:lang="en">Dell ASR0103: ASR0103</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASR0103</diag:eventName>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR0103/message/01"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CRITICAL</diag:severity>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR0103/procedure/01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVTP0002/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the slot number of the MX7116n Fabric Expander Module and the slot number of the
Network IOM are the same like (A or B) [1]----(A or B) [1] and (A or B) [2]----(A or B) [2]. Mezz cards
can be different either A or B but slot number should be same.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
