    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2108/procedure/01/item/003"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2108/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x2108 recommendation 1</rdfs:label>
  </rdf:Description>
