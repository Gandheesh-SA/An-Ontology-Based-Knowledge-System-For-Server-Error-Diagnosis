  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-is-operating-without-a-memory-board-and-has-an-invalid-p-d1d0081253/message/01">
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-is-operating-without-a-memory-board-and-has-an-invalid-p-d1d0081253 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controller State: The array controller is operating without a memory board and has an invalid physical drive connection. Any configuration command (e.g. logical drive creation, array expansion, etc.) or modification to the controller will result in the loss of all existing data on the disabled volume(s).</diag:messageText>
