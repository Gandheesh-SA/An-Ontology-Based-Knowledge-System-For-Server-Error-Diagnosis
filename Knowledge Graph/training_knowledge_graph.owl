    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the Compute Module. For more information about replacing the Compute Module, see the
Installation and Service Manual (ISM) or other technical documentation available on the support site.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne026582ad4824fd5aa188dc1673f6967">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
