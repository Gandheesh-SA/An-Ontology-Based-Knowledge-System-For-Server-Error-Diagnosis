  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-3102/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 3102 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Because a pause flood is detected on an Ethernet port, it has been disabled to avoid further service degradation. Possible cause: Bad NIC on the server. If too many pause frames are detected on a port, then the port is disabled with this state.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SUP0559/procedure/01/item/002">
