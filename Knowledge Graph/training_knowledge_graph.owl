  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1792/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1792/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1792/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">Cisco F1792 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. Wait a few minutes to see if the fault clears. This is typically a temporary issue, and can occur after a
firmware upgrade.
2. If the above action did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1792/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0421/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 186); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the subsystem address is valid and retry the operation. Click System Setup &gt; Network Settings &gt; NVME-oF Device Settings, and then edit the subsystem address, if necessary.</diag:itemText>
    <rdfs:label xml:lang="en">Dell UEFI0421 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
