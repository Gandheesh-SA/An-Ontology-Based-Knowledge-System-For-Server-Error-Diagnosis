    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1) Rerun the command. 2) Reset iDRAC and rerun the command.</diag:procedureText>
