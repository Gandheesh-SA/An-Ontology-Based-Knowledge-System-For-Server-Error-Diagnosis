    <rdfs:label xml:lang="en">HPE 0x0551 printed item 6</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b.</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect each power cord from the server</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">6</diag:itemOrder>
