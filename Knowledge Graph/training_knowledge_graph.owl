  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0005-0x0016/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the temperatures of the system. Check fans, processor heat sink, and air baffles installation.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0005-0x0016/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 0x0016 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0005-0x0016/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC8627/procedure/01/item/001">
    <rdfs:label xml:lang="en">Dell SWC8627 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)</diag:sourceLabel>
    <rdfs:comment xml:lang="en">Source action_text character span [2, 393); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset iDRAC by using the graphical user interface (GUI): Click Chassis Overview &gt; Troubleshooting &gt; Reset Components. In the Reset Server section, from the Reset drop-down menu, select iDRAC Reset corresponding to the server iDRAC to be reset, and then click Apply Selection. Or, reset iDRAC by running the following command at the command line interface (CLI): racadm racreset -m server-n.</diag:itemText>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC8627/procedure/01/cause"/>
  </rdf:Description>
