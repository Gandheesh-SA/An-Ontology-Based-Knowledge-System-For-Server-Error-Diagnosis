  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-The-SmartSSD-Wear-Gauge-log-is-full-3bc2d718eb/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-The-SmartSSD-Wear-Gauge-log-is-full-3bc2d718eb/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-The-SmartSSD-Wear-Gauge-log-is-full-3bc2d718eb recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The drive statistics, health status, wear details, power-on hours, etc. are still available via industry standard,
non-HPE specific, drive logs and accessible by using the embedded Operating System (OS) tools and
third-party tools that are able to pull the data from the industry standard logs. Only drives well past three
years of operational time (equivalent to 26,280 power-on hours) will report a log-full message. Otherwise,
the drives will continue to operate normally and should not, and do not need to be replaced for this issue.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-The-SmartSSD-Wear-Gauge-log-is-full-3bc2d718eb/procedure/01/item/001"/>
  </rdf:Description>
