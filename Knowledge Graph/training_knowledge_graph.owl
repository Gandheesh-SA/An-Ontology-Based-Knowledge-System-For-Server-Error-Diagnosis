    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Check the CXL memory configuration and ensure that it complies with the
configurations in the Installation and Service Manual for your model. 2) Check for CXL event
messages that may indicate hardware issues and follow the recommended actions for those messages.</diag:procedureText>
