  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01/item/004"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: On the Enclosure page: 1. Check if the host system is powered on. 2. Check if the
storage enclosure is powered on. 3. Ensure that the adapter cables are properly connected and there
is no damage. 4) iDRAC may provide limited support to enclosures that are attached to the storage
controller. On the Physical Disks page, perform the tasks that are recommended for the Enclosure
page. Note that in case of physical devices, iDRAC may provide limited support to physical devices
attached to the storage controller.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0504/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell RAC0504 recommendation 1</rdfs:label>
  </rdf:Description>
