    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2083/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">Cisco F2083 recommendation 1</rdfs:label>
  </rdf:Description>
