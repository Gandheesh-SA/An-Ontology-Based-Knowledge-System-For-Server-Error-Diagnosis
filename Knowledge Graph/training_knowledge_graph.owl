  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0268/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0268/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0268 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restore the desired configuration settings in UEFI System Utilities.
For more information, see the UEFI System Utilities user guide for your product on the Hewlett Packard
Enterprise website (http://www.hpe.com/info/uefi/docs).
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Status.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0268/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0268/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0268/procedure/01/item/001"/>
  </rdf:Description>
