  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0136">
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0136/procedure/01"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1888</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1887</diag:sourcePage>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System BIOS detected an failure with the programmable interval timer during POST. This exception occurred early in system power on, thus the system may not display video. (BIOS POST Exception code 88).</diag:explanation>
