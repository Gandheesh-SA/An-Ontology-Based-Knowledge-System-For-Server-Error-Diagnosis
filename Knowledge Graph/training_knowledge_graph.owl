    <rdfs:label xml:lang="en">Dell HWC9056 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure that all the GPUs installed on the server are of same model.</diag:procedureText>
  </rdf:Description>
