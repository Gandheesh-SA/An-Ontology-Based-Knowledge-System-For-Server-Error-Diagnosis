  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-306/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Power down and remove all power from the server.
For more information, see the server user guide on the Hewlett Packard Enterprise website.
2.  If the issue persists, update the iLO firmware.
For more information, see the iLO user guide on the Hewlett Packard Enterprise website.
3.  If the issue persists, contact Hewlett Packard Enterprise support.
For more information, see "Accessing Hewlett Packard Enterprise support."</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-306/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-306/procedure/01/item/003"/>
