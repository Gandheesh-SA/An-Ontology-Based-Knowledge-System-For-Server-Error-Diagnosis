  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Possible causes include:
•  A cable is not installed correctly.
•  The drive is not installed correctly.
•  The drive is setup as Unconfigured Bad
•  The drive is not supported by the backplane, controller, or RAID config.
•  The drive has failed.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x1911 possible cause 1</rdfs:label>
  </rdf:Description>
