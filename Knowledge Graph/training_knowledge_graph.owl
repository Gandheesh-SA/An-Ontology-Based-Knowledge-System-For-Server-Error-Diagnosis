    <rdfs:label xml:lang="en">Dell SWU8543: SWU8543</rdfs:label>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SWU8543</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware update operation of CMC was not successful. The Image file was not accessible.</diag:explanation>
