  <rdf:Description rdf:nodeID="Nbd5f6c9a5ef444b5b98865fb6e4fd496">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Make sure the physical drive used for copy-back operation is "Unmap-capable for VD configuration", and then retry the operation. To check if the drive is unmap-capable, run the following command at the Command Line Interface (CLI): "racadm storage get pdisks -o -p UnmapCapabilityForVDConfig".</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR375/procedure/01/item/001"/>
