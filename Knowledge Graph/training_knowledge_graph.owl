    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1832-Slot X One or more physical drives are not exposed to the host due to presence of logical unit metadata. Action: Run HPE SSA to manage these drives.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0080/procedure/01">
    <rdfs:label xml:lang="en">Dell PST0080 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
