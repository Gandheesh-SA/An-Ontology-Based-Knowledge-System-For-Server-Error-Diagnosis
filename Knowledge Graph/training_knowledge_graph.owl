  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU100/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The power supply unit identified in the message is offline, because of the one of the following reasons: 1) The power supply unit is not correctly seated. 2) The power cable may not be connected properly or disconnected. 3) The power supply unit has failed. 4) There is an input power failure.</diag:causeText>
    <rdfs:label xml:lang="en">Dell PSU100 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SDK0006/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell SDK0006 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The plugin identified in the message was not started because the plugin version is not compatible with the runningmanagement controllerversion.</diag:causeText>
  </rdf:Description>
