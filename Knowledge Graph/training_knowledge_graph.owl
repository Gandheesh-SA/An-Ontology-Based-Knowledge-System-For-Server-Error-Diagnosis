    <rdfs:label xml:lang="en">HPE 0x0383 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NVDIMM Error: Proc %1, DIMM %2 is configured for Sub-NUMA Clustering but system is NOT configured for Sub-NUMA Clustering. All NVDIMMs on Proc %3 are disabled.</diag:messageText>
  </rdf:Description>
