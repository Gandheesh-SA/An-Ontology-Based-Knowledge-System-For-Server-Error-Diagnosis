    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PR39/procedure/01"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Enable the security feature on the replaced card using any of the iDRAC interfaces. To enable by using iDRAC GUI, click Actions &gt; Edit &gt; Security option in Storage &gt; Controllers. To enable by using CLI, run the following RACADM command: racadm storage setencryptionmode: -mode SEKM. For more information, see the latest version of the iDRAC Users Guide available on the support site.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
  </rdf:Description>
