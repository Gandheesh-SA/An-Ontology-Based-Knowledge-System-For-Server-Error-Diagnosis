  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0376/procedure/01/item/016">
    <rdfs:comment xml:lang="en">Source action_text character span [2163, 2510); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">HPE 0x0376 printed item 16</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the component is either under warranty or contract. Go to https://support.hpe.com/hpesc/public/home, and then click Warranty Status. This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For specific information about customer replaceable parts, refer to the product maintenance and service guide.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">16</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0410/procedure/01/item/010">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">10</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [628, 1030); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x0410 printed item 10</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open SUM and add the baseline that includes the Smart Array driver. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http://www.hpe.com/info/hpsum/ documentation. Smart Update Tool (SUT): Note: To use SUT, you must have HPE OneView downloaded and installed. For more information, see the HPE OneView documentation at http://www.hpe.com/info/ovvcenter/docs.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FLDC1024/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Add another PCIe SSD device to the Fluid Cache Pool to resolve the issue.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FLDC1024/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
