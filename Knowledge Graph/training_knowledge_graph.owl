    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell PWR2265 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The power supply unit (PSU) arg1 is disabled because of a configuration mismatch and therefore the PSU is not supported on the server.</diag:messageText>
