  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PR39/procedure/01">
    <rdfs:label xml:lang="en">Dell PR39 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enable the security feature on the replaced card using any of the iDRAC interfaces. To enable by using
iDRAC GUI, click Actions &gt; Edit &gt; Security option in Storage &gt; Controllers. To enable by using CLI,
run the following RACADM command: racadm storage setencryptionmode: -mode SEKM. For more
information, see the latest version of the iDRAC Users Guide available on the support site.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PR39/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
