  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0137/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The CSIOR (Collect System Inventory on Restart) operation cannot be executed because the Lifecycle Controller (LC) firmware was not accessible. This issue is caused by missing LC files.</diag:causeText>
