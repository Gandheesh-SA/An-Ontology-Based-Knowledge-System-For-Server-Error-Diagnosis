    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0371/procedure/01/cause"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">24</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [3176, 3424); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
  </rdf:Description>
