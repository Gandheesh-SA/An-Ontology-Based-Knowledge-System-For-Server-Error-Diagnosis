  <rdf:Description rdf:nodeID="N760ddc8b5109478387472e35eb5d6d53">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#similarTo"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0276"/>
