    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM117/procedure/01/item/004"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM117/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell SEKM117 recommendation 1</rdfs:label>
  </rdf:Description>
