    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that there is at least one Double Data Rate (DDR) type DIMM installed in the CPU socket.
For more information about DIMM population, see the respective Installation and Service Manual.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell UEFI0400 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0400/procedure/01/item/001"/>
  </rdf:Description>
