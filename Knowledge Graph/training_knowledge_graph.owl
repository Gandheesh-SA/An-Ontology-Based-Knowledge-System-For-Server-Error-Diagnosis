    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The HTTP Boot certificate for the BIOS boot device cannot be imported because one or more of the following reasons: 1) The input file is either corrupted, invalid, or cannot be detected. 2) Insufficient space in the certificate store. 3) Unknown internal issues.</diag:causeText>
  </rdf:Description>
