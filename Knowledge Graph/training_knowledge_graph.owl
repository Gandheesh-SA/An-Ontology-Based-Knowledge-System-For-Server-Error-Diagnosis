  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU0035/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An over voltage fault detected on power supply arg1.</diag:messageText>
