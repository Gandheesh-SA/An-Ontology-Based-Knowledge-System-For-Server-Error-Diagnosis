  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2294">
    <rdfs:label xml:lang="en">Dell PWR2294: PWR2294</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Network%20Adapter%20and%20Link"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/PCIe%20and%20I%2FO"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2294/procedure/01/cause"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PWR2294</diag:eventCode>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2294/procedure/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1992</diag:sourcePage>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2294/message/01"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The OCP NIC information cannot be read because management module is unable to verify the power requirements of the OCP NIC. This can be because either the OCP NICs FRU data or because the FRU data is unavailable.</diag:explanation>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-PWR2294</diag:recordId>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PWR2294</diag:eventName>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0107/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
