    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Invalid firmware image</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0421/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0421/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0421/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell UEFI0421 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the subsystem address is valid and retry the operation. Click System Setup &gt; Network
Settings &gt; NVME-oF Device Settings, and then edit the subsystem address, if necessary.</diag:procedureText>
  </rdf:Description>
