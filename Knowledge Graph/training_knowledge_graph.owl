  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-377/procedure/01">
    <rdfs:label xml:lang="en">HPE 377 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-377/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enable NVDIMM-N Memory Interleaving, and then reboot the server.
If all the other NVDIMMs in the interleaved set are still installed, the data on the NVDIMM will be available
after rebooting.
If any of the other NVDIMMs in the interleaved set are missing, a different error message might occur.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-377/procedure/01/cause"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 1</diag:procedureLabel>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
  </rdf:Description>
