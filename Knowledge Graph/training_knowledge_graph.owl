  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-drive-is-smaller-in-size-than-the-drive-it-is-replacing-e3d7a7c97d/procedure/01">
