  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-drive-contains-unsupported-configuration-data-9651c6a912/procedure/01">
