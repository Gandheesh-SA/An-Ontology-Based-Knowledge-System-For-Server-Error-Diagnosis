    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermal-problem</diag:causeCategory>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault is raised when the IO controller temperature is outside the upper or lower critical threshold.</diag:explanation>
