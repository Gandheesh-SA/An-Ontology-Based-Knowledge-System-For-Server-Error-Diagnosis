  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2171">
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Service Profile is currently configured to use "Legacy" boot mode. Legacy BIOS boot mode is considered insecure because it lacks modern firmware-level security verification. Switching to UEFI boot mode with Boot Security enabled allows the system to perform cryptographic verification of the boot process, protecting against boot-level malware and rootkits.</diag:explanation>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2171/procedure/01/cause"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2171/message/01"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">460</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">459</diag:sourcePage>
    <rdfs:label xml:lang="en">Cisco F2171: fltLsbootPolicyLsbootPolicyWarning</rdfs:label>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">insecure-boot-mode</diag:causeCategory>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
