    <rdfs:label xml:lang="en">Dell UEFI0278 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to complete the Post Package Repair (PPR) operation because of an issue in the DIMM memory slot arg1.</diag:messageText>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "slot number", "name": "arg1"}]</diag:messageArguments>
  </rdf:Description>
