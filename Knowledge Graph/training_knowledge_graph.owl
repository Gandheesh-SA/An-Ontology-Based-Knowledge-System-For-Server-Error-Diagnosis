    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqsvmsg-dll-1172/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the power enclosure and power supplies. Replace any failed or degraded power supplies.
Add additional power supplies if needed.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 1172 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-The-enclosure-is-reporting-a-high-temperature-status-6a263e88c2/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
