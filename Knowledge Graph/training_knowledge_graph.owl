    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0375/procedure/01/item/021"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0375/procedure/01"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Remove the DIMM. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the DIMM handling guidelines on the Hewlett Packard Enterprise Library at: http://www.hpe.com/info/enterprise/docs</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mixed DIMM types have been detected in the system and cannot be configured by the system. All memory
on the socket has been disabled.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x0239 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5707c91db8a04fb08c360c0a2999858b">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0566/procedure/01/item/001"/>
