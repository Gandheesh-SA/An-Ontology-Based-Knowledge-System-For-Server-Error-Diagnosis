    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0334/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restore the default manufacturing settings in RBSU:
1.  From the System Utilities screen, select System Configuration &gt; BIOS/Platform Configuration
(RBSU) &gt; System Default Options &gt; Restore Default Manufacturing Settings, and then press
Enter.
2.  Select Yes, restore the default settings.
3.  Reboot the server.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0334/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x0334 recommendation 1</rdfs:label>
  </rdf:Description>
