    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell SYS115 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The power cord sensor becomes non-functional because of one of the following reasons: 1) The power cable may not be connected properly or disconnected. 2) The power cord sensor in the power supply unit has failed. However, the power supply unit may still function. 3) There is an input power failure.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0573/procedure/01/item/005">
    <rdfs:label xml:lang="en">HPE 0x0573 printed item 5</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the DIMM. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the DIMM handling guidelines on the Hewlett Packard Enterprise Library at: http://www.hpe.com/info/enterprise/docs</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">5</diag:itemOrder>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0573/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Source action_text character span [334, 582); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED145/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED145/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell RED145 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the recommended CPLD is installed on the server and retry the operation. For
information about compatible CPLD versions, see the iDRAC or Open Server Manager (OSM) Users
Guide available on the support site.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED145/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-362/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 362 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The DRAM running average power limit wattage value is incorrect or invalid.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/004">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that the correct fan is installed, if the system supports both standard fans and performance fans. For additional information, see the system documentation. If this issue persists, create an HPE Support Case.</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [277, 495); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: ESCALATION_OR_SUPPORT. Warranty/support administration is not a cause-specific diagnosis or corrective operation.</rdfs:comment>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</diag:itemOrder>
    <rdfs:label xml:lang="en">HPE 0x0016 printed item 4</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR315/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell STOR315 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR315/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR315/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the Virtual Disk has a single span and retry the reconfiguration operation. For
information about the RAID levels that have a single span, see the Lifecycle Controller Users Guide
available at the support site.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-2016/procedure/01/item/005">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [463, 515); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
