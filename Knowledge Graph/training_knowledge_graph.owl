    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Create a support case at: http://www.hpe.com/support/hpesc. HPE Support will contact you.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
