    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x001E/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x001E"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x001E/procedure/01"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Install supported Smart Storage Energy Pack and ensure energy pack cable is well seated. Confirm energy pack status in the iLO GUI. See the HPE Smart Storage Battery issues for Smart Array controllers section in the Troubleshooting Guide for HPE ProLiant Gen10 servers guide at http://www.hpe.com/info/enterprise/docs. See the iLO 5 documentation for information on confirming the energy pack status. If this issue persists, create an HPE Support Case.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0034-0x0002/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0034-0x0002/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0034-0x0002/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0034-0x0002/procedure/01/cause"/>
