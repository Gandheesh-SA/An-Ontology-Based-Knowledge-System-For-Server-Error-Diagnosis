    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check/install Riser 1 or check MCIO cable is installed properly.</diag:itemText>
    <rdfs:label xml:lang="en">Cisco F2100 printed item 1</rdfs:label>
