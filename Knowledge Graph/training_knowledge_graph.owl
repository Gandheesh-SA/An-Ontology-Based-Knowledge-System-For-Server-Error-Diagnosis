    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the fans and be sure the air flows over the drive.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
