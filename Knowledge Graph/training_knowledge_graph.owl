    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware package being used to update the physical disk drive is not valid for the drive model identified in the message. The firmware package contains the drive component id in the list of supported drives, but the firmware image is not valid for the drive model identified in the message.</diag:explanation>
