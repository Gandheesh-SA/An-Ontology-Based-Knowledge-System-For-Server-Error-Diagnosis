  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the Chassis internal fans are functioning. At the command line interface (CLI), enter
the following command to identify fans that are not functioning: "racadm getsel". Using the CMC Web
GUI, select the chassis, click the Logs tab, and then select Hardware Log. Reinsert or replace fans
that are not functioning correctly.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503/procedure/01/cause"/>
    <rdfs:label xml:lang="en">Dell FAN8503 recommendation 1</rdfs:label>
  </rdf:Description>
