  <rdf:Description rdf:nodeID="Ncf24dc3a8edd4c2eac1b429ae46c45c1">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PR39"/>
