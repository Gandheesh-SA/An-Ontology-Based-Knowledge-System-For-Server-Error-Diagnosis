  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1293">
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:similarTo rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1283"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This trap is sent any time a physical adapter in a logical adapter group changes to the Failed condition, but at least one physical adapter remains in the OK condition. This can be caused by loss of link due to a cable being removed from the adapter or the Hub or Switch. Internal adapter, Hub, or Switch failures can also cause this condition.</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1293/message/01"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqnimsg.dll</diag:eventNamespace>
    <rdfs:label xml:lang="en">HPE 1293: Redundancy has been reduced by the NIC in slot %1, port %2. Number of functional NICs in the team: %3.</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ERROR</diag:severity>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1293</diag:eventCode>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqnimsg-dll-1293</diag:recordId>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Network%20Adapter%20and%20Link"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1293/procedure/01/cause"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">584</diag:sourcePage>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqnimsg-dll-1293/procedure/01"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Redundancy has been reduced by the NIC in slot %1, port %2. Number of functional NICs in the team: %3.</diag:eventName>
  </rdf:Description>
