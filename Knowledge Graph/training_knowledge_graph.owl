    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The data in the Persistent Memory DIMM located in the memory slot identified in the message is not accessible because the DIMM is locked and the passphrase is incorrect. Update the Persistent Memory Passphrase to the correct passphrase, or perform a Secure Erase on the DIMM. Secure erase will erase all persistent data.</diag:causeText>
  </rdf:Description>
