    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clear the Update Task Queue and recreate the Firmware Update tasks that had previously failed.</diag:procedureText>
