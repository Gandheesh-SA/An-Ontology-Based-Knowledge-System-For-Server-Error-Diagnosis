    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Fibre Channel Controller in slot %4 has a new status of %5.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-BIOS-8565/procedure/01">
