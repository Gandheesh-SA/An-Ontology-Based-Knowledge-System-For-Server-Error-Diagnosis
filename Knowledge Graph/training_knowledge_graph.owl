    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 1788 printed item 3</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the issue persists, run HPE SSA. For more information, see the HPE Smart Storage Administrator User Guide on the Hewlett Packard Enterprise website (https://www.hpe.com/info/smartstorage-docs).</diag:itemText>
