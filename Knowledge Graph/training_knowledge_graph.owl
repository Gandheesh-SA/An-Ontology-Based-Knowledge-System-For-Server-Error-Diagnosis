    <rdfs:label xml:lang="en">HPE 1064: Drive Array Physical Drive Status Change.</rdfs:label>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1064/message/01"/>
