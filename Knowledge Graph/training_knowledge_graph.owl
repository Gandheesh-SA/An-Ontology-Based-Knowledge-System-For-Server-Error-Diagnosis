  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0037-0x0271/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Failure is caused as at least one option card is unable to be authenticated using SPDM, either because it
lacks support or because authentication failed.</diag:causeText>
