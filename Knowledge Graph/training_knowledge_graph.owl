    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Match the energy pack to the number of loads. For more information, see the QuickSpecs on the Hewlett Packard Enterprise website (http://www.hpe.com/ info/qs). If this issue persists, create an HPE Support Case.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
