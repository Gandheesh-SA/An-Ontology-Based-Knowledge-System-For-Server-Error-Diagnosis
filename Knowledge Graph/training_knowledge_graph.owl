  <rdf:Description rdf:nodeID="Nd9130d46600c4e91a1c4bd5af2c18219">
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/System%20board"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0147/procedure/01"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: This typically is a user error since these drives can be disconnected from the system. If disconnected, reconnect the optical drive to system board. Check BIOS setup to make sure the SATA port the drive is connected and has not been disabled. Rerun the diagnostic. If errors persist the optical drive is defective.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0147/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0147"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
