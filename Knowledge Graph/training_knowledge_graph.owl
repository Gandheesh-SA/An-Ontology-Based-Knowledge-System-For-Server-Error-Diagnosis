  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV124/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV124/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the adapter or update the Chassis Infrastructure firmware and then retry the operation.
Using Chassis Management Controller (CMC) RACADM, run the command "racadm fwupdate -g -u -a
&lt;TFTP server IP Address&gt; -d mainboard.bin -m main_board" to upload the latest firmware version to
the Chassis Infrastructure Mainboard.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell IOV124 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV124/procedure/01/cause"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
