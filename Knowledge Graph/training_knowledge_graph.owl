  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3159/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intel Optane PMem for HPE Configuration Error - Intel Optane PMem for HPE Processor %1, DIMM %2 (SN: %3) was configured in interleaving mode. This PMEM is disabled because the order of population of interleaved PMEMs is incorrect. This PMEM was populated in Processor %4, DIMM %5 when the interleaving configuration was successfully applied.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 0x3159 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0005-0x0003/message/01">
