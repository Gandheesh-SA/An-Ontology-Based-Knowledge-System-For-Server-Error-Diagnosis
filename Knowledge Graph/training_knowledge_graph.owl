    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 78); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">Dell SWU8528 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reacquire the Image file from the source folder, and then retry the operation.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0398/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The HTTPS certificate number of the HTTP device identified in the message cannot be synced with iDRAC because either the iDRAC or BIOS version on the system is not up-to-date.</diag:causeText>
    <rdfs:label xml:lang="en">Dell UEFI0398 possible cause 1</rdfs:label>
  </rdf:Description>
