  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0398/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refer NVDIMM population guidelines and install NVDIMM in a slot having backup power.
For DIMM population, see the Population rules for HPE DDR4 memory with HPE ProLiant and Synergy
Gen10 servers (http://www.hpe.com/docs/memory-population-rules)
CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system
board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations
(http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0398/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0398/procedure/01/cause"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <rdfs:label xml:lang="en">HPE 0x0398 recommendation 1</rdfs:label>
  </rdf:Description>
