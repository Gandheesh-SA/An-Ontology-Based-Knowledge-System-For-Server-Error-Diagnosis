    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware version of the Heater Manager Subsystem was not upgraded because of internal communication errors.</diag:explanation>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
