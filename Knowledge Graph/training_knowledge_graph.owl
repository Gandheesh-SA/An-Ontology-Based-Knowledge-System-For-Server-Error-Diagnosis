  <rdf:Description rdf:nodeID="N06f9dac57ae243769126f0710d162b65">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Make sure that the Chassis internal fans are functioning. At the command line interface (CLI), enter the following command to identify fans that are not functioning: "racadm getsel". Using the CMC Web GUI, select the chassis, click the Logs tab, and then select Hardware Log. Reinsert or replace fans that are not functioning correctly.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN8503/procedure/01"/>
  </rdf:Description>
