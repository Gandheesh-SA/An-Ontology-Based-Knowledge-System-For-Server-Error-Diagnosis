    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cannot enable the Enhanced Cooling Mode because an unsupported fan is inserted in the Chassis.</diag:messageText>
    <rdfs:label xml:lang="en">Dell FAN903 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0005-0x0010/message/01">
    <rdfs:label xml:lang="en">HPE 0x0010 message 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Processor %1 Core VRD %2 is HOT (Temp %3C)</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x002F/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x002F possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The server blade is not properly installed in the enclosure.
•  The server blade is not configured to automatically power on.
•  The power being supplied is not sufficient for the server blades installed in the enclosure.
•  The power cap is not configured properly for the enclosure.
•  The OA module is not properly installed in the enclosure.
•  A possible communication failure between the management processor and the OA is causing the
server blade to wait for permission to power on.
•  The server blade has a mismatched fabric installed on the mezzanine 1 connector or the mezzanine2
connector.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1819/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x1819 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Encryption failure : Unsupported system ROM detected.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0135/procedure/01">
    <rdfs:label xml:lang="en">Dell PST0135 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0135/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove and reapply input power. If the issue persists, Collect a SupportAssist collection (TSR)
report using iDRAC. Visit https://www.dell.com/support/incidents-online/contactus/dynamic to use
the Virtual Assistant to analyze the collection and recommend a resolution.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1266/procedure/01">
    <rdfs:label xml:lang="en">Dell RAC1266 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1266/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run the command racadm update -f to update the BIOS to the latest version, and retry the operation.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001B/message/01">
