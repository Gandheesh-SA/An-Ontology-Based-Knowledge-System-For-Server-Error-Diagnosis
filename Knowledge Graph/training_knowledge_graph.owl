  <rdf:Description rdf:nodeID="N4e09dc224e0e4ce1a6f8a4575d52044e">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31BC/procedure/01"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Update the firmware for the PCIe boot controller. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs.</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31BC"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x31BC/procedure/01/item/001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
  </rdf:Description>
