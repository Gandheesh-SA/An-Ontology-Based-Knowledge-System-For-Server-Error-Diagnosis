  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1229/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [53, 354); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">Cisco F1229 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is recommended that operator should delete the extra primary vlans than are there in the FI. System may appear to be normally functioning even with these extra primary vlans in place. However there may be performance issues observed as the system is operating above the recommended scale limits..</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1727/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The controller has detected an additional array of drives that was connected when the power was off.
The logical drive configuration information has been updated to add the new logical drives. The maximum
number of logical drives supported is 64. Additional logical drives cannot be added to the configuration.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 1727 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01/item/004"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Install the microSD card that came with the device.
2.  If the issue persists, replace the HPE Dual microSD device.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Status.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 0x0321 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0321/procedure/01/cause"/>
  </rdf:Description>
