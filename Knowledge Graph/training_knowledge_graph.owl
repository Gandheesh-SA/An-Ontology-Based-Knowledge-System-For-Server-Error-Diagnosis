  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0143/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TXT boot failed. This could be related to memory errors or an error with the system TXT configuration. A socketed TPM module may have been removed. This exception occurred early in system power on, thus the system may not display video.</diag:causeText>
    <rdfs:label xml:lang="en">Dell PST0143 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
