    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6497887109b84cc59e53845b7457ba63">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Use iLO to check the HPE Smart Storage Battery charge. Verify that the battery charge is sufficient to enable caching.</rdfs:comment>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
