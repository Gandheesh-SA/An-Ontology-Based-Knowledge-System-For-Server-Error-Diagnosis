  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1718/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Source action_text character span [28, 305); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
