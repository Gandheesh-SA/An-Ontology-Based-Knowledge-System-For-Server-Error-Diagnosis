    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 1076 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The %6 %7 storage system connected to SCSI bus %5 of the controller in slot %4 has a failed temperature status. Shut down the storage system as soon as possible.</diag:messageText>
  </rdf:Description>
