  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controller State: The array controller has an unsupported configuration. You may reconfigure the controller, but the existing configuration and data will be overwritten and potentially lost.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0214/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0214/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0214/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0214/procedure/01/item/003"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1) Review system logs for power supply exceptions.2) Reseat hard disks in the bay. Reconnect
all cables attached to the bay.3) If the issue persists, Collect a SupportAssist collection (TSR)
report using iDRAC. Visit https://www.dell.com/support/incidents-online/contactus/dynamic to use
the Virtual Assistant to analyze the collection and recommend a resolution.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell VLT0214 recommendation 1</rdfs:label>
  </rdf:Description>
