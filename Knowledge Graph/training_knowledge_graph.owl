  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM038/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Source action_text character span [0, 288); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disable the key management security feature, Secure Enterprise Key Manager (SEKM), or iDRAC Local Key Management (iLKM) by running the following RACADM command at the Command Line Interface (CLI), and then retry the operation: For SEKM: racadm sekm disable. For iLKM: racadm iLKM disable.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
