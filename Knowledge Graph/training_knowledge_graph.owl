    <rdfs:label xml:lang="en">Dell RAC1011 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change the iDRAC NIC mode to shared mode using "racadm set idrac.nic.selection &lt;value&gt;", and retry the operation.</diag:itemText>
