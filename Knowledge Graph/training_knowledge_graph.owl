    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fan may be faulty, check for obstructions to the fan and vents. Make sure that BIOS is current and retry the diagnostics.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
