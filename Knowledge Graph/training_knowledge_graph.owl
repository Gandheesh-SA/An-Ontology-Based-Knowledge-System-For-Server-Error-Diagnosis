    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Controller in slot arg1 is unable to complete the Firmware Online Activation operation because one of the firmware components require an offline activation.</diag:messageText>
  </rdf:Description>
