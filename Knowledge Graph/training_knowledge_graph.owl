  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1810/procedure/01/item/003">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the issue persists, update the iLO, Smart Array, and System ROM to the latest versions. To update the firmware on HPE ProLiant servers, see Keeping the system current in the Troubleshooting Guide for HPE ProLiant Gen10 servers at http://www.hpe.com/info/Gen10- troubleshooting. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x1810 printed item 3</rdfs:label>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. Shared component alone does not justify this corrective operation for the source cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [189, 627); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
  </rdf:Description>
