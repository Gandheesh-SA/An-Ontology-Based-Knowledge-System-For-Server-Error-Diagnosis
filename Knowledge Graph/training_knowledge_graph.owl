    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5014/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the BIOS on the server to latest version.</diag:procedureText>
  </rdf:Description>
