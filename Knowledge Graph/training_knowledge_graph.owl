    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/007"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/008"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/item/006"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1911/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Be sure no loose connections exist. For more information, see the Resolving loose connections
section in the Troubleshooting Guide for HPE ProLiant Gen10 servers at http://www.hpe.com/info/
Gen10-troubleshooting.
2.  Be sure the drive or backplane is cabled properly.
3.  Be sure the drive data cable is working by replacing it with a known functional cable.
4.  Be sure drive blanks are installed properly when the server is operating. Drives may overheat and
cause sluggish response or drive failure.
5.  Set drive to Unconfigured Good.
6.  Verify backplane, controller, RAID config, and drive compatibility.
7.  Power cycle the server. If the drive shows up, check to see if the drive firmware needs to be updated.
If this issue persists, create an HPE Support Case to replace the defective drive.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Check Status under the Warranty Check
heading.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 0x1911 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0224/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <rdfs:label xml:lang="en">Dell VLT0224 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0224/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0224/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VLT0224/procedure/01/item/003"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1) Review system logs for power supply exceptions.2) Reseat the memory module.3) If the issue
persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/
support/incidents-online/contactus/dynamic to use the Virtual Assistant to analyze the collection and
recommend a resolution.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
