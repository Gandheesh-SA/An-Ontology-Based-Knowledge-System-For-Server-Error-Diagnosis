  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CTL123/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">Dell CTL123 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to update the RAID controller arg1 firmware version because the memory chip on which the firmware image is saved in is of an unknown type.</diag:messageText>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "RAID controller", "name": "arg1"}]</diag:messageArguments>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1811/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">HPE 1811 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1811-Slot X Encryption Failure-Drive Keys not retrieved from the Remote Key Manager. Dependent encrypted logical drives are offline. System may not boot.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne8ac6280939849eebe2b76139b61cc2b">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1814/procedure/01"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Run SUT from the command line (On-Demand mode) to update the Smart Array firmware. For more information, see to the HP SUT documents at http://www.hpe.com/info/sut-docs. Service Pack for ProLiant (SPP): Update the Smart Array firmware by downloading the SPP from the Hewlett Packard Enterprise website (http://www.hpe.com/servers/spp). Refer to the SPP documentation at http://www.hpe.com/info/spp/ documentation for instructions on updating the firmware. Note: Downloading an SPP requires a contract with Hewlett Packard Enterprise and an HPE Passport ID. If you do not have an HPE Passport ID, go to http://www.hpe.com/info/insightonline. Note: Downloading the entire SPP can take a significant amount of time. Online Flash components This component provides updated system firmware that can be installed directly on supported operating systems. Additionally, when used in conjunction with the SUM, this Smart Component allows you to update firmware on remote servers from a central location. This remote deployment capability eliminates the need for you to be physically present at the server to perform a firmware update. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http:// www.hpe.com/info/hpsum/documentation.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1814"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1814/procedure/01/item/013"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0451/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compute Express Link (CXL) hardware is not responding via the in-band management interface.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell UEFI0451 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-380/procedure/02">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-380/procedure/02/item/001"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sanitize all NVDIMMs on the processor. The data on the NVDIMM will not be available after sanitization.
For more information, see the HPE 16GB NVDIMM User Guide on the Hewlett Packard Enterprise website
(https://www.hpe.com/info/NVDIMM-docs).</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 380 recommendation 2</rdfs:label>
  </rdf:Description>
