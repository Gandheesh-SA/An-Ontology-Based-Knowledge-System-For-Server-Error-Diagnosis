  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0101/procedure/01/item/014">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [1264, 1978); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x0101 printed item 14</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">14</diag:itemOrder>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0101/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run SUT from the command line (On-Demand mode) to update the Smart Array firmware. For more information, see to the HP SUT documents at http://www.hpe.com/info/sut-docs. Service Pack for ProLiant (SPP): Update the Smart Array firmware by downloading the SPP from the Hewlett Packard Enterprise website (http://www.hpe.com/servers/spp). Refer to the SPP documentation at http://www.hpe.com/info/spp/ documentation for instructions on updating the firmware. Note: Downloading an SPP requires a contract with Hewlett Packard Enterprise and an HPE Passport ID. If you do not have an HPE Passport ID, go to http://www.hpe.com/info/insightonline. Note: Downloading the entire SPP can take a significant amount of time.</diag:itemText>
  </rdf:Description>
