  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1285/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs for the following reasons: when Auto Firmware Sync Policy is set Auto-acknowledge or User-acknowledge and default host firmware pack is not having any server versions set. • Auto Firmware Sync is not happening. • Default host firmware package has blade or rack versions empty.</diag:causeText>
    <rdfs:label xml:lang="en">Cisco F1285 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
