    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enter a valid BIOS System password or BIOS Setup password and retry the operation. The system will stop responding after three unsuccessful login attempts.</diag:itemText>
    <rdfs:label xml:lang="en">Dell UEFI0439 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
