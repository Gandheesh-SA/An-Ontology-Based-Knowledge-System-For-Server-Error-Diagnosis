  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-IOV106/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell IOV106 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Chassis Management Controller (CMC) is unable to power on adapter. Possible reasons for power failures are: 1) Adapter not an approved adapter. 2) Adapter not fully inserted in the slot 3) Auxiliary power cable not connected (applicable to slot 1 - 3 only). 4) Adapter is damaged.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
