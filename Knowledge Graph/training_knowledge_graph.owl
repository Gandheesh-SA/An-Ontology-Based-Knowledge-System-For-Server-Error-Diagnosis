    <rdfs:comment xml:lang="en">Source action_text character span [707, 1084); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x1934 printed item 6</rdfs:label>
  </rdf:Description>
