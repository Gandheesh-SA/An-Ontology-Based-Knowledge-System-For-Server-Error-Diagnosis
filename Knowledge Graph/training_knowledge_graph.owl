  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-269/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">269-IMPORTANT: Default configuration settings have been restored per user request. If Secure Boot was enabled, related security settings may have been lost. Action: Restore any desired configuration settings.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 269 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Cache-module-The-cache-is-disabled-because-there-are-no-capacitors-attached-to-the-cache-modul-5fc2ad2c8e/procedure/01/cause">
