  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0151/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SMART Predictive Failure indicates the hard drive has failed SMART and maybe nearing the end
of its life. Other types of &lt;Error Reason&gt; in this category may indicate an intermittent or firmware
problem, rerun the test again. Desktops, servers: Check the hard disk drive cables and connections.
All systems: If error persists, make sure that hard disk drive firmware and BIOS are current. The
&lt;80000000000000??&gt; value is an EFI error code returned by the driver.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:label xml:lang="en">Dell DIAG0151 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0151/procedure/01/item/001"/>
  </rdf:Description>
