  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1922/procedure/01/item/001">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If release notes indicate that support for additional devices has been added, upgrade to the latest version of controller firmware. Update to the latest firmware version. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</diag:nestingLevel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1922/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Source action_text character span [27, 1114); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x1922 printed item 1</rdfs:label>
  </rdf:Description>
