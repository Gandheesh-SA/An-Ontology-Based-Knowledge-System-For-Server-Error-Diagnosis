  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-346/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">346-NVDIMM Error – Arming Error - Processor X, DIMM Y. NVDIMM could not be armed and future backups are not possible. Action: Save NVDIMM contents to other media to preserve data and then replace the NVDIMM.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 346 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N83f509d166a34e3aab7f758a62f09868">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Review and correct the rack level PSU redundancy settings, as incorrect configuration may trigger this alert. Replace PSUs if failures or power input issues are confirmed.</rdfs:comment>
