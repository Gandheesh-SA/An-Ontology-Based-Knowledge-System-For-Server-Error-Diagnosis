  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0309/procedure/01/item/001">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 88); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">Dell UEFI0309 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connect the Baseboard UPI B cable. For more information, see the platform Owners Manual.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc5729c5714c2468dbdba79ec49259d8a">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC6/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC6"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Check for problems with the cables. See the Cables attached correctly section for more information on checking the cables. You should also check to see if the enclosure has degraded or failed components. To do this, select the enclosure object in the tree view and click the Health subtab. The Health subtab displays the status of the enclosure components. Verify that the controller has the supported driver and firmware versions installed and that each Enclosure Management Modules (EMMs) are running the same version of supported firmware.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC6/procedure/01"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR015/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell STOR015 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A new virtual disk cannot be created because the maximum number of virtual disks are already created.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0045/procedure/01/item/001">
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0045/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install a TPM chip module by following the installation procedure. If the issue persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/support/incidents- online/contactus/dynamic to use the Virtual Assistant to analyze the collection and recommend a resolution.</diag:itemText>
    <rdfs:label xml:lang="en">Dell UEFI0045 printed item 1</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 304); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0014-0x0011/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An uncorrectable error detected (Processor: %1, Error Component: 2P CCIX, Link: %2, Overflow: %3)</diag:messageText>
    <rdfs:label xml:lang="en">HPE 0x0011 message 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x2416/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 0x2416 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controller firmware did not initialize or is corrupt.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0586/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While preparing for a recovery RESTful Firmware Update, a communication timeout or other internal error
occurred.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x0586 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED085/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to update the firmware because communication with Chassis Management Controller (CMC) or Management Module (MM) took more time than the specified duration.</diag:messageText>
    <rdfs:label xml:lang="en">Dell RED085 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1213/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the temperature status is degraded or failed, shut down the storage system as soon as
possible. Be sure that the storage system environment is being cooled properly and that no components are
overheated.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1213/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 1213 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0147/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell TMP0147 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The temperature of the component identified in the message is greater than the upper critical threshold temperature. The ambient air temperature is too high, or one or more fans may have failed.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasItem">
    <rdfs:comment xml:lang="en">Owns a printed item occurrence with exactly one procedure owner; identical wording in another procedure is a separate occurrence. Any cascade deletion is an application policy.</rdfs:comment>
    <diag:relationshipCategory>Composition</diag:relationshipCategory>
    <rdfs:label xml:lang="en">hasItem</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
