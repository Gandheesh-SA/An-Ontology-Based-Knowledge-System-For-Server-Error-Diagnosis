  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0490/procedure/01/item/009">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use iLO or an optional IML viewer to access the IML to see if any event list error messages relating to fans are listed. For more information about event list error messages, see Troubleshooting resources at http://www.hpe.com/info/gen10-troubleshooting.</diag:itemText>
