  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0293">
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-UEFI0293</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DDR memory initialization of the Dual In-line Memory Modules (DIMMs) installed in the system cannot be completed because the DIMMs are installed in an unsupported, asymmetrical configuration between the Integrated Memory Controllers (iMCs).</diag:explanation>
