    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs when a fabric interconnect reports one of the following connectivity states for a virtual interface: • Down • Errored • Unavailable</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0283/message/01"/>
