  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC8509/procedure/01">
    <rdfs:label xml:lang="en">Dell HWC8509 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC8509/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immediately turn off the Chassis by pressing the Chassis power button or removing chassis input
power. The Chassis can be turned off remotely by running the following RACADM command "racadm
chassisaction -m chassis nongraceshutdown". After turning off, Collect a SupportAssist collection
(TSR) report using iDRAC. Visit https://www.dell.com/support/incidents-online/contactus/dynamic
to use the Virtual Assistant to analyze the collection and recommend a resolution.</diag:procedureText>
  </rdf:Description>
