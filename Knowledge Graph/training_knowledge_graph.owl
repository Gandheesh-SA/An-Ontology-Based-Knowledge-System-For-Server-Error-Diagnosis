    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2852</diag:sourcePage>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RDHX0012/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immediate attention is needed if the current mode of eRDHx is not intentionally set. In this mode,
eRDHx is no longer cooling the rack. All systems in the rack must be in power off state. This mode is
intended for maintenance purpose only.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RDHX0012/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell RDHX0012 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0188">
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
