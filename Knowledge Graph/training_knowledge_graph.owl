  <rdf:Description rdf:nodeID="Ne4a0b968d37a49a0b1c56a86699ede23">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670/procedure/01"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Reset the server and resolve the pinned cache issue to complete the firmware activation process. To reset the server, on the iDRAC GUI, click Configuration &gt; Power Management &gt; Power Control &gt; Power Cycle System (cold boot). Else, run the RACADM command at the Command Line Interface (CLI): racadm serveraction powercycle. For more information, see the Controller Users Guide available on the support site.</rdfs:comment>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
  </rdf:Description>
