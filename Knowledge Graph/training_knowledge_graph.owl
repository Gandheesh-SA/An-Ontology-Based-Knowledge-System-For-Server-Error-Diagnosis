    <rdfs:label xml:lang="en">Dell SEC0100 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The arg1 in slot arg2 is open.</diag:messageText>
  </rdf:Description>
