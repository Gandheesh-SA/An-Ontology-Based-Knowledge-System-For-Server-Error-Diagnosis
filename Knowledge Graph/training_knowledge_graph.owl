  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0356">
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0356/procedure/01/cause"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-UEFI0356</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The data in the Persistent Memory DIMM located in the memory slot identified in the message is not accessible because the DIMM is locked and the passphrase is incorrect. Update the Persistent Memory Passphrase to the correct passphrase, or perform a Secure Erase on the DIMM. Secure erase will erase all persistent data.</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0356</diag:eventName>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3638</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3639</diag:sourcePage>
