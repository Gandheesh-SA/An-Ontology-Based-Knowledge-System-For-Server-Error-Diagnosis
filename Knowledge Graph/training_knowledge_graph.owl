  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0175/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quad Rank and Octal Rank DIMM modules cannot be mixed on a channel. Populate memory modules in
a supported configuration. For more information, see the platform Owners Manual.</diag:procedureText>
