  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0202/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0202/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0202/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0202/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Remove input power to the system, 2) Reseat the DIMM module and 3) Restart
the system. If the issue persists, then replace the faulty memory module identified in the message.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <rdfs:label xml:lang="en">Dell UEFI0202 recommendation 1</rdfs:label>
  </rdf:Description>
