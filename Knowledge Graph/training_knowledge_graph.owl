    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use vendor utilities that support the storage controllers. For more information about supported vendor utilities, see the vendors website.</diag:itemText>
