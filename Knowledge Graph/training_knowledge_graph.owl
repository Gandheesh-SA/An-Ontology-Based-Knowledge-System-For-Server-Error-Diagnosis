  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2003/procedure/01/item/007">
    <rdfs:label xml:lang="en">Cisco F2003 printed item 7</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [608, 954); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">7</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Cisco UCS power capping capability to limit power usage. Power capping can limit the power consumption of the system, including blade and rack servers, to a threshold that is less than or equal to the system's maximum rated power. Power-capping can have an impact on heat dissipation and help to lower the installation site temperature.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0241/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0241/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0241/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0241/procedure/01/item/003"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Remove input power to the system, 2) Reseat the memory riser and 3) Restart
the system. For more information, see the platform Owners Manual.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell UEFI0241 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BIOS022/procedure/01/item/001">
    <rdfs:label xml:lang="en">Dell BIOS022 printed item 1</rdfs:label>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BIOS022/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 83); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change the jumper setting on the system board to enable changing the BIOS password.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3119/procedure/01/item/009">
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3119/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Source action_text character span [832, 1100); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove the Persistent Memory Module. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the DIMM handling guidelines on the Hewlett Packard Enterprise Library at: http://www.hpe.com/info/enterprise/docs</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">9</diag:itemOrder>
    <rdfs:label xml:lang="en">HPE 0x3119 printed item 9</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8607/procedure/01/item/002">
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CMC8607/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell CMC8607 printed item 2</rdfs:label>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2)</diag:sourceLabel>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [396, 877); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset Chassis Management Controller (CMC) by using the GUI: Click Chassis Overview &gt; Troubleshooting &gt; Reset Components, and then click Reset/Failover CMC. Or, reset CMC by running the following command at the CLI: racadm racreset. For more information about the syntax and parameters used, see the iDRAC 8/7 v2.30.30.30 RACADM CLI Guide and the Chassis Management Controller Version 5.0 for Dell PowerEdge M1000e RACADM Command Line Reference Guide available on the support site.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR1116/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "number", "name": "arg1"}]</diag:messageArguments>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drive arg1 is removed.</diag:messageText>
    <rdfs:label xml:lang="en">Dell PDR1116 message 1</rdfs:label>
  </rdf:Description>
