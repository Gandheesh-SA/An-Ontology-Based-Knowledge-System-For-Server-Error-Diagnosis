    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">14</diag:itemOrder>
    <rdfs:label xml:lang="en">HPE 0x0028 printed item 14</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be sure all fan slots have fans or blanks installed. For airflow requirements, see the server documentation.</diag:itemText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0028/procedure/01/cause"/>
  </rdf:Description>
