  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1173">
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1173/procedure/01"/>
    <rdfs:label xml:lang="en">HPE 1173: Fibre Channel Tape Controller Status Change.</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibre Channel Tape Controller Status Change. This trap indicates that the agent has detected a change in the status of a Fiber Channel Tape Controller. The variable cpqFcTapeCntlrStatus indicates the current tape controller status. The variable cpqFcTapeCntlrWWN indicates the unique tape controller world wide name associated with this controller.</diag:explanation>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Monitoring"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqstmsg.dll</diag:eventNamespace>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqstmsg-dll-1173</diag:recordId>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Fibre%20Channel%20adapter"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">471</diag:sourcePage>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1173/message/01"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1173</diag:eventCode>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibre Channel Tape Controller Status Change.</diag:eventName>
  </rdf:Description>
