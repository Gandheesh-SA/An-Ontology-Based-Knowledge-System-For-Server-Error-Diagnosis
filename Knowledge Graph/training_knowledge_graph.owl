  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/item/002"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1769/procedure/01/cause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do one of the following:
•  Press the F1 key to continue with the logical drives disabled.
•  Press the F2 key to accept the data loss and re-enable the logical drives. Restore data from backup, if
necessary.
Additional actions for specific errors
• Cache Module Removed or Failed; Expansion Progress Data Lost. Verify that the cache module is
seated correctly. Replace if necessary.
• Expansion Aborted due to Unrecoverable Drive Errors. Verify failed disks using HPE SSA and
replace as necessary.
Restore data from backup, if necessary.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 1769 recommendation 1</rdfs:label>
  </rdf:Description>
