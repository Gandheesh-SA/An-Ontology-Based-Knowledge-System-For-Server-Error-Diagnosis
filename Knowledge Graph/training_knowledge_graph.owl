    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">HPE 343 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The Smart Storage battery has not fully recharged in a server with an NVDIMM-N Backup Power Policy
of Continue Boot Without Backup Power.
•  The Smart Storage battery is disconnected, has lost charge, or has failed.
•  The NVDIMM has failed.</diag:causeText>
  </rdf:Description>
