    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the operating system, application, hardware, and system event log for exception events.</diag:procedureText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR0003/procedure/01/item/001"/>
  </rdf:Description>
