  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01/item/004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
