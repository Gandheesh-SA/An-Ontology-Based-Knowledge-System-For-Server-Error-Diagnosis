  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x003F/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install supported Smart Storage Energy Pack and ensure energy pack cable is well seated. Confirm energy pack status in the iLO GUI. See the HPE Smart Storage Battery issues for Smart Array controllers section in the Troubleshooting Guide for HPE ProLiant Gen10 servers guide at http://www.hpe.com/info/enterprise/docs. See the iLO 5 documentation for information on confirming the energy pack status. If this issue persists, create an HPE Support Case.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x003F/procedure/01/cause"/>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x003F/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 453); ACTIONABLE_SOURCE_PREFIX; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x003F printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0335/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0335/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0335/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">HPE 0x0335 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Reset the RESTful API.
2.  If the issue persists, reset the iLO API.
For more information, see Managing Hewlett Packard Enterprise Servers Using the RESTful API.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0335/procedure/01/cause"/>
