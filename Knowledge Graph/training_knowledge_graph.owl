  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-347/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-347/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">HPE 347 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install a maximum of Y NVDIMMs in the system.
– System Halted!
X = Number of NVDIMMs currently installed.
Y= Maximum number of NVDIMMs supported.
Reduce the number of NVDIMMs in the server to Y or fewer.
For more information, see the server user guide on the Hewlett Packard Enterprise website.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
