    <rdfs:comment xml:lang="en">Source action_text character span [0, 94); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">Dell SRV019 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wait until the server completes POST and the OS startup process, and then retry the operation.</diag:itemText>
