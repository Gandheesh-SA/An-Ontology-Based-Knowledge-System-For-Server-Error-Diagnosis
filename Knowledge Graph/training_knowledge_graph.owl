    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0162/message/01"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0162/procedure/01"/>
