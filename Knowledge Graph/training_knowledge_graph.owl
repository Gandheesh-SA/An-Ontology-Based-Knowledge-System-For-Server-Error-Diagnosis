    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CTL139/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run the following RACADM command at the Command Line Interface (CLI) and retry the operation:
racadm racreset. For more information about RACADM commands of iDRAC, see the latest version of
"iDRAC with Lifecycle Controller RACADM CLI Guide" available on the support site.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell CTL139 recommendation 1</rdfs:label>
  </rdf:Description>
