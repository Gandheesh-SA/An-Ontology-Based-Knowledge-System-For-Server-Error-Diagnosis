    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slot %1 Error - The UEFI driver for the device stopped because the NVM image is newer than expected.</diag:messageText>
