  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0448">
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3677</diag:sourcePage>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIOS cannot initialize the server to fully homogeneously interleave CXL memory together because the CXL hardware is incorrectly configured or has issues. The CXL memory is now operating in a mixed homogeneous interleave mode and may no longer be operating at optimal performance and capacity.</diag:explanation>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
