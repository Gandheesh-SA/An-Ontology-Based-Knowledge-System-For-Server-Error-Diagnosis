    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-247/procedure/01/cause"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove either the 1.25 V or the 1.5 V DIMMs. For more information, see the server maintenance and service guide on the Hewlett Packard Enterprise website.</diag:itemText>
