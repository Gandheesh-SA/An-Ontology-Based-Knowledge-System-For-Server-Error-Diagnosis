  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1926">
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">385</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">386</diag:sourcePage>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltAdaptorUnitUnConnectedAdaptorReachability</diag:eventName>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connectivity-problem</diag:causeCategory>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F1926</diag:eventCode>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F1926</diag:recordId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1926/message/01"/>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1926/procedure/01"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco UCS Manager cannot access the adapter whose connectivity is not discovered. This fault typically occurs as a result of one of the following issues: • The server does not have sufficient power. • The I/O module is not functional. • The adapter firmware has failed. • The adapter is not functional • The adapter is not connected to UCSM</diag:explanation>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <rdfs:label xml:lang="en">Cisco F1926: fltAdaptorUnitUnConnectedAdaptorReachability</rdfs:label>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1926/procedure/01/cause"/>
  </rdf:Description>
