  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1004">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-BAT1004</diag:recordId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">97</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">96</diag:sourcePage>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Battery%20and%20Capacitor"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAT1004</diag:eventCode>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1004/procedure/01"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <rdfs:label xml:lang="en">Dell BAT1004: BAT1004</rdfs:label>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1004/procedure/01/cause"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAT1004</diag:eventName>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Transparent Learn Cycle (TLC) operation of the energy pack on has timed out because of one of the following reasons.1) The controller energy pack must be fully charged before the learn cycle can begin. The energy pack may be unable to maintain a full charge causing the learn cycle to timeout.2) The energy pack must be able to maintain cached data for a specified period of time in the event of a power loss. For example, some energy packs maintain cached data for 24 hours. If the energy pack is unable to maintain cached data for the required period of time, then the Learn cycle will timeout.</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1004/message/01"/>
  </rdf:Description>
