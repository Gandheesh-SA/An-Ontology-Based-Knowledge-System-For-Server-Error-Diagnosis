  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1819/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the system ROM to a version that supports encryption. Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an accompanying server support guide that lists the supported servers and components available for each of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are available on the SPP Information Library (http://www.hpe.com/info/spp/documentation). To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses Smart Update Manager (SUM) to deploy firmware and system software components. To update the firmware on HPE Synergy products, see the Best Practices for HPE Synergy Firmware and Driver Updates at http://www.hpe.com/info/synergy-docs.</diag:itemText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x1819 printed item 1</rdfs:label>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 976); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
