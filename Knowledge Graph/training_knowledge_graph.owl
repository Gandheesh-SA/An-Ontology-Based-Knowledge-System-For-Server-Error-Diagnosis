    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PST0129/procedure/01"/>
    <rdfs:label xml:lang="en">Dell PST0129: PST0129</rdfs:label>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0129</diag:eventCode>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System BIOS detected memory, but was unable to configure the memory for system operation. Compare system memory installation to supported system memory configurations. Reduce the system to minimum memory configuration if acceptable. This exception occurred early in system power on, thus the system may not display video.(BIOS POST Exception Code 81).</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0129</diag:eventName>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-PST0129</diag:recordId>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
  </rdf:Description>
