    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-2016/procedure/01"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Chassis%20and%20Enclosure"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <rdfs:label xml:lang="en">HPE 2016: 2016 - Enclosure Find failed</rdfs:label>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016 - Enclosure Find failed</diag:eventName>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An add, import, or recovery of an enclosure failed while attempting to perform a connection or reconnection with the enclosure. Find operations are caused by a user request to add an enclosure to the domain. Reconnections might be caused by: • VCM reset • VCM failover • Configuration restore • Firmware upgrade • User re-authentication request • Reconnection of an enclosure that was previously in a NO-COMM state</diag:explanation>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual-Connect</diag:eventNamespace>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
  </rdf:Description>
