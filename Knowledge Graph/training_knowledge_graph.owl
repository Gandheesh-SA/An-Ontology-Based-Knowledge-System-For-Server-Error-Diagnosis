    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Battery health data indicates the maximum number of charge cycles has been reached. Replace the battery.</diag:itemText>
    <rdfs:label xml:lang="en">Dell DIAG0134 printed item 1</rdfs:label>
