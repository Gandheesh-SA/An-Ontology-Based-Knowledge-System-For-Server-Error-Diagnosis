  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ASR0001/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check the operating system, application, hardware, and system event log for exception events.</diag:procedureText>
