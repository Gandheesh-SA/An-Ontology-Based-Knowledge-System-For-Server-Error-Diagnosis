    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F1561</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs when the temperature of an FI I/O module has exceeded a non-critical threshold value, but is still below the critical threshold. Be aware of the following possible contributing factors: • Temperature extremes can cause Cisco UCS equipment to operate at reduced efficiency and cause a variety of problems, including early degradation, failure of chips, and failure of equipment. In addition, extreme temperature fluctuations can cause CPUs to become loose in their sockets. • Cisco UCS equipment should operate in an environment that provides an inlet air temperature not colder than 50F (10C) nor hotter than 95F (35C). • If sensors on a CPU reach 179.6F (82C), the system will take that CPU offline.</diag:explanation>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">303</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">302</diag:sourcePage>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINOR</diag:severity>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3160/message/01">
