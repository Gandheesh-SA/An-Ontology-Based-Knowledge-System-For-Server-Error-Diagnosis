  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6021">
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6021/message/01"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">HPE 6021: 6021 - Profile has PXE enabled on a non-primary Flex-10 NIC</rdfs:label>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6021</diag:eventCode>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6021 - Profile has PXE enabled on a non-primary Flex-10 NIC</diag:eventName>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual-Connect</diag:eventNamespace>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Virtual-Connect-6021</diag:recordId>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6021/procedure/01"/>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PXE is enabled on an Ethernet connection in a profile that is mapped to a non-primary physical function on a Flex-10 NIC. The current Flex-10 implementation does not allow PXE booting on any but the first physical function on a Flex-10 NIC port. Possible cause: PXE is enabled on an Ethernet connection that is mapped to the second, third, or fourth physical function on a Flex-10 NIC.</diag:explanation>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Network%20Adapter%20and%20Link"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">601</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">602</diag:sourcePage>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-6021/procedure/01/cause"/>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
  </rdf:Description>
