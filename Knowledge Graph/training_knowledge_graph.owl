    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-275/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-275/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-275/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-275/procedure/01/item/002"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If available, update the System ROM to a version supporting processor stepping.
For more information, see the following topic in the troubleshooting guide for your product on the
Hewlett Packard Enterprise website:
•  HPE ProLiant Gen10—"Keeping the system current" (https://www.hpe.com/info/gen10-
troubleshooting)
•  HPE Synergy—"Updating the firmware" (https://www.hpe.com/info/synergy-troubleshooting)</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-275/procedure/01/cause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <rdfs:label xml:lang="en">HPE 275 recommendation 1</rdfs:label>
  </rdf:Description>
