  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8562/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8562/procedure/01/item/001"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Server may need more time to power on. Wait for ten seconds and check the power status. If the
server was not powered on, retry the operation. If the issue persists, remove and reinsert the server,
wait for the iDRAC to complete startup, and retry the operation.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell PWR8562 recommendation 1</rdfs:label>
  </rdf:Description>
