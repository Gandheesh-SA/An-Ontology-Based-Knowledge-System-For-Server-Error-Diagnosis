  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1204">
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1204/message/01"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accelerator Board Status Change. This trap indicates that the agent has detected a change in the status of an array accelerator cache board. The current status is represented by the variable cpqDaAccelStatus.</diag:explanation>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drive Array Accelerator Status Change.</diag:eventName>
