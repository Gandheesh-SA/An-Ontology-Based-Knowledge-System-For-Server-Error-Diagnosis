    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  A cable is not installed correctly.
•  A drive is not installed correctly or has failed.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 1784 possible cause 1</rdfs:label>
  </rdf:Description>
