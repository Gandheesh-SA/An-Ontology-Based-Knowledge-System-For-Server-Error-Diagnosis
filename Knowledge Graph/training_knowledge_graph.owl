  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0156/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to find the Dell Processor Acceleration Technology (DPAT) Enterprise license in three consecutive boots. The Number of Cores per Processor and the Dell Controlled Turbo BIOS setup options are being reverted to default because of the absent license.</diag:causeText>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">Dell UEFI0156 possible cause 1</rdfs:label>
  </rdf:Description>
