  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Single-ported-drives-are-not-supported-for-configuration-and-should-be-di-210112e744/procedure/01/item/001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Single-ported-drives-are-not-supported-for-configuration-and-should-be-di-210112e744 printed item 1</rdfs:label>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Single-ported-drives-are-not-supported-for-configuration-and-should-be-di-210112e744/procedure/01/cause"/>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Single-ported-drives-are-not-supported-for-configuration-and-should-be-di-210112e744/procedure/01/cause"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the physical drive with a drive supported by the controller. To locate a supported option, review the product QuickSpecs on the Hewlett Packard Enterprise website.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
