    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system had a failed recovery RESTful Firmware Update due to a communication or internal error. The firmware update has been aborted.</diag:messageText>
  </rdf:Description>
