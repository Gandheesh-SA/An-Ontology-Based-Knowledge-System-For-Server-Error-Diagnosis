    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED145/procedure/01"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RED145/procedure/01/cause"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware of the component identified in the message cannot be updated because the required CPLD is currently not installed on the target system.</diag:explanation>
