  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1898">
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs when number of IGMP group count on the fabric interconnect has reached an upper threshold. It gets cleared when the numbers reaches a lower threshold.</diag:explanation>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F1898</diag:eventCode>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
