    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS180/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell SYS180 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While exporting the TTY log, make sure that the server is not in BIOS POST, and then retry
the operation. Use GetRemoteServicesAPIStatus() invoke method and check for output parameter
RTStatus and ensure it shows 0 (ready status) and then retry the operation. If the issue persists,
reset iDRAC, and retry the operation.</diag:procedureText>
  </rdf:Description>
