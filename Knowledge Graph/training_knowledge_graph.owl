  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR703/procedure/01">
    <rdfs:label xml:lang="en">Dell STOR703 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do one of the following and retry the operation: 1) Make sure the NVMe device is in the Ready state
before starting the PrepareToRemove operation. 2) Enter the correct the ForceRemove parameter to
perform the PrepareToRemove operation irrespective of the NVMe device state. To view the drive
state, go to the respective Redfish Oem Drive URI.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR703/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR703/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR703/procedure/01/cause"/>
  </rdf:Description>
