  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5055">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5055</diag:eventCode>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5055 - The server BIOS needs to be updated to at least the version dated</diag:eventName>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5055/message/01"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">606</diag:sourcePage>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Virtual-Connect-5055</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The VC management application has determined that the server BIOS version does not support the minimum capabilities required for Virtual Connect. Possible cause: The server has a down-rev BIOS version.</diag:explanation>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5055/procedure/01"/>
    <rdfs:label xml:lang="en">HPE 5055: 5055 - The server BIOS needs to be updated to at least the version dated</rdfs:label>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5055/procedure/01/cause"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual-Connect</diag:eventNamespace>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
  </rdf:Description>
