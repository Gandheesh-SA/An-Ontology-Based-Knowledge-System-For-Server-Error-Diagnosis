    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Configure the SAS IOM. For information about managing SAS IOM devices, refer to OpenManage Enterprise Modular Version Users Guide available on the support site.</diag:itemText>
    <rdfs:label xml:lang="en">Dell SIOM0047 printed item 1</rdfs:label>
  </rdf:Description>
