  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC44/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The redundant multipath connection to the enclosure identified in the message abruptly disconnected because either the EMM is removed, cable is damaged, the cable is removed, a SAS IOM module is powered off, is damaged or is removed.</diag:causeText>
