    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to allocate legacy I/O resources for one of more PCIe devices because the legacy I/O space limit was reached.</diag:messageText>
  </rdf:Description>
