  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC43/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Enclosure Management Module (EMM) arg1 installed in sled that is available in slot arg2 has failed.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
