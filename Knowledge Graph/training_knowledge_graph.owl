    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0406/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "reading", "name": "arg1"}, {"description": "sensorName", "name": "arg2"}, {"description": "instance", "name": "arg3"}, {"description": "upper_Critical_Temperature", "name": "arg4"}]</diag:messageArguments>
    <rdfs:label xml:lang="en">Dell TMP0406 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The reported temperature of arg1 for the sensor: arg2.arg3, is greater than the upper critical threshold value: arg4.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1743/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1743/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1743/procedure/01/cause"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 1</diag:procedureLabel>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wait for the erase process to complete before using the logical drive.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 1743 recommendation 1</rdfs:label>
  </rdf:Description>
