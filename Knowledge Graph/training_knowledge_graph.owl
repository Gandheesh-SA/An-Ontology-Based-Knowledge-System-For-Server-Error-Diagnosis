  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1285">
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1285/procedure/01"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F1285</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault typically occurs for the following reasons: when Auto Firmware Sync Policy is set Auto-acknowledge or User-acknowledge and default host firmware pack is not having any server versions set. • Auto Firmware Sync is not happening. • Default host firmware package has blade or rack versions empty.</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1285/message/01"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1285/procedure/01/cause"/>
