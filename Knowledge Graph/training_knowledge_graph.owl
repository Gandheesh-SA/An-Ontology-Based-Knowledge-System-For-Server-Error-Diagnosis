    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">6</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify that the replacement drives are the correct drive type and capacity. For more information, see the QuickSpecs on the Hewlett Packard Enterprise website (https:// www.hpe.com/info/qs).</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [544, 736); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
