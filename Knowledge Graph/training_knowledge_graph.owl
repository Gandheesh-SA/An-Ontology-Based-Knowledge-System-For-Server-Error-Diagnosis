    <rdfs:comment xml:lang="en">Source action_text character span [0, 383); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the failing DIMMs and restore the memory configuration to a supported configuration. See the Integrated Management Log (IML) for information regarding the original memory error. Refer also to the HPE documentation for DIMM population guidelines and any warnings in regards to performance. It is recommended you install supported configurations that allow optimum performance.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
