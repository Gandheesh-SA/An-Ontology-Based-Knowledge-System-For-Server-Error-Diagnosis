    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cancel any pending operations on the RAID controller and then retry the operation.</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 82); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:label xml:lang="en">Dell STOR078 printed item 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
