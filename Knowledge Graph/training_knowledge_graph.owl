    <rdfs:label xml:lang="en">Dell SWC0005 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retry the operation. If the problem persists: 1) Turn off the system and disconnect the power cord. 2)
Wait for five seconds. 3) Reconnect the power cord, turn on the system, and retry the operation.</diag:procedureText>
  </rdf:Description>
