  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0350/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0350 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A POST message displays: NVDIMM population error - Processor X, DIMM Y. NVDIMMs and RDIMMs are in the incorrect order on Channel Z. NVDIMMs on the channel should be closest to the CPU.</diag:messageText>
  </rdf:Description>
