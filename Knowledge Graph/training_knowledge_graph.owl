    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the tape library door is open, close the tape library door.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
