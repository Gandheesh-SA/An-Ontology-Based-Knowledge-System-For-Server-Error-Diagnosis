    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Security"/>
    <rdfs:label xml:lang="en">Dell SEKM045: SEKM045</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2619</diag:sourcePage>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM045/procedure/01"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEKM045</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iDRAC cannot secure the device identified in the message because either iDRAC does not support the device type, the device firmware is incompatible, or the device does not use the encryption protocol supported by iDRAC. For example, TCG Opal 2.0 or later using SMBUS. Therefore, iDRAC cannot secure the device.</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM045/message/01"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM045/procedure/01/cause"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
  </rdf:Description>
