  <rdf:Description rdf:nodeID="Ndecae04c8fe64117b8245835bb517b36">
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0216/procedure/01"/>
