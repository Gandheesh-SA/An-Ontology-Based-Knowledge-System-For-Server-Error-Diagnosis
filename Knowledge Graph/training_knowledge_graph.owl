  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC9052/procedure/01/cause">
    <rdfs:label xml:lang="en">Dell HWC9052 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The health of Graphics Processing Unit (GPU) device identified in the message is degraded. There are a few memory pages retired on the device because of a Double Bit Error (DBE) or two consecutive Single Bit Errors (SBEs) on the memory cell. The memory pages are retired to avoid any runtime corruption of data.</diag:causeText>
  </rdf:Description>
