  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8560/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8560/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell PWR8560 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8560/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Utilize the Chassis Management Controller/Management Module (CMC/MM) web interface to check
available power and I/O Module power requirements. If sufficient power is available, restart the
CMC/MM and retry the operation. If sufficient power is not available due to an insufficient number of
PSUs, add additional PSU(s) and reinsert the I/O Module.</diag:procedureText>
  </rdf:Description>
