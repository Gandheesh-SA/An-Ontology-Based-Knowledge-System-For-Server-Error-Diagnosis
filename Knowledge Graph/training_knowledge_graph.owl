    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Dell SYS050 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that the Server Configuration Profile is compliant with the system configuration schema
published on delltechcenter.com/lc in the LC profile Schema Guide. Only RAID controllers can have
nested Component nodes.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS050/procedure/01/item/001"/>
  </rdf:Description>
