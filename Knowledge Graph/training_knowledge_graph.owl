  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS198/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The iDRAC requires an AC power cycle. Do the following: 1) Determine a time that the AC power can
be removed and then reapplied to the server. 2) Save data and perform an AC power cycle.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell SYS198 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS198/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS198/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
