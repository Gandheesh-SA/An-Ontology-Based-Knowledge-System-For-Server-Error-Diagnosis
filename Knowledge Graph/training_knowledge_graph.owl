  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/02">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this message is observed without any drive movement, do the following:
1.  Be sure that the cache module is working.
2.  Replace the cache module, if required.
3.  If the issue persists, contact Hewlett Packard Enterprise support.</diag:procedureText>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
