  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0194/procedure/01/item/003">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restart the system. For more information, see the platform Owners Manual.</diag:itemText>
