    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mezzanine card arg1 arg2 voltage is less than the lower warning threshold.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1723/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Power down the server.
2.  Remove or replace the connector daughter board and external cables connected to the Smart Array
Controller board. For more information, see the server maintenance and service guide on the Hewlett
Packard Enterprise website.</diag:procedureText>
