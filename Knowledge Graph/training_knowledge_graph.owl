    <rdfs:label xml:lang="en">Dell UEFI0316: UEFI0316</rdfs:label>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0316</diag:eventName>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0316/procedure/01"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-UEFI0316</diag:recordId>
