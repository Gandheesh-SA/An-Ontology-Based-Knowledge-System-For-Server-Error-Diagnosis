    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 350 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">350-NVDIMM Population Error – Processor X, DIMM Y. NVDIMMs and RDIMMs are in the incorrect order on Channel Z. NVDIMMs on the channel should be closest to the CPU. Action: Install DIMMs in correct order. – System Halted!</diag:messageText>
  </rdf:Description>
