  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0390/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A CMOS checksum issue is detected. CMOS is reinitialized. This is an expected behavior during the first boot operation after CPU or arg1 replacement.</diag:messageText>
