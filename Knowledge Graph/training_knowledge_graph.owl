  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1715/message/01">
    <rdfs:label xml:lang="en">HPE 1715 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1715-Slot # Drive Array Controller – Memory Error(s) Occurred. Warning: Corrected Memory Error(s) were detected during controller memory self-test. Upgrade to the latest firmware. If the problem persists, replace the Cache Module or controller.</diag:messageText>
