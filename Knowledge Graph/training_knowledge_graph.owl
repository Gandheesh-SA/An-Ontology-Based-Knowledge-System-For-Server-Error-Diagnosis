  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0013-0x0023/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Possible causes include:
•  The Unprotected write back option is enabled without an energy pack present.
•  There are loose cables.
•  The energy pack has failed.
•  The controller firmware is outdated.
•  SSD Caching is enabled and the cache volume has failed.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 0x0023 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
