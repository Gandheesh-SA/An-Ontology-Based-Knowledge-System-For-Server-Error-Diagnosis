    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 516); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0398/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x0398 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refer NVDIMM population guidelines and install NVDIMM in a slot having backup power. For DIMM population, see the Population rules for HPE DDR4 memory with HPE ProLiant and Synergy Gen10 servers (http://www.hpe.com/docs/memory-population-rules) CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations (http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1814/procedure/01/item/002">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdfs:label xml:lang="en">HPE 0x1814 printed item 2</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:comment xml:lang="en">Purpose assessment: PREPARATORY_OR_NAVIGATION. Setup/navigation or power isolation alone is not a cause-specific diagnosis or repair.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [357, 405); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Go to https://www.hpe.com/us/en/support.html.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-313/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•  The HPE Smart Storage battery might lose charge when left shelved for long periods.
•  The HPE Smart Storage battery is degraded or has failed.
•  The iLO firmware is not the latest version.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 313 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1207">
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tape Library Status Change. This trap indicates that the agent has detected a change in the status of a tape library. The variable cpqDaTapeLibraryStatus indicates the current tape library status. The variable cpqDaTapeLibraryScsiTarget indicates the SCSI ID of the tape library.</diag:explanation>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">493</diag:sourcePage>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqstmsg.dll</diag:eventNamespace>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1207</diag:eventCode>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1207/message/01"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Storage"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drive Array Tape Library Status Change.</diag:eventName>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1207/procedure/01"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqstmsg-dll-1207</diag:recordId>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <rdfs:label xml:lang="en">HPE 1207: Drive Array Tape Library Status Change.</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3026/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3026/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3026/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">HPE 0x3026 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3026/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For more information on supported configurations, .see the system user guide located on the Information
Library at http://www.hpe.com/info/enterprise/docs.
If the issue persists, check if there is a newer version of the firmware for the PMEM controller and the system
ROM.
Update to the latest firmware version.
Service Pack for ProLiant (SPP) contains server drivers, systems software, and firmware. For more
information about SPP, see the SPP website (http://www.hpe.com/servers/spp). Each SPP has an
accompanying server support guide that lists the supported servers and components available for each
of the supported servers. The server support guides and Service Pack for ProLiant Quick Start Guide are
available on the SPP Information Library (http://www.hpe.com/info/spp/documentation).
To update firmware on HPE Apollo and HPE ProLiant products, see the Smart Update Manager User Guide
and the SUM Best Practices Planning Guide at http://www.hpe.com/info/SmartUpdate/docs. The SPP uses
Smart Update Manager (SUM) to deploy firmware and system software components.
To update the firmware on HPE Synergy products, see the HPE Synergy Firmware Update Overview at
http://www.hpe.com/info/synergy-docs.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to the:
Customer Self Repair website.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Create a support case at: http://www.hpe.com/support/hpesc.
HPE Support will contact you.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/006"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/item/005"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check Fans, processor heat sink, and air baffles installation.
1.  Verify that all air baffles and required blanks, such as drive blanks, processor heat sink blanks, power
supply blanks, and so on, are installed.
2.  Verify that the correct processor heat sink is installed.
3.  Verify that the correct fan is installed, if the system supports both standard fans and performance
fans.
For additional information, see the system documentation.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Status.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 0x0016 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0016/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell SYS115 recommendation 1</rdfs:label>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do of the following to resolve the issue: 1) Reconnect the power cord to the power supply unit. 2)
Replace the power supply unit that has the failed power cord sensor, with a new power supply unit. 3)
Make sure that the input power supply is restored.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
