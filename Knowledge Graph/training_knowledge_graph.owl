  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1820/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do one of the following:
•  Move drives to a controller with encryption.
•  Delete the logical drives.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 1820 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1820/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1820/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1820/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR67/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the physical disk with a supported physical disk.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PDR67/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell PDR67 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x315B/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x315B/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x315B/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x315B/procedure/01/item/002"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ensure that the PMEMs are populated in correct order as per earlier successful configuration.
If this issue persists, create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to the:
Customer Self Repair website.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Create a support case at: http://www.hpe.com/support/hpesc.
HPE Support will contact you.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x315B/procedure/01/cause"/>
    <rdfs:label xml:lang="en">HPE 0x315B recommendation 1</rdfs:label>
  </rdf:Description>
