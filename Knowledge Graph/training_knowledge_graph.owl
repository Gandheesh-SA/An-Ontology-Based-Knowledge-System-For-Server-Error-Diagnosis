  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1212/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1212/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset the Secure Boot policy to Custom by running the following RACADM command at the command
line interface (CLI), and then retry the operation:"racadm set bios.syssecurity.securebootpolicy
Custom". For more information, see the RACADM CLI Reference Guide available on the support site.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell RAC1212 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1212/procedure/01/cause"/>
  </rdf:Description>
