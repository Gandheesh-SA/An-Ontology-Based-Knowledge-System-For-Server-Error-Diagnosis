    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PWR2246</diag:eventCode>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0232/procedure/01/item/005">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">5</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0232 printed item 5</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Purpose assessment: PREPARATORY_OR_NAVIGATION. Setup/navigation or power isolation alone is not a cause-specific diagnosis or repair.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [135, 503); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b.</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnect each power cord from the server. CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations (http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283). If this issue persists, create an HPE Support Case.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-CPU6199">
