    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0364/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure that there are two working Chassis Management Modules (CMMs) available. If only one
CMM is present, perform a firmware update operation on it only when the server modules that have
the Persistent Memory feature are turned off.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell UEFI0364 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0364/procedure/01/item/001"/>
  </rdf:Description>
