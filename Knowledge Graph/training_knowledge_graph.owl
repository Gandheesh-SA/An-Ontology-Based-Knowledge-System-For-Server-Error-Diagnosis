  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8670/procedure/01">
    <rdfs:label xml:lang="en">Dell PWR8670 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Make sure the system operates within the subsystem Connector Limit for the components specified.
To review power budget information select Chassis Overview -&gt; Power -&gt; Budget Status. Turn off
unused components within the subsystem to make power available for the server to turn on or turn
off low priority servers and try the operation again.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
