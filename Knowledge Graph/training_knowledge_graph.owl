    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR075/message/01"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The requested operation could not be completed because there is an operation pending to change the enclosure configuration mode (Split or Unified). This operation is exclusive because it involves changing the RAID backplane topology.</diag:explanation>
