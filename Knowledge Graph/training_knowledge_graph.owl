    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perform a Powercycle operation on the I/O module identified in the message. A Powercycle operation can be performed using the RACADM command line utility by typing "racadm chassisaction -m switch-N powercycle (where N is the switch number)".</diag:itemText>
    <rdfs:comment xml:lang="en">Source action_text character span [27, 270); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)</diag:sourceLabel>
  </rdf:Description>
