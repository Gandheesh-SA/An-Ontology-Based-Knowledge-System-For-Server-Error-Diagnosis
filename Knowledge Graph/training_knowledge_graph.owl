    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The SPS Firmware is not operating properly. (Error Code %1)</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SEKM092/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that iDRAC has used the locally cached key to unlock secured devices. This is because iDRAC was unable to start communication with the external Key Management Server for the specified KMSConnectionTimeout value.</diag:causeText>
    <rdfs:label xml:lang="en">Dell SEKM092 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
