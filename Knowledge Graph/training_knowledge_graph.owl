  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001B/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001B/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001B/procedure/01/item/010"/>
