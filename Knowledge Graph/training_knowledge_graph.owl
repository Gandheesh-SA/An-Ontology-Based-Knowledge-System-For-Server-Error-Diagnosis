    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to update the firmware of Power Supply Unit (PSU) in the chassis slot arg1 because update package is not supported. Error=0xarg2 (arg3).</diag:messageText>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "slot", "name": "arg1"}, {"description": "error number", "name": "arg2"}, {"description": "error string", "name": "arg3"}]</diag:messageArguments>
