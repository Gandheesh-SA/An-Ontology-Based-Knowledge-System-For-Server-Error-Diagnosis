    <rdfs:label xml:lang="en">HPE 1101: Storage System Side Panel Removed.</rdfs:label>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1101/message/01"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
