    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltFirmwareSfpFwUpgradeSfpFwUpgrade</diag:eventName>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault indicates that the firmware on an SFP (Small Form-factor Pluggable) transceiver module is currently undergoing an upgrade process or is in a state requiring an upgrade to ensure compatibility with the fabric interconnect.</diag:explanation>
    <rdfs:label xml:lang="en">Cisco F2173: fltFirmwareSfpFwUpgradeSfpFwUpgrade</rdfs:label>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2173/procedure/01"/>
