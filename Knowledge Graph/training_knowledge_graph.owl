    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8670/procedure/01/item/001"/>
  </rdf:Description>
