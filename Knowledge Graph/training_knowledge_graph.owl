    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The IOV slot management subsystem detected an error which may prevent the physical assignment/ unassignment or turning off of a PCIe slot. The errors can be caused by PCIe training timeouts, false hot plug signals,or installation of an unsupported PCIe adapter card. For a list of supported PCIe adapter cards contact your service provider.</diag:causeText>
    <rdfs:label xml:lang="en">Dell IOV1007 possible cause 1</rdfs:label>
  </rdf:Description>
