  <rdf:Description rdf:nodeID="N8a126ed967bf4da0aae0f690bd2b1224">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0364"/>
