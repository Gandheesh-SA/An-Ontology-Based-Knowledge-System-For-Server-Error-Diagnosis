  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HTR0030/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HTR0030/procedure/01/item/001"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power off the server and ensure that the sensor cable is properly connected to the zone identified
in the message. If the issue persists then provide this iDRAC Lifecycle log to the Technical Support
team.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell HTR0030 recommendation 1</rdfs:label>
