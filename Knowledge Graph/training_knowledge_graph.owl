  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ECTL0004/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ECTL0004/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ECTL0004/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ECTL0004/procedure/01/item/002"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Ensure that the cooling fan identified in the message is physically present and the
fan cable connector is securely seated. 2) If the cooling fan is missing, install a compatible cooling fan.
For information about supported cooling fan specification and procedure to install the cooling fan, see
the Installation and Service Manual (ISM) of the respective PowerEdge server available on the support
site. 2) If the issue persists, collect a SupportAssist collection (TSR) report using RMC. Visithttps://
www.dell.com/support/incidents-online/contactus/dynamicto use the Virtual Assistant to analyze the
collection and recommend a resolution.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell ECTL0004 recommendation 1</rdfs:label>
  </rdf:Description>
