    <rdfs:label xml:lang="en">Dell LCPO008 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove system input power and disconnect server liquid hoses from the rack manifold.</diag:procedureText>
  </rdf:Description>
