    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVRE0046/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the backup file is available, restore the startup configuration data manually by running the following
command at the CLI: "copy scp://admin:admin@hostip/&lt;SERVICETAG&gt;.xml config://startup.xml".</diag:procedureText>
    <rdfs:label xml:lang="en">Dell NVRE0046 recommendation 1</rdfs:label>
  </rdf:Description>
