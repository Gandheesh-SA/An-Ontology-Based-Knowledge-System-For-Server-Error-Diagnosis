  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0208/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The TLimit temperature of CPU arg1 has reached the warning threshold. Performance may be impacted. If the condition persists, the system may shut down.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
