  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SYS115">
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYS115</diag:eventName>
