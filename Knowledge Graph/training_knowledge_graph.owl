  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0429">
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Chassis%20and%20Enclosure"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Hardware%20Interconnect"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0429/message/01"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCS-SEM</diag:eventNamespace>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">87</diag:sourcePage>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAJOR</diag:severity>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault occurs if Cisco UCS Manager cannot discover or communicate with one or more chassis or rack servers to write the HA Cluster state. This impacts the full HA functionality of the fabric interconnect cluster.</diag:explanation>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">F0429</diag:eventCode>
    <rdfs:seeAlso rdf:resource="https://www.cisco.com/c/en/us/td/docs/unified_computing/ucs/ucs-manager/Reference-Docs/Faults-Error-Msgs/6-0/b_cisco_ucs_faults_and_error_messages_reference-6-0.pdf"/>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fltMgmtEntityHaNotReady</diag:eventName>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6-UCS-SEM-F0429</diag:recordId>
    <diag:causeCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ha-not-ready</diag:causeCategory>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0429/procedure/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <rdfs:label xml:lang="en">Cisco F0429: fltMgmtEntityHaNotReady</rdfs:label>
  </rdf:Description>
