  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/007"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/005"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/006"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/item/003"/>
    <rdfs:label xml:lang="en">HPE 0x0327 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install a new processor that supports the configured AMP mode. This must be done by an authorized service
provider.
Caution: When reducing the server to a minimum configuration for troubleshooting, do not remove
additional processors. Processors and heatsinks are not designated for customer self-repair. The processor
and heatsink must be removed and replaced by a support specialist.
Before performing any troubleshooting steps that involve processors, review the following guidelines:
•  Be sure that only authorized personnel perform the troubleshooting steps that involve installation,
removal, or replacement of a processor.
•  Always complete all other troubleshooting procedures before an support specialist removes or
replaces a processor.
For more information, see the troubleshooting guide for your product on the Hewlett Packard Enterprise
website:
•  HPE ProLiant Gen10 (http://www.hpe.com/info/gen10-troubleshooting)
•  HPE Synergy (http://www.hpe.com/info/synergy-troubleshooting)
Create an HPE Support Case.
1.  Verify the component is either under warranty or contract. Go to
https://support.hpe.com/hpesc/public/home, and then click Warranty Status.
This enables HPE to ship replacement parts directly to you once a failure has been confirmed. For
specific information about customer replaceable parts, refer to the product maintenance and service
guide.
2.  Under Support Cases, click Access Cases, and then create a support case.
HPE Support will contact you.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0327/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-384/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NVDIMM Error – Processor X, DIMM Y. NVDIMM set for Channel Interleaving disabled but system configured for enabled. All NVDIMMs on Processor X are disabled.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 384 message 1</rdfs:label>
