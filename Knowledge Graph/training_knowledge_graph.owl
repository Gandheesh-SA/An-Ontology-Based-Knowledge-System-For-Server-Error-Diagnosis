  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-4012">
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4012</diag:eventCode>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Fibre%20Channel%20adapter"/>
