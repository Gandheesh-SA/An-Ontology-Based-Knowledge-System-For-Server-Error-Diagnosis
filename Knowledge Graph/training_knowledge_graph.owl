  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0013-0x0015/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSD Wear Status Level has changed to one of the following:
1.  Unknown
2.  Ok
3.  56 Days Remaining
4.  5 Percent Remaining
5.  2 Percent Remaining
6.  SSD Wear Out. Drive will indicate a predictive failure alert.</diag:causeText>
