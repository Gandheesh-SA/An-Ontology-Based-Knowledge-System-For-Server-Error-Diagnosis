  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x3151/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x3151 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When One-button secure erase is started, the appropriate command is sent to the drives. Failures could be
reported when:
•  The drive did not support any erase method and was not erased.
•  A One-button secure erase attempt on the identified drive has failed.
•  The drive was connected to an external port on the controller and was not erased.</diag:causeText>
  </rdf:Description>
