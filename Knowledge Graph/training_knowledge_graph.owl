  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reset the server and resolve the pinned cache issue to complete the firmware activation process.
To reset the server, on the iDRAC GUI, click Configuration &gt; Power Management &gt; Power Control
&gt; Power Cycle System (cold boot). Else, run the RACADM command at the Command Line Interface
(CLI): racadm serveraction powercycle. For more information, see the Controller Users Guide available
on the support site.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8670/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell SWU8670 recommendation 1</rdfs:label>
  </rdf:Description>
