  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN0200/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the fan with one that matches the configuration and type of fan inside MX7000 at the
next scheduled service. Dell recommends as soon as possible for optimal performance. For more
information about recommended fan configurations, see the MX7000 Users Guide available on the
support site.</diag:procedureText>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-FAN0200/procedure/01/item/001"/>
    <rdfs:label xml:lang="en">Dell FAN0200 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cooling%20device"/>
  </rdf:Description>
