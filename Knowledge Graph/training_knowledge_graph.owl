    <rdfs:label xml:lang="en">Dell PWR2217 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upgrade iDRAC to the same version as the other sleds in the chassis. For information about upgrading
iDRAC, see the iDRAC Users Guide available on the support site.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR2217/procedure/01/cause"/>
