  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0384/procedure/01/item/002">
    <rdfs:label xml:lang="en">HPE 0x0384 printed item 2</rdfs:label>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [64, 503); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To enable this NVDIMM, either Channel Interleaving need to be set as Disabled or all NVDIMMs on identified processor needs to be sanitized to work with present system configuration. If manual data backup of NVDIMM is desired, set system configuration as Channel Interleaving disabled to match with NVDIMM configuration and take NVDIMM data backup. Chose desired system configuration afterwards. Enabling or disabling Channel Interleaving</diag:itemText>
