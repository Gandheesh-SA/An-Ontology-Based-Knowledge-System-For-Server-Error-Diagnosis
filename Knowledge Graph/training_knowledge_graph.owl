    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the issue persists, replace the controller. For more information, see the server maintenance and service guide on the Hewlett Packard Enterprise website.</diag:itemText>
