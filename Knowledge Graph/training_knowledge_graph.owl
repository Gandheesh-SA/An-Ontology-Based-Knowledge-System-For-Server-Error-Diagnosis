  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01">
    <rdfs:label xml:lang="en">Dell RAC1311 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1311/procedure/01/item/004"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following and retry the operation: 1. Make sure that the latest iDRAC firmware and backplane
firmware is installed. 2. Verify that the adapter cables are properly connected and there are no bent
pins. 3. Restart the server. To restart, click Configuration &gt; Power Management &gt; Power Control &gt;
Power Cycle System (cold boot). Else, run the RACADM command at the Command Line Interface
(CLI): racadm serveraction powercycle. 4. Reset iDRAC to its initial state. To reset, click Maintenance
&gt; Diagnostics &gt; Reset iDRAC to Factory Defaults. Else, run the RACADM command at the Command
Line Interface (CLI): racadm racresetcfg.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Management%20controller"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
