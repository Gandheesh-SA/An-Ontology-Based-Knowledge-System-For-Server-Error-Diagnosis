    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">261</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">260</diag:sourcePage>
    <rdfs:label xml:lang="en">Cisco F1285: fltFirmwareAutoSyncPolicyDefaultHostPackageMissingVersions</rdfs:label>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco</diag:vendor>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CISCO-UCS-6</diag:sourceDocumentId>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINOR</diag:severity>
