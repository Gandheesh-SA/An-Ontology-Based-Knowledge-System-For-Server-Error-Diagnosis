  <rdf:Description rdf:nodeID="N43ae45413949416d8a4f406b1f7207eb">
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Power down system and check the signal and power connections to the hard drive. Rerun the diagnostic. If no error occurs then it was a cable or connector issue. This error is issued for notebooks which must have a hard disk so it is an error if not found.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-DIAG0155/procedure/01/item/001"/>
