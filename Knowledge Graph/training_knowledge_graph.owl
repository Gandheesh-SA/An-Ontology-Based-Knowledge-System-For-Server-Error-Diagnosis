    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enter a valid parameter and retry the operation. If the issue persists, contact your service provider.
For information about valid parameters, see the OpenManage Enterprise-Modular Users Guide
available on the support site.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
