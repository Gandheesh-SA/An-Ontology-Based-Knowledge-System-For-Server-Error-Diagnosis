    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/PCIe%20device"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PCI3022/procedure/01/item/001"/>
