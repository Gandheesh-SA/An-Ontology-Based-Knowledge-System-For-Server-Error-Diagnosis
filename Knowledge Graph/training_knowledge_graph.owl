  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-STOR394/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The physical drive identified in message cannot be discovered because of incompatibility issues. Some of the issues because of which a device cannot be discovered are as follows: 1) Missing namespace in NSID 1. 2) No namespace is created. 3) Logical Block Addressing (LBA) size is not either one of these: 512 B or 4K. 4) When the Protection Information (PI) feature is enabled.</diag:causeText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell STOR394 possible cause 1</rdfs:label>
  </rdf:Description>
