  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0413/message/01">
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "failureStringType", "name": "arg1"}, {"description": "slotNumber", "name": "arg2"}]</diag:messageArguments>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">Dell UEFI0413 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A arg1 issues occurred during the last shutdown operation on NVDIMM located in slot arg2.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0248/procedure/01/item/001">
    <rdfs:label xml:lang="en">Dell UEFI0248 printed item 1</rdfs:label>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0248/procedure/01/cause"/>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0248/procedure/01/cause"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 313); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reseat all processors in the system and ensure all processors are matching. If the issue persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/support/ incidents-online/contactus/dynamic to use the Virtual Assistant to analyze the collection and recommend a resolution.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0002-0x0017/procedure/01/item/005">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">5</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the access panels, and then attempt to restart the server.</diag:itemText>
