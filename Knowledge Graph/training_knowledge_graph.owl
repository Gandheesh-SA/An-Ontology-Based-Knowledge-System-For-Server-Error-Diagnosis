    <rdfs:label xml:lang="en">HPE 0x1735 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SIOM0050/procedure/01">
