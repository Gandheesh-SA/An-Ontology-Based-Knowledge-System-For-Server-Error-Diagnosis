    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0343</diag:eventName>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System boot cannot be completed because either the backplane signal cable is not installed properly or is damaged. When the backplane power cable is installed but the backplane signal cable is not not installed, the voltage level of the backplane becomes less than the expected 5V, potentially leading to data loss and other issues.</diag:explanation>
    <rdfs:label xml:lang="en">Dell UEFI0343: UEFI0343</rdfs:label>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0343/procedure/01/cause"/>
