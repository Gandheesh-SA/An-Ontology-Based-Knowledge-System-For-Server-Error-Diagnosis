  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F2171/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Service Profile is currently configured to use "Legacy" boot mode. Legacy BIOS boot mode is considered insecure because it lacks modern firmware-level security verification. Switching to UEFI boot mode with Boot Security enabled allows the system to perform cryptographic verification of the boot process, protecting against boot-level malware and rootkits.</diag:causeText>
    <rdfs:label xml:lang="en">Cisco F2171 possible cause 1</rdfs:label>
  </rdf:Description>
