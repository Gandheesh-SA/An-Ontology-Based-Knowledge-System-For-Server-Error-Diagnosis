    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 223); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:label xml:lang="en">Dell PWR8505 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restart the Chassis Management Controller and retry the operation. To restart the Chassis Management Controller, using the WEB UI, go to Chassis Overview &gt; Power &gt; Control, select the Reset CMC option, and then click Apply.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
  </rdf:Description>
