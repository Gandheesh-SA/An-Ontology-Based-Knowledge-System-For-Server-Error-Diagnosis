  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-MEM9072/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system memory has detected an error on a memory transaction at the location arg1. Reboot the system for auto-healing.</diag:messageText>
