    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to update Chassis Infrastructure firmware.</diag:messageText>
    <rdfs:label xml:lang="en">Dell IOV111 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0382/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NVDIMM Error: Proc %1, DIMM %2 is NOT configured for Sub-NUMA Clustering but system is configured for Sub-NUMA Clustering. All NVDIMMs on Proc %3 are disabled.</diag:messageText>
