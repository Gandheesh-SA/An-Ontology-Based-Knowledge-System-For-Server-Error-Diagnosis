  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/006"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/item/005"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE 0x0010 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the connection is lost, perform the following:
1.  Ensure that both the ends of the cable are connected.
2.  Check if an update is available for any of the adapters, firmware, adapter driver, and System ROM.
3.  Ensure that the device at the other end of the connection is available and properly functioning.
4.  Ensure that the network port is not disabled in the OS.
5.  Use a different cable or either use a different port on the switch or a different switch.
6.  See the NIC issues flowchart in the Troubleshooting Guide for more information.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0010/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-390/procedure/01">
    <rdfs:comment xml:lang="en">Retained source safety/context from cause section: CAUTION:
Before removing or replacing any processors, be sure to follow the processor
troubleshooting guidelines in "Performing Processor Procedures in the
Troubleshooting Process" in the HPE ProLiant Gen9 Troubleshooting Guide,
Volume I: Troubleshooting. Failure to follow the recommended guidelines can
cause damage to the system board, requiring replacement of the system board.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Processor"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-390/procedure/01/item/001"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the processor.
For more information, see the server maintenance and service guide on the Hewlett Packard Enterprise
website.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE 390 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-390/procedure/01/cause"/>
  </rdf:Description>
