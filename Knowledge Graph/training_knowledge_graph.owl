  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1926/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisco UCS Manager cannot access the adapter whose connectivity is not discovered. This fault typically occurs as a result of one of the following issues: • The server does not have sufficient power. • The I/O module is not functional. • The adapter firmware has failed. • The adapter is not functional • The adapter is not connected to UCSM</diag:causeText>
    <rdfs:label xml:lang="en">Cisco F1926 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1703/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1703-Slot X Drive Array controller - Memory Self-Test Error. Access to all storage has been disabled.</diag:messageText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
