    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Power"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-SUP0558</diag:recordId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Power Supply Unit (PSU) firmware update operation cannot be completed because the status of one PSU is defective.</diag:explanation>
