  <rdf:Description rdf:nodeID="N26b792385d9940129260f7cfc78bf317">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC2016/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Check the chassis fabric type by using the Manage Module graphic user interface (GUI) and compare against the type of fabric used in the I/O or mezzanine card. To check chassis type on the Manage Module home page, select the server, and then view the I/O module properties. For more information about the compatible fabric types, see the Manage Module Users Guide available on the support site.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC2016/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-HWC2016"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0101/procedure/01/item/010">
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [608, 685); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.</diag:sourceLabel>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">10</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Be sure you have the latest SPP (http://www.hpe.com/servers/spp/download).</diag:itemText>
    <rdfs:label xml:lang="en">HPE 0x0101 printed item 10</rdfs:label>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1e3589a88ff84f3da61b92923d922aa2">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1043/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1043"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-BAT1043/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Ensure that the energy pack is installed and cables are properly connected. For information about cable assembly, see the see the respective PERC Users Guide or the Installation and Service Manual (ISM) of the respective server platform on the support site. In addition, check the connection to the controller energy pack and the energy pack health. An energy pack with a weak or depleted charge may cause this issue. If the issue still persists, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/support/incidents-online/contactus/dynamic to use the Virtual Assistant to analyze the collection and recommend a resolution.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0383/procedure/01/item/002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. Shared component alone does not justify this corrective operation for the source cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [62, 623); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To enable this NVDIMM, either Sub Numa Clustering system configuration needs to be set as Enabled or all NVDIMMs on idetified processor needs to be sanitized to work with present system configuration. If manual data backup of NVDIMM is desired, set system configuration as Sub Numa Clustering enabled to match with NVDIMM configuration and take NVDIMM data backup. Chose desired system configuration afterwards. Enabling or disabling Sub-NUMA Clustering NOTE: Enable XPT Prefetcher in the Processor Prefetcher Options to make Sub-NUMA Clustering configurable.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <rdfs:label xml:lang="en">HPE 0x0383 printed item 2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Cache-module-This-controller-s-firmware-is-not-backward-compatible-with-the-cache-module-revis-34743134fb/message/01">
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Cache-module-This-controller-s-firmware-is-not-backward-compatible-with-the-cache-module-revis-34743134fb message 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cache module: This controller's firmware is not backward compatible with the cache module revision.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N17e3855e9f1547de853699998f555623">
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239/procedure/01/item/001"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x0239/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Ensure the memory configuration includes only a single DIMM type. Consult the User Guide for more information on supported configurations. Check all the installed DIMM and ensure they are of the same type. LRDIMMs and RDIMMs or UDIMMs cannot be mixed in the same system. Reinstall the DIMMs using only the same type and reboot the system. For DIMM population, see the Population rules for HPE DDR4 memory with HPE ProLiant and Synergy Gen10 servers (http://www.hpe.com/docs/memory-population-rules) CAUTION: Failure to properly handle DIMMs can cause damage to DIMM components and the system board connector. See the Best Practices for Handling Memory Modules in ProLiant Server Configurations (http://h20564.www2.hpe.com/hpsc/doc/public/display?docId=emr_na-c00868283).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1921/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x1921 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Previous firmware upgrade was not successful.
2.  Power got interrupted in the middle of upgrade.
3.  Replacement unit contains wrong firmware version</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-LCS2002/procedure/01/item/001">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:label xml:lang="en">Dell LCS2002 printed item 1</rdfs:label>
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 296); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If leak sensor disconnection is not expected, locate the rack and inspect the specific sensor indicated in the message. Ensure the cable is connected fully and properly. For more information see the Installation and Service Manual (ISM) specific to the device model available on the support site.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-236/procedure/01/item/001">
