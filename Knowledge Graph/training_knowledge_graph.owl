    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The RAID Controller is unable to read-write data to the PD identified in the message because the PD is not functioning. The PD is either failed or removed from the server while communicating with the RAID controller.</diag:explanation>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
