    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reinsert the USB device in the Front Panel USB Port and retry the operation. If the issue persists, use
a different USB device.</diag:procedureText>
  </rdf:Description>
