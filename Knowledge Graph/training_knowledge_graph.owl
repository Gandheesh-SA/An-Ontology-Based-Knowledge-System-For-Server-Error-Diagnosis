  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0026/procedure/01/item/001">
    <rdfs:comment xml:lang="en">Purpose assessment: NO_DOCUMENTED_CAUSE. No documented cause in this source solution group; do not invent a cause.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [0, 191); UNNUMBERED_SOURCE_BLOCK; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">Dell UEFI0026 printed item 1</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wait for the BIOS to reset the system and reinitialize the iDRAC. If the issue persists, remove input power from the system, wait for 30 seconds, and re-apply input power. Turn on the system.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0355/procedure/01/cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All the NVDIMMs are disabled because the value of memory capacity of all the installed NVDIMMs has exceeded the maximum value supported by the processor.</diag:causeText>
    <rdfs:label xml:lang="en">Dell UEFI0355 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-GMGR0028/procedure/01/item/001">
