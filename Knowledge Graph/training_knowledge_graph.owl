  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-Predictive-failure-This-physical-drive-is-predicted-to-fail-soon-d344c6eb8b/procedure/02">
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this drive is part of a fault-tolerant configuration:
1.  Bring all of the drives in the array online.
2.  Replace the drive.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
