    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No response action is required. A failover may result from this condition. If multiple failovers
occur, Collect a SupportAssist collection (TSR) report using iDRAC. Visit https://www.dell.com/
support/incidents-online/contactus/dynamic to use the Virtual Assistant to analyze the collection and
recommend a resolution.</diag:procedureText>
  </rdf:Description>
