    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-UEFI0343</diag:recordId>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3633</diag:sourcePage>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0343</diag:eventCode>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0343/procedure/01"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
  </rdf:Description>
