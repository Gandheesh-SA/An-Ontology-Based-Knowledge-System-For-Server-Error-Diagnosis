  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC9020/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Update the System FPGA or CPLD version either by using the host Operating System, Lifecycle
Controller User Interface, or iDRAC by using the latest Update Package. The host server will be
unavailable until the update operation is complete and iDRAC will be reset several times.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell SWC9020 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC9020/procedure/01/item/001"/>
  </rdf:Description>
