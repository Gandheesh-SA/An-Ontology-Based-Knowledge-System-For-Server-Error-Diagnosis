    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Only a single Quad Rank DIMM module can be installed on a channel. Populate memory modules in a supported configuration. For more information, see the platform Owners Manual.</diag:itemText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWU8560/procedure/01/cause">
