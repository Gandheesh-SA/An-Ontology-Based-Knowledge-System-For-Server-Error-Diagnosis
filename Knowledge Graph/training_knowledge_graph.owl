    <rdfs:label xml:lang="en">Cisco F2004 printed item 2</rdfs:label>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Review the Cisco UCS Site Preparation Guide to ensure the servers have adequate airflow, including front and back clearance.</diag:itemText>
