    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An unrecoverable disk media error occurred on arg1. Part Number = arg2</diag:messageText>
  </rdf:Description>
