  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-306/message/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">306-Redundant ROM Error: iLO FW did not set the Primary System ROM. The error has been corrected. iLO FW may have an issue. Action: Remove power. If issue persists, update iLO FW. If issue still persists, call HP service.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 306 message 1</rdfs:label>
  </rdf:Description>
