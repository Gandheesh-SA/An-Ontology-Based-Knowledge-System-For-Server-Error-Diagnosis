    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Virtual-Connect-5009/procedure/01/item/001">
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">•</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the communication between VC and the Onboard Administrator for the affected server is operational.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
