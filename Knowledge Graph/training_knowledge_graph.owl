  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP505/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/System%20board"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Sensor"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verify the Embedded System Management (ESM) Log for any sensor related faults. If there is a failed
sensor, replace the system board. For more information, contact your service provider.</diag:procedureText>
    <rdfs:label xml:lang="en">Dell TMP505 recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP505/procedure/01/item/001"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na97c347c9040481b94ffe5c8b7fadbc6">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Verify that the storage controller and NVDIMM configuration are supported in the server. For more information, see the server user guide for your product on the Hewlett Packard Enterprise website:</rdfs:comment>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-311/procedure/01"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-311/procedure/01/item/001"/>
