    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A leak is detected on arg1 arg2.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F1685/procedure/01">
