  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0029-0x0002/procedure/01/item/020">
    <rdfs:comment xml:lang="en">Source action_text character span [4809, 5142); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: AMBIGUOUS_CORRESPONDENCE. An action exists, but its target cannot be tied to the documented cause by the conservative rules.</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 0x0002 printed item 20</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interlock_mon.c (vrd\src): { ICT_FAULT_KEY(ICT_MISCELLANEOUS, 2, 4), EVT_CRITICAL , EVT_CLASS_INTERLOCK, EVT_IL_DEV_INSTALLED_STATE }, Recommended Action: Replace Chassis. This is not a customer serviceable part, so if the TSB isn’t installed the Chassis is not assembled correctly. The LEDs/temp sensor in the rack ear won’t work.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">20</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20.</diag:sourceLabel>
