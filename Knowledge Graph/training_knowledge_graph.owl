    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0418/message/01"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The server BIOS cannot perform the NVMe over Fabrics (NVMe-oF) boot operation on the subsystem identified in the message because the NVMe-oF host IP address is invalid.</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UEFI0418</diag:eventName>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
