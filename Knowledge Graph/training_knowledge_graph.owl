    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The BIOS password specified in the operation is not valid. A valid BIOS password must be made from the following: 0 to 32 characters in length, numbers 0 to 9, lowercase letters a to z, special characters &lt;&gt;|-,+./;[\].</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIOS018</diag:eventName>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
