  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0011-0x0008/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 0x0008 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  The firmware or drivers are outdated, mismatched, or faulty.
2.  The NIC or cable is not seated properly.
3.  The NIC, the cable, or other hardware is faulty.
4.  The hardware components are not supported in the same configuration.
5.  The NIC is not supported on the server.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#FirmwareCategory">
    <rdfs:subClassOf rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
