    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hot Plug Slot Board Failed Power-Up. A Hot Plug Slot Board has failed to power up in the specified chassis and slot.</diag:explanation>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqsvmsg-dll-1142/message/01"/>
  </rdf:Description>
