    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The firmware image specified in the operation did not apply successfully. An internal error may have occurred because the operation may not be supported, or the device is not present in the target system or disabled for performing the update. For BOSS controller, the device may be in a locked state.</diag:causeText>
    <rdfs:label xml:lang="en">Dell SUP0549 possible cause 1</rdfs:label>
  </rdf:Description>
