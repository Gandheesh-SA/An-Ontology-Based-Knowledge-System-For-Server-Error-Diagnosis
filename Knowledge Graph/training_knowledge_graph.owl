    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disabling of encryption for the identified PMM device failed due to an incorrect passphrase or
encryption logic.</diag:causeText>
  </rdf:Description>
