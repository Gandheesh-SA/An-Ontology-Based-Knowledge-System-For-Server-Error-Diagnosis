    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">542</diag:sourcePage>
    <rdfs:label xml:lang="en">HPE 1142: Hot Plug PCI Board Failed. A hot plug PCI adapter has failed to power up. Insure the board and all cables are installed correctly.</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
