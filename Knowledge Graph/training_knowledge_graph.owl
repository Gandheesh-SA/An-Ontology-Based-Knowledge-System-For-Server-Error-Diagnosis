    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Span Count is not valid for creating a RAID 10. Valid Span counts are arg1.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0184/procedure/01/item/001">
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monitor the error statistics on the degraded DIMM through Cisco UCS Manager. If the high number of errors persists, there is a high possibility of the DIMM becoming inoperable.</diag:itemText>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.</diag:sourceLabel>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
