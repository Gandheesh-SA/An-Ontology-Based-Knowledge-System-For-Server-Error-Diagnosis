  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3018/procedure/01/item/010">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [612, 1014); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open SUM and add the baseline that includes the Smart Array driver. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http://www.hpe.com/info/hpsum/ documentation. Smart Update Tool (SUT): Note: To use SUT, you must have HPE OneView downloaded and installed. For more information, see the HPE OneView documentation at http://www.hpe.com/info/ovvcenter/docs.</diag:itemText>
