  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01/item/002"/>
    <rdfs:label xml:lang="en">HPE 264 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Power down the server.
2.  Set switch SW12 to the OFF position.
To locate the system maintenance switch bank, see the label on the access panel, or the server user
guide for your product:
•  HPE ProLiant Gen10 (https://www.hpe.com/info/proliantgen10-docs)
•  HPE Synergy (https://www.hpe.com/info/synergy-docs)</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-264/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-228/procedure/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-228/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-228/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-228/procedure/01/item/002"/>
    <rdfs:comment xml:lang="en">Retained source safety/context from cause section: CAUTION:
Failure to properly handle DIMMs can damage the DIMM components and
the system board connector. For more information, see the DIMM handling
guidelines in the troubleshooting guide for your product on the Hewlett Packard
Enterprise website:
•  HPE ProLiant Gen10 (https://www.hpe.com/info/gen10-
troubleshooting)
•  HPE Synergy (https://www.hpe.com/info/synergy-troubleshooting)</rdfs:comment>
    <rdfs:label xml:lang="en">HPE 228 recommendation 1</rdfs:label>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-228/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Install DIMMs in a supported configuration.
For more information, see the memory population rules on the Hewlett Packard Enterprise website
(https://www.hpe.com/docs/memory-population-rules).
For additional information, see the server user guide for your product:
•  HPE ProLiant Gen10 (https://www.hpe.com/info/proliantgen10-docs)
•  HPE Synergy (https://www.hpe.com/info/synergy-docs)</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Memory%20module"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0315/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An uncorrectable memory error was detected prior to this system boot.</diag:messageText>
    <rdfs:label xml:lang="en">HPE 0x0315 message 1</rdfs:label>
