    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to allocate the Memory Mapped Input Output (MMIO) resources for one or more PCIe cards either because of insufficient MMIO memory space or because arg1.</diag:messageText>
  </rdf:Description>
