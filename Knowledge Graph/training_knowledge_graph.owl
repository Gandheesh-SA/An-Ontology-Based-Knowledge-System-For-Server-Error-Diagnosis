  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0364/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell UEFI0364 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The power loss in chassis cannot be detected because the communication between the server module and Chassis Management Module (CMM) is unavailable. The Persistent Memory feature cannot save data if an input power loss occurs.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01/item/003">
