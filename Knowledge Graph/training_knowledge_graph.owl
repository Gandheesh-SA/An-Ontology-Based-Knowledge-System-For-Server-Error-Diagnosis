    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">THRM0003</diag:eventName>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">THRM0003</diag:eventCode>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The server is currently ignoring the fan speed limit that is set by enabling the Sound Cap thermal profile because of thermal cooling constraints. The server is expected to reinstate the Sound Cap thermal profile based fan speed limit if the server power consumption and/or power management capabilities allows meeting system thermal requirement. PCIe adapters and storage drives are some sub-systems that do not have granular power controls and may limit overall server power reduction to meet server cooling requirements at the limited fan speed.</diag:explanation>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-THRM0003</diag:recordId>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
  </rdf:Description>
