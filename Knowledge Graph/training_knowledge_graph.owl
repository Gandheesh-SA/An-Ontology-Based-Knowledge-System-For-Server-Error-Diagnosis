  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-POST-1728/procedure/01/cause">
    <rdfs:label xml:lang="en">HPE 1728 possible cause 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The HPE Smart Storage Battery is not installed or is not connected correctly, but caching was enabled. Any
data that might have been in the cache module memory has been lost due to the controller power loss.</diag:causeText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09/procedure/01">
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09/procedure/01/item/001"/>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.  Reseat the power supply.
2.  Make sure that the power cable is connected correctly.
3.  If the issue persists, replace the power supply.
For more information, see the maintenance and service guide for your product on the Hewlett
Packard Enterprise website.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Storage-Enclosure-Warning-One-or-more-redundant-power-supplies-in-this-enclosure-has-failed-or-c9a7dd6e09 recommendation 1</rdfs:label>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
