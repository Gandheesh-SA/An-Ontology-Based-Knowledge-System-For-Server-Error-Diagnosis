    <rdfs:label xml:lang="en">Dell PR17 recommendation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-TMP0114/procedure/01/cause">
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambient air temperature is too warm or one or more fans may have failed.</diag:causeText>
