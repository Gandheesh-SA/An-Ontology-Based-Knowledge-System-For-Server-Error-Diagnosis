  <rdf:Description rdf:nodeID="N203e1a9b361043028245f6ec97ceaea4">
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8596/procedure/01/item/001"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8596"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PWR8596/procedure/01"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Power%20supply"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Make sure there is enough power supply to distribute power. Go to, the Chassis Overview &gt; Power &gt; Power Budget Status. In the Total Input Power Available For Allocation field, view the available power. To add more power, insert more PSUs or remove unused components from the chassis. When enough power is available, retry the operation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0032-0x3048/procedure/01/item/004">
