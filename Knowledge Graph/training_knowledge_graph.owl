  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-NVTP0002/message/01">
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to validate the MX7116n Fabric Expander Module because the slot number of the MX7116n Fabric Expander Module and the slot number of the Network IOM are different.</diag:messageText>
