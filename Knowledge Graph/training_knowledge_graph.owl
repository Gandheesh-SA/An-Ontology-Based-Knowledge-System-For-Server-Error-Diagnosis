  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01">
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01/cause"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this message is observed after moving a configured array of drives from another controller, do the
following:
1.  Upgrade the firmware on this controller.
2.  Make sure that the cache module is installed. Install the cache module if not present.
3.  If the issue persists, power down the server and move the drives back to the original controller.</diag:procedureText>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac recommendation 1</rdfs:label>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Controller-State-The-array-controller-has-an-unsupported-configuration-76061908ac/procedure/01/item/003"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 1</diag:procedureLabel>
  </rdf:Description>
