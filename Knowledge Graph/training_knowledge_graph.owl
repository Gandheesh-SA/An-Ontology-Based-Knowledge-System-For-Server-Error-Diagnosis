    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0189/procedure/01/item/003"/>
    <rdfs:label xml:lang="en">Cisco F0189 recommendation 1</rdfs:label>
  </rdf:Description>
