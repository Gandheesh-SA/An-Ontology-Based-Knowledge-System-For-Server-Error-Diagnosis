    <rdfs:label xml:lang="en">Dell UEFI0176 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Only a single Quad Rank DIMM module can be installed on a channel. Populate memory modules in a
supported configuration. For more information, see the platform Owners Manual.</diag:procedureText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0190/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0190/procedure/01/item/002"/>
