    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reboot the system and try again.</diag:itemText>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
