    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Boot%20and%20Startup"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0138</diag:eventCode>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-PST0138</diag:recordId>
    <rdfs:label xml:lang="en">Dell PST0138: PST0138</rdfs:label>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System BIOS detected a failure with the SIO. This exception occurred early in system power on, thus the system may not display video. (BIOS POST code exception code 8A).</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PST0138</diag:eventName>
