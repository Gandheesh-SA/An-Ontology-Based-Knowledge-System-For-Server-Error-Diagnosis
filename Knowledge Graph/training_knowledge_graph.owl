    <rdfs:label xml:lang="en">Dell MEM9035 message 1</rdfs:label>
    <diag:messageArguments rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[{"description": "location", "name": "arg1"}]</diag:messageArguments>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Non-Volatile Dual In-line Memory Module (NVDIMM) device in the slot arg1 cannot be configured to save data during a power loss because of an issue in the NVDIMM.</diag:messageText>
  </rdf:Description>
