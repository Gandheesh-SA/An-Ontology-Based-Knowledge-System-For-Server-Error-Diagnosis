  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR100">
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-VDR100</diag:recordId>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The virtual disk identified in message cannot be used because of missing features on the current controller. The features may be missing because they are not available in the firmware version on the controller or the necessary licenses are not installed.</diag:explanation>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3724</diag:sourcePage>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Storage"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-VDR100/procedure/01/cause"/>
