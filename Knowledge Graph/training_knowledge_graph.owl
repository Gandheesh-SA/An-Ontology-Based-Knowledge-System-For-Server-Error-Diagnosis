    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#targetsComponentType"/>
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Replace the failed physical disk. Identify the failed physical disk by locating the disk that has a red "X" for its status. Rebuild the physical disk. When finished, restart the virtual disk format operation.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
