    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A critical diagnostic event occurred on the Software Defined Persistent Memory (SDPM) virtual DIMM located at arg1. Sanitize the device. Extended ID: arg2.</diag:messageText>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU0919/message/01">
