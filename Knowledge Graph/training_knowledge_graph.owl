    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/component-type/Network%20adapter"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0071"/>
