    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000B-0x0042/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Smart-SSD-State-SSD-has-reached-the-maximum-rated-usage-limit-for-writes-wearout-and-should-be-356f67de70/procedure/01/item/001">
