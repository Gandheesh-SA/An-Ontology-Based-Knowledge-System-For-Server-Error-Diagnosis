  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x0022-0x001B/procedure/01/item/004">
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.</diag:sourceLabel>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plug another device into the grounded power outlet to be sure the outlet works. Also, be sure the power source meets applicable standards.</diag:itemText>
