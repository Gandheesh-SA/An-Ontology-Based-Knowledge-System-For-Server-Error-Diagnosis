  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-PSU8523/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The power supply unit (PSU) identified in the message was turned off because the input over current fault occurred.</diag:causeText>
    <rdfs:label xml:lang="en">Dell PSU8523 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-SWC5012/procedure/01/cause">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dell SWC5012 possible cause 1</rdfs:label>
    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The system cannot be powered on because either a critical cable is missing, or the device associated with the SL (slimline PCIe data) cable identified in the message is removed or missing a required SL cable, power cable, or signal cable. This may be a device seating issue or a connectivity issue with a cable required by the device or connectivity issue with a critical cable.</diag:causeText>
  </rdf:Description>
