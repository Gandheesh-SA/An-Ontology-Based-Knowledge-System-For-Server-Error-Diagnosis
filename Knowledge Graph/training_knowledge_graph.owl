  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC1040/procedure/01">
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To apply the configuration operation, create a configuration job, and then restart the server. To create
the required commit and reboot jobs, run the jobqueue command. For more information about the
jobqueue command, enter the RACADM command "racadm help jobqueue".</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
