    <rdfs:label xml:lang="en">HPE 0x1826 message 1</rdfs:label>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A POST message displays: Slot X Encryption Failure-Encryption engine hardware failure. Encrypted logical drives offline. Encrypted logical drives are offline until the problem is corrected.</diag:messageText>
  </rdf:Description>
