  <rdf:Description rdf:nodeID="N3773d75d31b041f08a31b0e18adfc91f">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Connect the missing network interface card to the system and enable the UEFI network interface in System Setup.</rdfs:comment>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0071/procedure/01"/>
