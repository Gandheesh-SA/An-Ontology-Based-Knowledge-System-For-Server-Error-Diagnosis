    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Microcontroller Unit (MCU) firmware update operation is in progress.</diag:messageText>
    <rdfs:label xml:lang="en">Dell RAC0187 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-RAC0741/message/01">
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:messageText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unable to perform Prepare to Remove or Secure Erase operations on the selected PCIe SSD disk drive(s), because Lifecycle Controller is not enabled.</diag:messageText>
    <rdfs:label xml:lang="en">Dell RAC0741 message 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x1707/procedure/01/cause">
