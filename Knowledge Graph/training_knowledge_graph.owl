    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replace the failed PSUs and verify that the power shelves are receiving the input power.</diag:procedureText>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
