    <rdfs:label xml:lang="en">HPE 1167: Inadequate Power To Power On</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqsvmsg-dll-1167/message/01"/>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1167</diag:eventCode>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inadequate power to power on. There is not enough power to power on the server blade. The power enclosure micro-controller was not found.</diag:explanation>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inadequate Power To Power On</diag:eventName>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2b72d96bd65b4efda909d8acad9b8f8a">
    <rdfs:comment xml:lang="en">Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Reseat hard disks in the bay. Reconnect all cables attached to the bay.</rdfs:comment>
