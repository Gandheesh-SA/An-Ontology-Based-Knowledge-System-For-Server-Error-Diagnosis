    <rdfs:label xml:lang="en">Dell UEFI0363 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is recommended that you reconfigure the ratio of DDR memory capacity to NVDIMM capacity to a value between 1:2 and 1:16. For more information about reconfiguring the DDR4 memory, see the platform Installation and Service Manual, available on the support site.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
