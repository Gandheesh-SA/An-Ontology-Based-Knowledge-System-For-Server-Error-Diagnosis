    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The NVDIMM device in the slot identified in the message has encountered a critical error. System performance may be degraded. The operating system and/or applications may fail as a result.</diag:explanation>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Memory"/>
