  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0261/procedure/01/item/014">
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source action_text character span [1218, 2483); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">14</diag:itemOrder>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Run SUT from the command line (On-Demand mode) to update the Smart Array firmware. For more information, see to the HP SUT documents at http://www.hpe.com/info/sut-docs. Service Pack for ProLiant (SPP): Update the Smart Array firmware by downloading the SPP from the Hewlett Packard Enterprise website (http://www.hpe.com/servers/spp). Refer to the SPP documentation at http://www.hpe.com/info/spp/ documentation for instructions on updating the firmware. Note: Downloading an SPP requires a contract with Hewlett Packard Enterprise and an HPE Passport ID. If you do not have an HPE Passport ID, go to http://www.hpe.com/info/insightonline. Note: Downloading the entire SPP can take a significant amount of time. Online Flash components This component provides updated system firmware that can be installed directly on supported operating systems. Additionally, when used in conjunction with the SUM, this Smart Component allows you to update firmware on remote servers from a central location. This remote deployment capability eliminates the need for you to be physically present at the server to perform a firmware update. For specific instructions on updating firmware, see the Smart Update Manager User Guide, at http:// www.hpe.com/info/hpsum/documentation.</diag:itemText>
    <rdfs:label xml:lang="en">HPE 0x0261 printed item 14</rdfs:label>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-IML-2026-IML-Class-0x000A-0x0261/procedure/01/cause"/>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1205">
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drive Array Accelerator Bad Data.</diag:eventName>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20drive"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Accelerator"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Battery%20or%20capacitor"/>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">491</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">492</diag:sourcePage>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Accelerators%20and%20GPUs"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Storage"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Battery%20and%20Capacitor"/>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows-cpqstmsg.dll</diag:eventNamespace>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accelerator Board Bad Data. This trap indicates that the agent has detected an array accelerator cache board that has lost battery power. If data was being stored in the accelerator cache memory when the server lost power, that data has been lost.</diag:explanation>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1205/procedure/01"/>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1205</diag:eventCode>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2-Windows-cpqstmsg-dll-1205</diag:recordId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE</diag:vendor>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Windows-cpqstmsg-dll-1205/message/01"/>
    <rdfs:label xml:lang="en">HPE 1205: Drive Array Accelerator Bad Data.</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://support.hpe.com/hpesc/public/docDisplay?docId=sd00003116en_us&amp;docLocale=en_US"/>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPE-GEN9-V2</diag:sourceDocumentId>
  </rdf:Description>
