  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-physical-drive-is-part-of-a-logical-drive-that-is-not-supported-by-t-1cb8dab46c/procedure/02">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-physical-drive-is-part-of-a-logical-drive-that-is-not-supported-by-t-1cb8dab46c/procedure/02/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-physical-drive-is-part-of-a-logical-drive-that-is-not-supported-by-t-1cb8dab46c/procedure/02/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-physical-drive-is-part-of-a-logical-drive-that-is-not-supported-by-t-1cb8dab46c/procedure/02/item/001"/>
    <diag:procedureLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solution 2</diag:procedureLabel>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HPE HPE-GEN9-V2-Troubleshooting-Physical-Drive-State-This-physical-drive-is-part-of-a-logical-drive-that-is-not-supported-by-t-1cb8dab46c recommendation 2</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If this message is observed without any drive movement, do the following:
1.  Verify that the cache module is installed. Install the cache module if not present.
2.  Verify that the cache module is working. Replace the cache module, if required.
3.  If the issue persists, contact Hewlett Packard Enterprise support.</diag:procedureText>
  </rdf:Description>
