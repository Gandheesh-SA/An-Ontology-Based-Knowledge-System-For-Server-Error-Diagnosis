    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This fault is raised when an I/O module fabric port, which links the I/O module port and the fabric interconnect, is not functional</diag:explanation>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0367/procedure/01"/>
