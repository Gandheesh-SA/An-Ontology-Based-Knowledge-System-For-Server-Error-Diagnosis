    <diag:causeText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The BIOS configuration change was consumed through the RESTful API, and one or more of the requested
changes resulted in an error. For example, attempting to set an attribute to an invalid or unsupported value.</diag:causeText>
    <rdfs:label xml:lang="en">HPE 336 possible cause 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-UEFI0295/procedure/01/item/001">
