  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01">
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01/item/003"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01/item/004"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/CISCO-UCS-6-UCS-SEM-F0428/procedure/01/item/005"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Cisco F0428 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If you see this fault, take the following actions:
1. Verify that the initial setup configuration is correct on both fabric interconnects.
2. Verify that the L1 and L2 links are properly connected between the fabric interconnects.
3. In the Cisco UCS Manager CLI, run the cluster force primary local-mgmt command on one fabric
interconnect.
4. Reboot the fabric interconnects.
5. If the above actions did not resolve the issue, create a show tech-support file and contact Cisco TAC.</diag:procedureText>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Interconnect%20module"/>
  </rdf:Description>
