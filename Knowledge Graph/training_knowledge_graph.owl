    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change the NIC mode to dedicated mode by using "racadm set idrac.nic.selection &lt;1 | Dedicated&gt;",
and retry the operation.</diag:procedureText>
