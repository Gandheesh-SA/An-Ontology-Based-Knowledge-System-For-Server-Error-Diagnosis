@prefix dell: <https://example.org/dell-troubleshooting#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix noria: <https://w3id.org/noria/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dell:AvailabilityCondition a owl:Class ;
    rdfs:label "Availability Condition"@en ;
    rdfs:comment "Availability Condition within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ReportedCondition .

dell:CompatibilityCondition a owl:Class ;
    rdfs:label "Compatibility Condition"@en ;
    rdfs:comment "Compatibility Condition within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ReportedCondition .

dell:CoolingComponentType a owl:Class ;
    rdfs:label "Cooling Component Type"@en ;
    rdfs:comment "Cooling Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:CorrectiveOperationType a owl:Class ;
    rdfs:label "Corrective Operation Type"@en ;
    rdfs:comment "Corrective Operation Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:OperationType .

dell:DiagnosticOperationType a owl:Class ;
    rdfs:label "Diagnostic Operation Type"@en ;
    rdfs:comment "Diagnostic Operation Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:OperationType .

dell:ErrorCondition a owl:Class ;
    rdfs:label "Error Condition"@en ;
    rdfs:comment "Error Condition within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ReportedCondition .

dell:FirmwareComponentType a owl:Class ;
    rdfs:label "Firmware Component Type"@en ;
    rdfs:comment "Firmware Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ComponentType .

dell:IntegrityCondition a owl:Class ;
    rdfs:label "Integrity Condition"@en ;
    rdfs:comment "Integrity Condition within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ReportedCondition .

dell:InterconnectComponentType a owl:Class ;
    rdfs:label "Interconnect Component Type"@en ;
    rdfs:comment "Interconnect Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:ManagementOperationType a owl:Class ;
    rdfs:label "Management Operation Type"@en ;
    rdfs:comment "Management Operation Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:OperationType .

dell:MemoryComponentType a owl:Class ;
    rdfs:label "Memory Component Type"@en ;
    rdfs:comment "Memory Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:PowerComponentType a owl:Class ;
    rdfs:label "Power Component Type"@en ;
    rdfs:comment "Power Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:ProcessingComponentType a owl:Class ;
    rdfs:label "Processing Component Type"@en ;
    rdfs:comment "Processing Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:SecurityComponentType a owl:Class ;
    rdfs:label "Security Component Type"@en ;
    rdfs:comment "Security Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:StorageComponentType a owl:Class ;
    rdfs:label "Storage Component Type"@en ;
    rdfs:comment "Storage Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:HardwareComponentType .

dell:appearsBefore a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "appears Before"@en ;
    rdfs:comment "Earlier in the source order within one procedure. Population must check procedure boundaries and cycles."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ProcedureInstruction ;
    dell:relationshipCategory "Association" .

dell:argumentText a owl:DatatypeProperty ;
    rdfs:label "argument Text"@en ;
    rdfs:comment "Original documented placeholder names and meanings; not runtime bindings."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:attemptsToCorrectExplanation a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "attempts To Correct Explanation"@en ;
    rdfs:comment "Identifies a documented possibility this instruction seeks to remedy."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:PossibleExplanation ;
    dell:relationshipCategory "Association" .

dell:categoryText a owl:DatatypeProperty ;
    rdfs:label "category Text"@en ;
    rdfs:comment "Original Dell category and subsystem text."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:comparisonOperator a owl:DatatypeProperty ;
    rdfs:label "comparison Operator"@en ;
    rdfs:comment "Optional source-supported LT, LE, GT, GE, EQ or NE comparison; preserves strict versus inclusive bounds."@en ;
    rdfs:domain dell:ThresholdCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:competencyQuestion a owl:AnnotationProperty ;
    rdfs:label "competency Question"@en ;
    rdfs:comment "A question the populated catalogue should answer."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:conceptId a owl:DatatypeProperty ;
    rdfs:label "concept Id"@en ;
    rdfs:comment "A stable identifier within this model."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:EventDefinition dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:RecoveryProcedure dell:ProcedureInstruction dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:concernsComponentType a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "concerns Component Type"@en ;
    rdfs:comment "Identifies the component kind affected by the condition."@en ;
    rdfs:domain dell:ReportedCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ComponentType ;
    dell:relationshipCategory "Association" .

dell:concernsTechnicalProperty a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "concerns Technical Property"@en ;
    rdfs:comment "Identifies the property involved, such as fan speed."@en ;
    rdfs:domain dell:ReportedCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:TechnicalProperty ;
    dell:relationshipCategory "Association" .

dell:conditionText a owl:DatatypeProperty ;
    rdfs:label "condition Text"@en ;
    rdfs:comment "An explicit conditional qualification, such as If installed; does not assert it holds."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:describesAnomalyPattern a owl:ObjectProperty ;
    rdfs:label "describes Anomaly Pattern"@en ;
    rdfs:comment "Optional link when a reported condition describes a specifically identified NORIA anomaly pattern."@en ;
    rdfs:domain dell:ReportedCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range noria:AnomalyPattern ;
    dell:relationshipCategory "Association" .

dell:describesCondition a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "describes Condition"@en ;
    rdfs:comment "Identifies a condition described by the event message."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ReportedCondition ;
    dell:relationshipCategory "Association" .

dell:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Meaning of this concept or source-scoped statement."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:eventCode a owl:DatatypeProperty ;
    rdfs:label "event Code"@en ;
    rdfs:comment "Original event code."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:evidenceDocumentId a owl:AnnotationProperty ;
    rdfs:label "evidence Document Id"@en ;
    rdfs:comment "Guide and edition supporting this particular relationship."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:evidencePage a owl:AnnotationProperty ;
    rdfs:label "evidence Page"@en ;
    rdfs:comment "Physical PDF page supporting this particular relationship."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:evidenceQuote a owl:AnnotationProperty ;
    rdfs:label "evidence Quote"@en ;
    rdfs:comment "Source wording supporting this particular relationship."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:explanationText a owl:DatatypeProperty ;
    rdfs:label "explanation Text"@en ;
    rdfs:comment "Full original detailed-description section, including no-description statements."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:hasDocumentedPartType a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has Documented Part Type"@en ;
    rdfs:comment "Records an explicitly documented whole-to-part link between distinct component kinds."@en ;
    rdfs:domain dell:ComponentType ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ComponentType ;
    dell:relationshipCategory "Shared aggregation" .

dell:hasDocumentedResponse a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has Documented Response"@en ;
    rdfs:comment "Links an entry to its complete response block, which can contain alternatives."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:RecoveryProcedure ;
    dell:relationshipCategory "Association" .

dell:hasPossibleExplanation a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has Possible Explanation"@en ;
    rdfs:comment "Links a condition to a possibility supported by the source wording."@en ;
    rdfs:domain dell:ReportedCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:PossibleExplanation ;
    dell:relationshipCategory "Association" .

dell:instructionOrder a owl:DatatypeProperty ;
    rdfs:label "instruction Order"@en ;
    rdfs:comment "Unique source reading position within the procedure, not an execution dependency."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:positiveInteger .

dell:instructionPath a owl:DatatypeProperty ;
    rdfs:label "instruction Path"@en ;
    rdfs:comment "Optional source nesting position, such as 2.b; not a second ordering algorithm."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:instructionText a owl:DatatypeProperty ;
    rdfs:label "instruction Text"@en ;
    rdfs:comment "A reviewed instruction span with its local qualifications intact."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:investigatesExplanation a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "investigates Explanation"@en ;
    rdfs:comment "Identifies a documented possibility that this instruction checks."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:PossibleExplanation ;
    dell:relationshipCategory "Association" .

dell:locationText a owl:DatatypeProperty ;
    rdfs:label "location Text"@en ;
    rdfs:comment "Documented slot, bay or other location wording, preserving placeholders."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:mappingStatus a owl:AnnotationProperty ;
    rdfs:label "mapping Status"@en ;
    rdfs:comment "SOURCE_SUPPORTED_INTERPRETATION identifies a reviewed mapping, not vendor verification or repair success."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:messageText a owl:DatatypeProperty ;
    rdfs:label "message Text"@en ;
    rdfs:comment "Original message, retaining placeholders."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "A readable source-grounded name."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:EventDefinition dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:RecoveryProcedure dell:ProcedureInstruction dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:platformAlertText a owl:DatatypeProperty ;
    rdfs:label "platform Alert Text"@en ;
    rdfs:comment "Original platform-qualified applicability/default settings; not proof an alert was sent."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:procedureText a owl:DatatypeProperty ;
    rdfs:label "procedure Text"@en ;
    rdfs:comment "Complete response represented by this procedure, retaining order, conditions and cautions."@en ;
    rdfs:domain dell:RecoveryProcedure ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:qualifierText a owl:DatatypeProperty ;
    rdfs:label "qualifier Text"@en ;
    rdfs:comment "Source wording such as may, either/or, or platform qualifications."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:ReportedCondition dell:PossibleExplanation ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:recommendedResponseText a owl:DatatypeProperty ;
    rdfs:label "recommended Response Text"@en ;
    rdfs:comment "Full original response, including pure no-action policies and cautions."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:relationshipCategory a owl:AnnotationProperty ;
    rdfs:label "relationship Category"@en ;
    rdfs:comment "UML presentation category; not a built-in OWL property characteristic."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> .

dell:requestsArtifactType a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "requests Artifact Type"@en ;
    rdfs:comment "Identifies a deliverable requested for generation or collection."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:TechnicalArtifactType ;
    dell:relationshipCategory "Association" .

dell:requestsOperationType a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "requests Operation Type"@en ;
    rdfs:comment "Classifies the work requested by the instruction."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:OperationType ;
    dell:relationshipCategory "Association" .

dell:restrictionText a owl:DatatypeProperty ;
    rdfs:label "restriction Text"@en ;
    rdfs:comment "An explicit caution or prohibition; not a verified runtime guard."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:comment "Original Critical or Warning value in this dataset profile."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:similarEvent a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "similar Event"@en ;
    rdfs:comment "Same typed catalogue content signature, preserving order, qualifiers and values. Compare distinct records only from complete signatures after whitespace normalization. Reflexivity also relates every individual to itself."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    dell:relationshipCategory "Association" .

dell:sourceDocumentId a owl:DatatypeProperty ;
    rdfs:label "source Document Id"@en ;
    rdfs:comment "Source guide and edition identifier; reusable concepts may have several sources."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:EventDefinition dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:RecoveryProcedure dell:ProcedureInstruction dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:sourceEventText a owl:DatatypeProperty ;
    rdfs:label "source Event Text"@en ;
    rdfs:comment "Complete extracted entry, preserving vendor metadata and repeated platform sections."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:sourcePage a owl:DatatypeProperty ;
    rdfs:label "source Page"@en ;
    rdfs:comment "Physical PDF page number; multiple pages may support an entity."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:EventDefinition dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:RecoveryProcedure dell:ProcedureInstruction dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:positiveInteger .

dell:sourceQuote a owl:DatatypeProperty ;
    rdfs:label "source Quote"@en ;
    rdfs:comment "Supporting source wording; preserves qualifications."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dell:EventDefinition dell:ComponentType dell:ReportedCondition dell:TechnicalProperty dell:PossibleExplanation dell:RecoveryProcedure dell:ProcedureInstruction dell:OperationType dell:TechnicalArtifactType ) ] ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:sourceStepLabel a owl:DatatypeProperty ;
    rdfs:label "source Step Label"@en ;
    rdfs:comment "Original numbering or bullet label, where present."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:targetsComponentType a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "targets Component Type"@en ;
    rdfs:comment "Identifies the kind of component to check or act on."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ComponentType ;
    dell:relationshipCategory "Association" .

dell:thresholdDirection a owl:DatatypeProperty ;
    rdfs:label "threshold Direction"@en ;
    rdfs:comment "Source-supported ABOVE or BELOW relation to the threshold."@en ;
    rdfs:domain dell:ThresholdCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:thresholdLevel a owl:DatatypeProperty ;
    rdfs:label "threshold Level"@en ;
    rdfs:comment "Source-supported threshold band, such as Warning or Critical."@en ;
    rdfs:domain dell:ThresholdCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:thresholdUnitText a owl:DatatypeProperty ;
    rdfs:label "threshold Unit Text"@en ;
    rdfs:comment "Source unit for an explicit numeric threshold; no unit conversion implied."@en ;
    rdfs:domain dell:ThresholdCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:thresholdValue a owl:DatatypeProperty ;
    rdfs:label "threshold Value"@en ;
    rdfs:comment "A numeric threshold explicitly present in the source, not an observed measurement."@en ;
    rdfs:domain dell:ThresholdCondition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:decimal .

dell:toolText a owl:DatatypeProperty ;
    rdfs:label "tool Text"@en ;
    rdfs:comment "Documented tool, interface or command wording."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dell:usesArtifactType a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "uses Artifact Type"@en ;
    rdfs:comment "Identifies the kind of file or information inspected or used."@en ;
    rdfs:domain dell:ProcedureInstruction ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:TechnicalArtifactType ;
    dell:relationshipCategory "Association" .

dell:vendorMetadataText a owl:DatatypeProperty ;
    rdfs:label "vendor Metadata Text"@en ;
    rdfs:comment "Original label/value text for optional vendor fields, including LCD and trap identifiers."@en ;
    rdfs:domain dell:EventDefinition ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range xsd:string .

dul:Plan a owl:Class .

saref:FeatureKind a owl:Class .

saref:Property a owl:Class .

noria:AnomalyPattern a owl:Class .

noria:OperationPlan a owl:Class .

dul:Description a owl:Class .

dul:InformationObject a owl:Class .

dell:containsInstruction a owl:AsymmetricProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "contains Instruction"@en ;
    rdfs:comment "Owns an instruction occurrence within this response. Identical words in another response are a separate occurrence."@en ;
    rdfs:domain dell:RecoveryProcedure ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:range dell:ProcedureInstruction ;
    dell:relationshipCategory "Composition" .

dul:Concept a owl:Class .

dell:ThresholdCondition a owl:Class ;
    rdfs:label "Threshold Condition"@en ;
    rdfs:comment "Threshold Condition within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ReportedCondition .

dell:HardwareComponentType a owl:Class ;
    rdfs:label "Hardware Component Type"@en ;
    rdfs:comment "Hardware Component Type within the Dell troubleshooting catalogue."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dell:ComponentType .

dell:TechnicalProperty a owl:Class ;
    rdfs:label "Technical Property"@en ;
    rdfs:comment "A property concept such as fan speed or voltage, not a measured value."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Concept,
        saref:Property .

dell:TechnicalArtifactType a owl:Class ;
    rdfs:label "Technical Artifact Type"@en ;
    rdfs:comment "A reusable type of information artifact, not an actual log file or generated report."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Concept .

dell:RecoveryProcedure a owl:Class ;
    rdfs:label "Recovery Procedure"@en ;
    rdfs:comment "A complete documented troubleshooting response, not a proven repair or executable workflow."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dell:containsInstruction ;
            owl:someValuesFrom dell:ProcedureInstruction ],
        dul:Plan,
        noria:OperationPlan .

dell:OperationType a owl:Class ;
    rdfs:label "Operation Type"@en ;
    rdfs:comment "A reusable operation concept; classification does not establish safety or success."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Concept .

dell:PossibleExplanation a owl:Class ;
    rdfs:label "Possible Explanation"@en ;
    rdfs:comment "A documented possible explanation, retaining alternatives and uncertainty."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Description .

dell:ComponentType a owl:Class ;
    rdfs:label "Component Type"@en ;
    rdfs:comment "A reusable concept describing a component type, not an installed device."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Concept,
        saref:FeatureKind .

dell:EventDefinition a owl:Class ;
    rdfs:label "Event Definition"@en ;
    rdfs:comment "A versioned Dell catalogue entry, not an observed incident."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:InformationObject .

dell:ReportedCondition a owl:Class ;
    rdfs:label "Reported Condition"@en ;
    rdfs:comment "A source-supported reported state or problem pattern, scoped to its definition."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf dul:Description .

dell:ProcedureInstruction a owl:Class ;
    rdfs:label "Procedure Instruction"@en ;
    rdfs:comment "A procedure-owned instruction occurrence, preserving its source context."@en ;
    rdfs:isDefinedBy <https://example.org/dell-troubleshooting> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf dell:containsInstruction ] ;
            owl:someValuesFrom dell:RecoveryProcedure ],
        dul:InformationObject .

<https://example.org/dell-troubleshooting> a owl:Ontology ;
    rdfs:label "Dell server troubleshooting catalogue ontology"@en ;
    rdfs:comment "Schema for documented Critical and Warning entries, their explanations and recommended responses. External class IRIs are reused selectively."@en ;
    rdfs:seeAlso <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl>,
        <https://cdn.aaai.org/Symposia/Spring/1997/SS-97-06/SS97-06-005.pdf>,
        <https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf>,
        <https://doi.org/10.1007/978-3-031-60635-9_2>,
        <https://saref.etsi.org/core/v4.1.1/>,
        noria:,
        <https://www.w3.org/TR/owl2-syntax/> ;
    owl:versionIRI <https://example.org/dell-troubleshooting/dell-catalogue/1.0> ;
    dell:competencyQuestion "What complete response is recommended, including no-action policies, conditions and warnings?"@en,
        "What documented possibilities explain this condition, retaining uncertainty and alternatives?"@en,
        "What information artifacts are used versus requested as outputs?"@en,
        "Which definition reports a given condition, component type and technical property?"@en,
        "Which explicit threshold direction, level, value and unit does the source document?"@en,
        "Which instruction investigates or attempts to address which documented possibility, with what source support?"@en,
        "Which instructions belong to a procedure, and in what source order and nesting?"@en,
        "Which source entry and pages support the retrieved recommendation and each interpreted relationship?"@en .

