    <rdfs:label xml:lang="en">Event Definition</rdfs:label>
    <rdfs:comment xml:lang="en">A versioned Dell catalogue entry, not an observed incident.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#MemoryComponentType">
