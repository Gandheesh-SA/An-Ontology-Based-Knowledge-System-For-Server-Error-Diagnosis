  </rdf:Description>
  <rdf:Description rdf:nodeID="N515e203470f44b4aadac8a2c9235984d">
    <rdf:first rdf:resource="https://example.org/dell-troubleshooting#PossibleExplanation"/>
    <rdf:rest rdf:nodeID="N61793bda675c453ea34046a26ecb5967"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#TechnicalArtifactType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Technical Artifact Type</rdfs:label>
    <rdfs:comment xml:lang="en">A reusable type of information artifact, not an actual log file or generated report.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#hasPossibleExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">has Possible Explanation</rdfs:label>
    <rdfs:comment xml:lang="en">Links a condition to a possibility supported by the source wording.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ReportedCondition"/>
    <rdfs:range rdf:resource="https://example.org/dell-troubleshooting#PossibleExplanation"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://example.org/dell-troubleshooting/dell-catalogue/1.0"/>
    <rdfs:label xml:lang="en">Dell server troubleshooting catalogue ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Schema for documented Critical and Warning entries, their explanations and recommended responses. External class IRIs are reused selectively.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-syntax/"/>
    <rdfs:seeAlso rdf:resource="https://cdn.aaai.org/Symposia/Spring/1997/SS-97-06/SS97-06-005.pdf"/>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.1007/978-3-031-60635-9_2"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/noria/ontology/"/>
    <rdfs:seeAlso rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
    <rdfs:seeAlso rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf"/>
    <dell:competencyQuestion xml:lang="en">Which definition reports a given condition, component type and technical property?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">What documented possibilities explain this condition, retaining uncertainty and alternatives?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">What complete response is recommended, including no-action policies, conditions and warnings?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">Which instructions belong to a procedure, and in what source order and nesting?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">Which instruction investigates or attempts to address which documented possibility, with what source support?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">What information artifacts are used versus requested as outputs?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">Which explicit threshold direction, level, value and unit does the source document?</dell:competencyQuestion>
    <dell:competencyQuestion xml:lang="en">Which source entry and pages support the retrieved recommendation and each interpreted relationship?</dell:competencyQuestion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nae8254a8be52406dae062f8e2608c65e">
    <rdf:first rdf:resource="https://example.org/dell-troubleshooting#ComponentType"/>
    <rdf:rest rdf:nodeID="Nc5394db151d249e49b878a300c2f8f87"/>
