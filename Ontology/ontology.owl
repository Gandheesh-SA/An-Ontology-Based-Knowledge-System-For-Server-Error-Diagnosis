>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#appearsBefore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">appears Before</rdfs:label>
    <rdfs:comment xml:lang="en">Earlier in the source order within one procedure. Population must check procedure boundaries and cycles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ProcedureInstruction"/>
    <rdfs:range rdf:resource="https://example.org/dell-troubleshooting#ProcedureInstruction"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#toolText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">tool Text</rdfs:label>
    <rdfs:comment xml:lang="en">Documented tool, interface or command wording.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ProcedureInstruction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#ProcedureInstruction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Procedure Instruction</rdfs:label>
    <rdfs:comment xml:lang="en">A procedure-owned instruction occurrence, preserving its source context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:subClassOf rdf:nodeID="N12bd073110cb473694b3ed4ec3f8199c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#FirmwareComponentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Firmware Component Type</rdfs:label>
    <rdfs:comment xml:lang="en">Firmware Component Type within the Dell troubleshooting catalogue.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="https://example.org/dell-troubleshooting#ComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#EventDefinition">
