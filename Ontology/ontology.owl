    <rdfs:label xml:lang="en">Memory Component Type</rdfs:label>
    <rdfs:comment xml:lang="en">Memory Component Type within the Dell troubleshooting catalogue.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="https://example.org/dell-troubleshooting#HardwareComponentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#concernsComponentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">concerns Component Type</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies the component kind affected by the condition.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ReportedCondition"/>
    <rdfs:range rdf:resource="https://example.org/dell-troubleshooting#ComponentType"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#instructionOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">instruction Order</rdfs:label>
    <rdfs:comment xml:lang="en">Unique source reading position within the procedure, not an execution dependency.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ProcedureInstruction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N561de448c08f47b2b5453cb1295fda2e">
    <rdf:first rdf:resource="https://example.org/dell-troubleshooting#RecoveryProcedure"/>
    <rdf:rest rdf:nodeID="N236560084e214ef4956f85c0a089f3d2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#comparisonOperator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">comparison Operator</rdfs:label>
    <rdfs:comment xml:lang="en">Optional source-supported LT, LE, GT, GE, EQ or NE comparison; preserves strict versus inclusive bounds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ThresholdCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#ErrorCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Error Condition</rdfs:label>
    <rdfs:comment xml:lang="en">Error Condition within the Dell troubleshooting catalogue.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="https://example.org/dell-troubleshooting#ReportedCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#evidencePage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">evidence Page</rdfs:label>
    <rdfs:comment xml:lang="en">Physical PDF page supporting this particular relationship.</rdfs:comment>
