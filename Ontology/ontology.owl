  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#instructionText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">instruction Text</rdfs:label>
