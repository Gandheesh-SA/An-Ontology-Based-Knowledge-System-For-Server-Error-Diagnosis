  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#attemptsToCorrectExplanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label xml:lang="en">attempts To Correct Explanation</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies a documented possibility this instruction seeks to remedy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#ProcedureInstruction"/>
    <rdfs:range rdf:resource="https://example.org/dell-troubleshooting#PossibleExplanation"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#RecoveryProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Recovery Procedure</rdfs:label>
    <rdfs:comment xml:lang="en">A complete documented troubleshooting response, not a proven repair or executable workflow.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/noria/ontology/OperationPlan"/>
    <rdfs:subClassOf rdf:nodeID="N2afff394beca4a009936161a6d55cf28"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#hasDocumentedResponse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has Documented Response</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entry to its complete response block, which can contain alternatives.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/dell-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/dell-troubleshooting#RecoveryProcedure"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#vendorMetadataText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">vendor Metadata Text</rdfs:label>
