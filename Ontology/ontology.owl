  <rdf:Description rdf:about="https://example.org/dell-troubleshooting#similarEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">similar Event</rdfs:label>
    <rdfs:comment xml:lang="en">Same typed catalogue content signature, preserving order, qualifiers and values. Compare distinct records only from complete signatures after whitespace normalization. Reflexivity also relates every individual to itself.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/dell-troubleshooting"/>
    <dell:relationshipCategory>Association</dell:relationshipCategory>
  </rdf:Description>
