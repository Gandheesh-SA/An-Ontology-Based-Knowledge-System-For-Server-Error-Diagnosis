<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:diag="https://example.org/server-troubleshooting#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#causeText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">causeText</rdfs:label>
    <rdfs:comment xml:lang="en">Verbatim/source-grounded possible-cause statement. Keep ambiguous blocks intact until reviewed; do not invent atomic causes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>Explicit statement from troubleshooting[].cause_text</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:nodeID="EventDefinition-recommendsProcedure-some">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/server-troubleshooting#recommendsProcedure"/>
    <owl:someValuesFrom rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#recordId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">recordId</rdfs:label>
    <rdfs:comment xml:lang="en">Globally scoped dataset record identifier; different vendor/code namespaces must remain distinct.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>record_id</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#nestingLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">nestingLevel</rdfs:label>
    <rdfs:comment xml:lang="en">Extracted zero-based indentation level. It is not a validated workflow nesting or dependency tree.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].steps[].level</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#procedureLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">procedureLabel</rdfs:label>
    <rdfs:comment xml:lang="en">Original source solution-group label where present, for example Solution 1.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].label</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#FirmwareCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">FirmwareCategory</rdfs:label>
    <rdfs:comment xml:lang="en">An EventCategory concerned with firmware. It may overlap HardwareCategory and does not exhaust the parent class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Subclass</diag:modelRole>
    <diag:datasetMapping>Reviewed classification of category individuals</diag:datasetMapping>
    <rdfs:subClassOf rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationEntity">
    <rdfs:label xml:lang="en">Information Entity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
    <rdfs:comment>A piece of information, be it concretely realized or not. It is a catchall class, intended to bypass the ambiguities of many data or text that could denote either a an expression or a concrete realization of that expression.
In a semiotic model, there is no special reason to distinguish between them, however we may want to distinguish between a pure information content (e.g. the 3rd Gymnopedie by Satie), and its possible concrete realizations as a music sheet, a piano execution, the reproduction of the execution, its publishing as a record, etc.).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#MessageTemplate">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:subClassOf rdf:nodeID="MessageTemplate-one-owner"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MessageTemplate</rdfs:label>
    <rdfs:comment xml:lang="en">A source-specific message-pattern occurrence owned by one event definition; preserve placeholders and documented variants.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>Each messages[] entry; retain message_arguments as literal metadata</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#messageText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">messageText</rdfs:label>
    <rdfs:comment xml:lang="en">Original message text preserving placeholders; not an actual incident observation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>Each messages[] value</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasBroaderCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:label xml:lang="en">hasBroaderCategory</rdfs:label>
    <rdfs:comment xml:lang="en">Connects a category individual to a broader category individual. Transitivity supports hierarchical retrieval; this is not rdfs:subClassOf. Do not also declare this non-simple property asymmetric, irreflexive or functional in OWL 2 DL; validate hierarchy cycles separately.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#considersCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">considersCause</rdfs:label>
    <rdfs:comment xml:lang="en">Connects a source procedure/solution group to an explicitly documented possible cause in that group. It does not confirm causation or map every printed item to every cause.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#addressesCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">addressesCause</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies a possible cause that this particular corrective instruction is intended to address. It expresses intended corrective relevance, not a proven successful repair. Assert only from reviewed item-specific source evidence, not by linking every item to all causes considered by its procedure. An item may both investigate and address the same cause.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">hasItem</rdfs:label>
    <rdfs:comment xml:lang="en">Owns a printed item occurrence with exactly one procedure owner; identical wording in another procedure is a separate occurrence. Any cascade deletion is an application policy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Composition</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#HardwareCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">HardwareCategory</rdfs:label>
    <rdfs:comment xml:lang="en">An EventCategory concerned with hardware. It may overlap FirmwareCategory and does not exhaust the parent class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Subclass</diag:modelRole>
    <diag:datasetMapping>Reviewed classification of category individuals</diag:datasetMapping>
    <rdfs:subClassOf rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#ComponentType">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ComponentType</rdfs:label>
    <rdfs:comment xml:lang="en">A kind of hardware component, rather than a particular installed device; problem involvement and intervention targets are distinct.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>component_types[]; targetsComponentType requires review of action text</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#messageArguments">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">messageArguments</rdfs:label>
    <rdfs:comment xml:lang="en">Documented argument names and meanings, preserved as a JSON-encoded string. This is literal metadata, not a MessageParameter class or a formal parameter model. Do not assign event-level arguments to a variant unless their applicability is known.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>message_arguments</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#eventNamespace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">eventNamespace</rdfs:label>
    <rdfs:comment xml:lang="en">Code namespace used by the source; prevents conflating codes from different systems or event classes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>event_namespace</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#categoryName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">categoryName</rdfs:label>
    <rdfs:comment xml:lang="en">Readable category-individual name, inherited as an available property by the two category subclasses.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>categories[]</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#componentTypeName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ComponentType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">componentTypeName</rdfs:label>
    <rdfs:comment xml:lang="en">Readable component-kind name; source/classification evidence must accompany later population.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>component_types[]</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#itemText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">itemText</rdfs:label>
    <rdfs:comment xml:lang="en">Text of one printed item occurrence; retain the full procedure for its context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].steps[].text</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#ProcedureItem">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:subClassOf rdf:nodeID="ProcedureItem-one-owner"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ProcedureItem</rdfs:label>
    <rdfs:comment xml:lang="en">An owned printed item occurrence within a recovery procedure. Items preserve source order and may be instructions, options or component lists; they are not automatically executable steps.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Supporting</diag:modelRole>
    <diag:datasetMapping>troubleshooting[].steps[]: order, source_label, level, text</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#sourceDocumentId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">sourceDocumentId</rdfs:label>
    <rdfs:comment xml:lang="en">Reference to the top-level dataset sources index, which retains guide title, edition, location and fingerprint without a local SourceDocument class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>source.document_id</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:nodeID="MessageTemplate-one-owner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="inverse-hasMessageTemplate"/>
    <owl:onClass rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#investigatesCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">investigatesCause</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies a possible cause that this particular printed instruction is intended to investigate or gather diagnostic evidence about. Assert only after reviewing the item and its full source-group context. It does not mean the check was executed or confirmed the cause; procedure membership alone does not entail this link.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:comment>Any Object that exists only within some communication Event, in which at least one PhysicalObject participates in. 
In other words, all objects that have been or are created in the process of social communication: for the sake of communication (InformationObject), for incorporating new individuals (SocialAgent, Place), for contextualizing or intepreting existing entities (Description, Concept), or for collecting existing entities (Collection).
Being dependent on communication, all social objects need to be expressed by some information object (information objects are self-expressing).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
    <rdfs:label xml:lang="en">Social object</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#explanation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">explanation</rdfs:label>
    <rdfs:comment xml:lang="en">Source explanation of the reported condition. It is distinct from the event name and from a separately documented possible cause.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>explanation</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:nodeID="possible-cause-chain-0">
    <rdf:first rdf:resource="https://example.org/server-troubleshooting#recommendsProcedure"/>
    <rdf:rest rdf:nodeID="possible-cause-chain-1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity">
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:comment>Anything: real, possible, or imaginary, which some modeller wants to talk about for some purpose.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/noria/ontology/OperationPlan">
    <rdfs:label>OperationPlan</rdfs:label>
    <rdfs:comment xml:lang="en">An abstract class representing a formal set of operations to be carried out in a standardized/controlled way.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/noria/ontology/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#vendor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">vendor</rdfs:label>
    <rdfs:comment xml:lang="en">Vendor publishing the documented event definition.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>vendor</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#modelRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">modelRole</rdfs:label>
    <rdfs:comment xml:lang="en">Core, Supporting or Subclass role in this local design; not an OWL metaclass.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#PossibleCause">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">PossibleCause</rdfs:label>
    <rdfs:comment xml:lang="en">An explicitly documented possible explanation, retaining its source troubleshooting-group context; not a confirmed root cause.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>Explicit statements in troubleshooting[].cause_text; do not infer causes from generic prose</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
    <rdfs:comment>Any physical, social, or mental object, or a substance. Following DOLCE Full, objects are always participating in some event (at least their own life), and are spatially located.</rdfs:comment>
    <rdfs:label xml:lang="en">Object</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasPossibleCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">hasPossibleCause</rdfs:label>
    <rdfs:comment xml:lang="en">Derived through recommendsProcedure followed by considersCause. The property chain entails the shortcut; it is not an equivalence or a prohibition on other assertions. The population policy derives rather than independently maintains this link.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Derived</diag:populationStatus>
    <owl:propertyChainAxiom rdf:nodeID="possible-cause-chain-0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#concernsComponentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ComponentType"/>
    <rdfs:label xml:lang="en">concernsComponentType</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies a component kind implicated in the documented problem; it does not imply ownership.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#EventDefinition">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:subClassOf rdf:nodeID="EventDefinition-hasMessageTemplate-some"/>
    <rdfs:subClassOf rdf:nodeID="EventDefinition-recommendsProcedure-some"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">EventDefinition</rdfs:label>
    <rdfs:comment xml:lang="en">A source-specific documented event or problem definition, not an observed incident or a historical repair case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>record_id, vendor, event_code, event_namespace, event_name, severity, explanation, cause_category, source</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#RecoveryProcedure">
    <rdfs:subClassOf rdf:resource="https://w3id.org/noria/ontology/OperationPlan"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">RecoveryProcedure</rdfs:label>
    <rdfs:comment xml:lang="en">A complete documented troubleshooting recommendation, preserving alternatives, applicability, cautions, references and escalation; not a verified successful repair.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>Each troubleshooting[] group with action_text and its label</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#EventCategory">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">EventCategory</rdfs:label>
    <rdfs:comment xml:lang="en">A shared indexing topic represented by category individuals. A category hierarchy is not a hierarchy of classes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>categories[] as individuals; a broader-category hierarchy needs reviewed enrichment</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:nodeID="inverse-hasMessageTemplate">
    <owl:inverseOf rdf:resource="https://example.org/server-troubleshooting#hasMessageTemplate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A Description having an explicit Goal, to be achieved by executing the plan</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:label xml:lang="en">Plan</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#causeCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">causeCategory</rdfs:label>
    <rdfs:comment xml:lang="en">Original source cause-classification token where present, such as a Cisco cause enumeration. This token is not an independently confirmed PossibleCause.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>cause_category</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#targetsComponentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ComponentType"/>
    <rdfs:label xml:lang="en">targetsComponentType</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies a component explicitly investigated, updated or replaced in the action text. It may differ from the component implicated by the event.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#recommendsProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">recommendsProcedure</rdfs:label>
    <rdfs:comment xml:lang="en">References a complete documented recommendation. A procedure can be referenced without exclusive ownership; source-group context must be preserved.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#severity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">severity</rdfs:label>
    <rdfs:comment xml:lang="en">Documented/normalised severity where available; do not guess a missing severity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>severity</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#eventName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">eventName</rdfs:label>
    <rdfs:comment xml:lang="en">Original event name or heading from the guide.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>event_name</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description">
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:comment>A Description is a SocialObject that represents a conceptualization. 
It can be thought also as a 'descriptive context' that uses or defines concepts in order to create a view on a 'relational context' (cf. Situation) out of a set of data or observations. 
For example, a Plan is a Description of some actions to be executed by agents in a certain way, with certain parameters; a Diagnosis is a Description that provides an interpretation for a set of observed entities, etc.
Descriptions 'define' or 'use' concepts, and can be 'satisfied' by situations.</rdfs:comment>
    <rdfs:label xml:lang="en">Description</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ProcedureItem-one-owner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="inverse-hasItem"/>
    <owl:onClass rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://example.org/server-troubleshooting/1.2.0"/>
    <owl:versionInfo>1.2.0</owl:versionInfo>
    <rdfs:label xml:lang="en">Server troubleshooting ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Local schema for documented server hardware and firmware troubleshooting knowledge from Dell, Cisco and HPE guides. Nine local classes, twelve object properties and twenty-one dataset-aligned data properties. Item-level investigatesCause and addressesCause links require reviewed evidence and are not inferred from procedure membership. Eight local-to-external superclass alignments reuse NORIA-O as M1 and DUL as M2, with selected upstream axioms embedded offline rather than full imports. No incident instances, local core-class disjointness or extra EventDefinition subclasses are asserted. DUL named disjointness is retained for selected classes. PROV-O is excluded. HardwareCategory and FirmwareCategory may overlap and do not exhaust EventCategory. The example.org namespace is a project placeholder, not a claimed published vocabulary. OWL is open-world: constraints do not replace SHACL validation of actual records.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-syntax/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-mapping-to-rdf/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-primer/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/turtle/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:label xml:lang="en">hasCategory</rdfs:label>
    <rdfs:comment xml:lang="en">Assigns optional shared indexing categories across vendors; classification is not a confirmed causal statement.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#similarTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">similarTo</rdfs:label>
    <rdfs:comment xml:lang="en">Connects assessed similar problem definitions, including cross-vendor candidates. Symmetry does not imply transitivity, equivalence, the same cause, or interchangeable recommendations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#eventCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">eventCode</rdfs:label>
    <rdfs:comment xml:lang="en">Original event code as text, preserving leading zeros and hexadecimal notation; absent when the guide gives no code.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>event_code</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#procedureText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">procedureText</rdfs:label>
    <rdfs:comment xml:lang="en">Complete original recommendation, including introductory conditions, warnings, alternatives, nested text and support escalation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].action_text</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#sourcePage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <rdfs:label xml:lang="en">sourcePage</rdfs:label>
    <rdfs:comment xml:lang="en">Physical one-based PDF page number supporting the definition. Multiple page values are allowed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>Each source.pdf_pages[] value</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasMessageTemplate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdfs:label xml:lang="en">hasMessageTemplate</rdfs:label>
    <rdfs:comment xml:lang="en">Owns definition-specific message occurrences. Each message occurrence has exactly one definition owner; identical text can occur in another owned node. OWL does not execute cascade deletion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Composition</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:label xml:lang="en">Information object</rdfs:label>
    <rdfs:comment>A piece of information, such as a musical composition, a text, a word, a picture, independently from how it is concretely realized.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#datasetMapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">datasetMapping</rdfs:label>
    <rdfs:comment xml:lang="en">Literal documentation of the source JSON field or population rule; not an executable mapping.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="inverse-hasItem">
    <owl:inverseOf rdf:resource="https://example.org/server-troubleshooting#hasItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#sourceLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">sourceLabel</rdfs:label>
    <rdfs:comment xml:lang="en">Original printed item marker, such as 1. or a., where available.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].steps[].source_label</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#populationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">populationStatus</rdfs:label>
    <rdfs:comment xml:lang="en">Source-based, Derived or Reviewed enrichment; vocabulary availability does not imply populated assertions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#itemOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <rdfs:label xml:lang="en">itemOrder</rdfs:label>
    <rdfs:comment xml:lang="en">One-based printed item position within this procedure; not an execution dependency or a global order.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>troubleshooting[].steps[].order</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#relationshipCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">relationshipCategory</rdfs:label>
    <rdfs:comment xml:lang="en">UML relationship category annotation. Composition has no native OWL cascade-delete semantics.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:comment>A Concept is a SocialObject, and isDefinedIn some Description; once defined, a Concept can be used in other Description(s). If a Concept isDefinedIn exactly one Description, see the LocalConcept class.
The classifies relation relates Concept(s) to Entity(s) at some TimeInterval</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="EventDefinition-hasMessageTemplate-some">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/server-troubleshooting#hasMessageTemplate"/>
    <owl:someValuesFrom rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="possible-cause-chain-1">
    <rdf:first rdf:resource="https://example.org/server-troubleshooting#considersCause"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
</rdf:RDF>
