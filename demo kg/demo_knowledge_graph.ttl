    rdfs:comment "Automatic source-text assessment: explicit diagnostic/corrective verb and component mention in the instruction. This is a procedure target, not necessarily the component responsible for the event. Evidence: Check whether expander and backplane firmware are compatible and upgrade the firmware if required."@en ;
    rdfs:seeAlso <https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48>,
        <https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/001> ;
