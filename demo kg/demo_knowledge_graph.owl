<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:diag="https://example.org/server-troubleshooting#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">Dell ENC48: ENC48</rdfs:label>
    <diag:recordId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026-EEM-ENC48</diag:recordId>
    <diag:vendor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dell</diag:vendor>
    <diag:eventCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENC48</diag:eventCode>
    <diag:eventNamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEM</diag:eventNamespace>
    <diag:eventName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENC48</diag:eventName>
    <diag:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WARNING</diag:severity>
    <diag:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A storage topology issue is detected on the controller identified in the message. Some of the possible reasons are: 1) Incorrect cable connections such as loose, damaged, or improperly routed SAS cables. 2) Firmware incompatibility such as different SAS devices (like RAID controllers and expanders) might require the same firmware version to work correctly within a topology. 3) Exceeding enclosure limits such as a SAS controller may only support a certain number of enclosures, and connecting more than supported can cause an error. 4) Unsupported devices in the configuration.</diag:explanation>
    <diag:sourceDocumentId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DELL-EEM-2026</diag:sourceDocumentId>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1073</diag:sourcePage>
    <diag:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1074</diag:sourcePage>
    <rdfs:seeAlso rdf:resource="https://dl.dell.com/content/manual64973867-poweredge-servers-error-and-event-messages-reference-guide.pdf?language=en-us"/>
    <diag:hasMessageTemplate rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/message/01"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Storage"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Firmware%20and%20BIOS"/>
    <diag:hasCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Chassis%20and%20Enclosure"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Storage%20controller"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
    <diag:concernsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Cable%20or%20connector"/>
    <diag:recommendsProcedure rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01"/>
    <diag:hasPossibleCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:comment>A Concept is a SocialObject, and isDefinedIn some Description; once defined, a Concept can be used in other Description(s). If a Concept isDefinedIn exactly one Description, see the LocalConcept class.
The classifies relation relates Concept(s) to Entity(s) at some TimeInterval</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">Dell ENC48 printed item 3</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">See the respective PERC Users Guide or the Installation and Service Manual (ISM) of the respective server platform on the supported number of device configurations.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3)</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [180, 345); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: CONTEXT_OR_REFERENCE. No recognised diagnostic/corrective instruction in this printed item.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#addressesCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
    <rdfs:comment xml:lang="en">Identifies a possible cause that this particular corrective instruction is intended to address. It expresses intended corrective relevance, not a proven successful repair. Assert only from reviewed item-specific source evidence, not by linking every item to all causes considered by its procedure. An item may both investigate and address the same cause.</rdfs:comment>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">addressesCause</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#HardwareCategory">
    <diag:datasetMapping>Reviewed classification of category individuals</diag:datasetMapping>
    <rdfs:label xml:lang="en">HardwareCategory</rdfs:label>
    <diag:modelRole>Subclass</diag:modelRole>
    <rdfs:subClassOf rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:comment xml:lang="en">An EventCategory concerned with hardware. It may overlap FirmwareCategory and does not exhaust the parent class.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#RecoveryProcedure">
    <rdfs:label xml:lang="en">RecoveryProcedure</rdfs:label>
    <diag:modelRole>Core</diag:modelRole>
    <rdfs:comment xml:lang="en">A complete documented troubleshooting recommendation, preserving alternatives, applicability, cautions, references and escalation; not a verified successful repair.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Plan"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/noria/ontology/OperationPlan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <diag:datasetMapping>Each troubleshooting[] group with action_text and its label</diag:datasetMapping>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/category/Server%20Hardware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#HardwareCategory"/>
    <rdfs:label xml:lang="en">Server Hardware</rdfs:label>
    <diag:categoryName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Server Hardware</diag:categoryName>
    <rdfs:comment xml:lang="en">Project indexing hierarchy over the dataset categories, using the existing hardware/firmware classification policy. These broad category individuals are curated indexing concepts, not additional documented events or vendor quotations.</rdfs:comment>
    <diag:hasBroaderCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Server%20Troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#PossibleCause">
    <diag:modelRole>Core</diag:modelRole>
    <rdfs:label xml:lang="en">PossibleCause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <diag:datasetMapping>Explicit statements in troubleshooting[].cause_text; do not infer causes from generic prose</diag:datasetMapping>
    <rdfs:comment xml:lang="en">An explicitly documented possible explanation, retaining its source troubleshooting-group context; not a confirmed root cause.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#populationStatus">
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">populationStatus</rdfs:label>
    <rdfs:comment xml:lang="en">Source-based, Derived or Reviewed enrichment; vocabulary availability does not imply populated assertions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8b85ec6137754d4481f14b39496feef0b8">
    <owl:onProperty rdf:resource="https://example.org/server-troubleshooting#recommendsProcedure"/>
    <owl:someValuesFrom rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/category/Server%20Firmware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#FirmwareCategory"/>
    <rdfs:label xml:lang="en">Server Firmware</rdfs:label>
    <diag:categoryName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Server Firmware</diag:categoryName>
    <rdfs:comment xml:lang="en">Project indexing hierarchy over the dataset categories, using the existing hardware/firmware classification policy. These broad category individuals are curated indexing concepts, not additional documented events or vendor quotations.</rdfs:comment>
    <diag:hasBroaderCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Server%20Troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:label xml:lang="en">Dell ENC48 recommendation 1</rdfs:label>
    <diag:procedureText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Do the following: 1) Check whether expander and backplane firmware are compatible and upgrade
the firmware if required. 2) Remove the un-supported device from the configuration. 3) See the
respective PERC Users Guide or the Installation and Service Manual (ISM) of the respective server
platform on the supported number of device configurations.</diag:procedureText>
    <diag:considersCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/001"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/002"/>
    <diag:hasItem rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/003"/>
    <diag:targetsComponentType rdf:resource="https://example.org/server-troubleshooting/data/component-type/Enclosure%20or%20backplane"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/category/Server%20Troubleshooting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:label xml:lang="en">Server Troubleshooting</rdfs:label>
    <diag:categoryName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Server Troubleshooting</diag:categoryName>
    <rdfs:comment xml:lang="en">Project indexing hierarchy over the dataset categories, using the existing hardware/firmware classification policy. These broad category individuals are curated indexing concepts, not additional documented events or vendor quotations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#procedureLabel">
    <diag:datasetMapping>troubleshooting[].label</diag:datasetMapping>
    <rdfs:label xml:lang="en">procedureLabel</rdfs:label>
    <rdfs:comment xml:lang="en">Original source solution-group label where present, for example Solution 1.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#ProcedureItem">
    <rdfs:subClassOf rdf:nodeID="n8b85ec6137754d4481f14b39496feef0b5"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <diag:datasetMapping>troubleshooting[].steps[]: order, source_label, level, text</diag:datasetMapping>
    <rdfs:comment xml:lang="en">An owned printed item occurrence within a recovery procedure. Items preserve source order and may be instructions, options or component lists; they are not automatically executable steps.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:label xml:lang="en">ProcedureItem</rdfs:label>
    <diag:modelRole>Supporting</diag:modelRole>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasCategory</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:comment xml:lang="en">Assigns optional shared indexing categories across vendors; classification is not a confirmed causal statement.</rdfs:comment>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#concernsComponentType">
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ComponentType"/>
    <rdfs:comment xml:lang="en">Identifies a component kind implicated in the documented problem; it does not imply ownership.</rdfs:comment>
    <rdfs:label xml:lang="en">concernsComponentType</rdfs:label>
    <diag:populationStatus>Source-based</diag:populationStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#messageArguments">
    <rdfs:comment xml:lang="en">Documented argument names and meanings, preserved as a JSON-encoded string. This is literal metadata, not a MessageParameter class or a formal parameter model. Do not assign event-level arguments to a variant unless their applicability is known.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:label xml:lang="en">messageArguments</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <diag:datasetMapping>message_arguments</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/category/Storage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#HardwareCategory"/>
    <rdfs:label xml:lang="en">Storage</rdfs:label>
    <diag:categoryName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Storage</diag:categoryName>
    <diag:hasBroaderCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Server%20Hardware"/>
    <diag:hasBroaderCategory rdf:resource="https://example.org/server-troubleshooting/data/category/Server%20Troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A piece of information, be it concretely realized or not. It is a catchall class, intended to bypass the ambiguities of many data or text that could denote either a an expression or a concrete realization of that expression.
In a semiotic model, there is no special reason to distinguish between them, however we may want to distinguish between a pure information content (e.g. the 3rd Gymnopedie by Satie), and its possible concrete realizations as a music sheet, a piano execution, the reproduction of the execution, its publishing as a record, etc.).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
    <rdfs:label xml:lang="en">Information Entity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#severity">
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">severity</rdfs:label>
    <diag:datasetMapping>severity</diag:datasetMapping>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Documented/normalised severity where available; do not guess a missing severity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#MessageTemplate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A source-specific message-pattern occurrence owned by one event definition; preserve placeholders and documented variants.</rdfs:comment>
    <diag:modelRole>Core</diag:modelRole>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>Each messages[] entry; retain message_arguments as literal metadata</diag:datasetMapping>
    <rdfs:subClassOf rdf:nodeID="n8b85ec6137754d4481f14b39496feef0b3"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <rdfs:label xml:lang="en">MessageTemplate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasMessageTemplate">
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">hasMessageTemplate</rdfs:label>
    <diag:populationStatus>Source-based</diag:populationStatus>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <diag:relationshipCategory>Composition</diag:relationshipCategory>
    <rdfs:comment xml:lang="en">Owns definition-specific message occurrences. Each message occurrence has exactly one definition owner; identical text can occur in another owned node. OWL does not execute cascade deletion.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#sourcePage">
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">sourcePage</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>Each source.pdf_pages[] value</diag:datasetMapping>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <rdfs:comment xml:lang="en">Physical one-based PDF page number supporting the definition. Multiple page values are allowed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#explanation">
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:comment xml:lang="en">Source explanation of the reported condition. It is distinct from the event name and from a separately documented possible cause.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">explanation</rdfs:label>
    <diag:datasetMapping>explanation</diag:datasetMapping>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasPossibleCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <diag:populationStatus>Derived</diag:populationStatus>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:label xml:lang="en">hasPossibleCause</rdfs:label>
    <owl:propertyChainAxiom rdf:nodeID="n8b85ec6137754d4481f14b39496feef0b1"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:comment xml:lang="en">Derived through recommendsProcedure followed by considersCause. The property chain entails the shortcut; it is not an equivalence or a prohibition on other assertions. The population policy derives rather than independently maintains this link.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#EventCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A shared indexing topic represented by category individuals. A category hierarchy is not a hierarchy of classes.</rdfs:comment>
    <diag:modelRole>Core</diag:modelRole>
    <diag:datasetMapping>categories[] as individuals; a broader-category hierarchy needs reviewed enrichment</diag:datasetMapping>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
    <rdfs:label xml:lang="en">EventCategory</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#itemText">
    <diag:datasetMapping>troubleshooting[].steps[].text</diag:datasetMapping>
    <rdfs:label xml:lang="en">itemText</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Text of one printed item occurrence; retain the full procedure for its context.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#ComponentType">
    <rdfs:comment xml:lang="en">A kind of hardware component, rather than a particular installed device; problem involvement and intervention targets are distinct.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:label xml:lang="en">ComponentType</rdfs:label>
    <diag:datasetMapping>component_types[]; targetsComponentType requires review of action text</diag:datasetMapping>
    <diag:modelRole>Core</diag:modelRole>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#sourceLabel">
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:comment xml:lang="en">Original printed item marker, such as 1. or a., where available.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">sourceLabel</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <diag:datasetMapping>troubleshooting[].steps[].source_label</diag:datasetMapping>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#recordId">
    <rdfs:comment xml:lang="en">Globally scoped dataset record identifier; different vendor/code namespaces must remain distinct.</rdfs:comment>
    <rdfs:label xml:lang="en">recordId</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <diag:datasetMapping>record_id</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#recommendsProcedure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">recommendsProcedure</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#RecoveryProcedure"/>
    <rdfs:comment xml:lang="en">References a complete documented recommendation. A procedure can be referenced without exclusive ownership; source-group context must be preserved.</rdfs:comment>
    <diag:populationStatus>Source-based</diag:populationStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
    <rdfs:label xml:lang="en">Dell ENC48 printed item 1</rdfs:label>
    <diag:itemText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Check whether expander and backplane firmware are compatible and upgrade the firmware if required.</diag:itemText>
    <diag:itemOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</diag:itemOrder>
    <diag:sourceLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)</diag:sourceLabel>
    <diag:nestingLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</diag:nestingLevel>
    <rdfs:comment xml:lang="en">Source action_text character span [20, 120); FULL_TEXT_SOURCE_MARKERS; order is printed/text order, not an execution dependency.</rdfs:comment>
    <rdfs:comment xml:lang="en">Purpose assessment: SOURCE_ANCHORED_RULE_LINK. Explicit action verb and shared documented component/condition in the same source group; inferred intended purpose only.</rdfs:comment>
    <diag:investigatesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
    <diag:addressesCause rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N61a6449c1dda47a2a5c30efa0dfcbfe8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/001"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#investigatesCause"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">population-assessment-1.0; automatic source-anchored rule assessment, not expert validation. Shared concepts: Enclosure or backplane, catalog, firmware. The target retains the complete documented possible-cause block; alternatives are not asserted as confirmed causes.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8b85ec6137754d4481f14b39496feef0b7">
    <owl:someValuesFrom rdf:resource="https://example.org/server-troubleshooting#MessageTemplate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/server-troubleshooting#hasMessageTemplate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#FirmwareCategory">
    <diag:modelRole>Subclass</diag:modelRole>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <diag:datasetMapping>Reviewed classification of category individuals</diag:datasetMapping>
    <rdfs:comment xml:lang="en">An EventCategory concerned with firmware. It may overlap HardwareCategory and does not exhaust the parent class.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:label xml:lang="en">FirmwareCategory</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#hasBroaderCategory">
    <rdfs:comment xml:lang="en">Connects a category individual to a broader category individual. Transitivity supports hierarchical retrieval; this is not rdfs:subClassOf. Do not also declare this non-simple property asymmetric, irreflexive or functional in OWL 2 DL; validate hierarchy cycles separately.</rdfs:comment>
    <rdfs:label xml:lang="en">hasBroaderCategory</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#categoryName">
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventCategory"/>
    <rdfs:comment xml:lang="en">Readable category-individual name, inherited as an available property by the two category subclasses.</rdfs:comment>
    <rdfs:label xml:lang="en">categoryName</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <diag:datasetMapping>categories[]</diag:datasetMapping>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject">
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationEntity"/>
    <rdfs:label xml:lang="en">Information object</rdfs:label>
    <rdfs:comment>A piece of information, such as a musical composition, a text, a word, a picture, independently from how it is concretely realized.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity">
    <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <rdfs:comment>Anything: real, possible, or imaginary, which some modeller wants to talk about for some purpose.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1d5fb97a5eb54e6cb355e90a07b61f3e">
