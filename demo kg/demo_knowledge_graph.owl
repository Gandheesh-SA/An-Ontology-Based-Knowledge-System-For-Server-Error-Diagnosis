    <rdfs:comment xml:lang="en">Readable component-kind name; source/classification evidence must accompany later population.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ComponentType"/>
  </rdf:Description>
