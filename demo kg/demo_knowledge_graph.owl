    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <diag:relationshipCategory>Composition</diag:relationshipCategory>
    <diag:populationStatus>Source-based</diag:populationStatus>
    <rdfs:label xml:lang="en">hasItem</rdfs:label>
    <rdfs:comment xml:lang="en">Owns a printed item occurrence with exactly one procedure owner; identical wording in another procedure is a separate occurrence. Any cascade deletion is an application policy.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
