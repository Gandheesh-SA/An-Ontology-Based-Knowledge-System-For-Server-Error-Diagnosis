  </rdf:Description>
  <rdf:Description rdf:nodeID="N3e955a6bf1a2401f9691e9de9900195d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01"/>
