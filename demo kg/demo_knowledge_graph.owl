  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#investigatesCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:comment xml:lang="en">Identifies a possible cause that this particular printed instruction is intended to investigate or gather diagnostic evidence about. Assert only after reviewing the item and its full source-group context. It does not mean the check was executed or confirmed the cause; procedure membership alone does not entail this link.</rdfs:comment>
    <diag:relationshipCategory>Association</diag:relationshipCategory>
    <rdfs:range rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
    <rdfs:label xml:lang="en">investigatesCause</rdfs:label>
    <diag:populationStatus>Reviewed enrichment</diag:populationStatus>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#ProcedureItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#eventCode">
    <rdfs:comment xml:lang="en">Original event code as text, preserving leading zeros and hexadecimal notation; absent when the guide gives no code.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#EventDefinition"/>
    <rdfs:label xml:lang="en">eventCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <diag:datasetMapping>event_code</diag:datasetMapping>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc3df3ac3b9bf439aa6468588bc83dc88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/item/001"/>
    <owl:annotatedProperty rdf:resource="https://example.org/server-troubleshooting#addressesCause"/>
    <owl:annotatedTarget rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01/cause"/>
    <rdfs:comment xml:lang="en">population-assessment-1.0; automatic source-anchored rule assessment, not expert validation. Shared concepts: Enclosure or backplane, catalog, firmware. The target retains the complete documented possible-cause block; alternatives are not asserted as confirmed causes.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48"/>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting/data/event/DELL-EEM-2026-EEM-ENC48/procedure/01"/>
  </rdf:Description>
