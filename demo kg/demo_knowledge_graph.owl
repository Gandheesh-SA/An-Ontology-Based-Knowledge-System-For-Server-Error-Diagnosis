  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting/knowledge-graph/demo/ENC48">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Single-event demo: Dell ENC48 storage topology error</rdfs:label>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <rdfs:seeAlso rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:comment xml:lang="en">One source-backed EventDefinition and its connected message, documented possible-cause block, recovery procedure, three procedure items, components and hardware/firmware categories. Selected ontology schema axioms are embedded for standalone use. Item-to-cause and target links use the same source-anchored assessment rules as the TRAIN KG; they do not confirm causes or successful repairs. The optional cause_category and procedure label are not supplied by this source and are omitted rather than invented. No similarTo links are asserted because this demo contains only one event.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#causeText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Verbatim/source-grounded possible-cause statement. Keep ambiguous blocks intact until reviewed; do not invent atomic causes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://example.org/server-troubleshooting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <diag:datasetMapping>Explicit statement from troubleshooting[].cause_text</diag:datasetMapping>
    <rdfs:label xml:lang="en">causeText</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/server-troubleshooting#PossibleCause"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/server-troubleshooting#componentTypeName">
